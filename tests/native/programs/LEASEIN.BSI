// A lease's subject assigned after an inner select on it has ended: the
// reference's one counting flag is cleared by the inner arm, so it is allowed.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[4]
var g: u8
sub main()
    var a: nodes? = new? nodes(1, none)
    select a
    case some(x)
        select a
        case some(y)
        end
        a = none
    end
end
