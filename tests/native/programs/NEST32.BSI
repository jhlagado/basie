// Control statements nested 32 deep (16 before 68): if, while, for and
// select in turn.
var n: u16
var m: u8
var go: boolean
sub main() fails IoError
    var i2: u8
    var i6: u8
    var i10: u8
    var i14: u8
    var i18: u8
    var i22: u8
    var i26: u8
    var i30: u8
    go = true
    if n < 200
        while go
            for i2 = 1 to 2
                select m
                case 0
                        if n < 204
                            while go
                                for i6 = 1 to 2
                                    select m
                                    case 0
                                            if n < 208
                                                while go
                                                    for i10 = 1 to 2
                                                        select m
                                                        case 0
                                                                if n < 212
                                                                    while go
                                                                        for i14 = 1 to 2
                                                                            select m
                                                                            case 0
                                                                                    if n < 216
                                                                                        while go
                                                                                            for i18 = 1 to 2
                                                                                                select m
                                                                                                case 0
                                                                                                        if n < 220
                                                                                                            while go
                                                                                                                for i22 = 1 to 2
                                                                                                                    select m
                                                                                                                    case 0
                                                                                                                            if n < 224
                                                                                                                                while go
                                                                                                                                    for i26 = 1 to 2
                                                                                                                                        select m
                                                                                                                                        case 0
                                                                                                                                                if n < 228
                                                                                                                                                    while go
                                                                                                                                                        for i30 = 1 to 2
                                                                                                                                                            select m
                                                                                                                                                            case 0
                                                                                                                                                                    n = n + 1
                                                                                                                                                                    m = m + 1
                                                                                                                                                                    go = false
                                                                                                                                                            case else
                                                                                                                                                                n = n + 0
                                                                                                                                                            end
                                                                                                                                                        end
                                                                                                                                                    end
                                                                                                                                                else
                                                                                                                                                    m = 9
                                                                                                                                                end
                                                                                                                                        case else
                                                                                                                                            n = n + 0
                                                                                                                                        end
                                                                                                                                    end
                                                                                                                                end
                                                                                                                            else
                                                                                                                                m = 9
                                                                                                                            end
                                                                                                                    case else
                                                                                                                        n = n + 0
                                                                                                                    end
                                                                                                                end
                                                                                                            end
                                                                                                        else
                                                                                                            m = 9
                                                                                                        end
                                                                                                case else
                                                                                                    n = n + 0
                                                                                                end
                                                                                            end
                                                                                        end
                                                                                    else
                                                                                        m = 9
                                                                                    end
                                                                            case else
                                                                                n = n + 0
                                                                            end
                                                                        end
                                                                    end
                                                                else
                                                                    m = 9
                                                                end
                                                        case else
                                                            n = n + 0
                                                        end
                                                    end
                                                end
                                            else
                                                m = 9
                                            end
                                    case else
                                        n = n + 0
                                    end
                                end
                            end
                        else
                            m = 9
                        end
                case else
                    n = n + 0
                end
            end
        end
    else
        m = 9
    end
    if n > 0
        try writeText(console, "nested 32\r\n")
    end
end
