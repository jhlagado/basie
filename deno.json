{
  "tasks": {
    "check": "deno fmt --check tests tools ref && deno lint tests tools ref",
    "basie": "deno run --config deno.runtime.json --allow-read --allow-write --allow-env tools/basie.ts",
    "brl": "deno run --config deno.runtime.json --allow-read=.,../atom,../z80-tool-services --allow-write=build --allow-env tools/brl.ts runtime/cpm22/cpm22.asm build/CPM22.BRL",
    "helpers": "deno run --config deno.runtime.json --allow-read=.,../atom,../z80-tool-services --allow-write=build,ref/compile/helper-table.ts,docs/helper-table.md --allow-env tools/helpertable.ts",
    "msg": "deno run --allow-read=. --allow-write=build,docs tools/msgfile.ts build/BASIE.MSG",
    "test": "deno test --config deno.runtime.json --allow-read=.,../atom,../triptych,../z80-tool-services --allow-write=build --allow-env tests/",
    "fmt": "deno fmt tests tools ref",
    "lint": "deno lint tests tools ref",
    "conformance": "deno run --config deno.runtime.json --allow-read=.,../atom,../z80-tool-services --allow-write=build --allow-env tests/conformance/runner.ts",
    "build:compiler": "deno run --config deno.runtime.json --allow-read --allow-env native/compiler/build.ts",
    "census:basie": "deno run --config deno.runtime.json --allow-read=/ tools/census.ts native/compiler/BASIE.ASM --target 26624 --budget 28672",
    "census": "deno run --config deno.runtime.json --allow-read=/ tools/census.ts",
    "census:blink": "deno run --config deno.runtime.json --allow-read=/ tools/census.ts native/linker/BLINK.ASM --target 12288 --budget 14336"
  },
  "fmt": {
    "exclude": [
      "**/*.md",
      "ref/compile/helper-table.ts"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs/walk": "jsr:@std/fs@1/walk"
  }
}
