// An owner used in a statement can't also be moved in it.
// spec: 10.8
// expect error: statement-rule at 20:19

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

sub eat(n: nodes): u8
    return n.value
end

sub main()
    var x = new nodes(1, none)
    x.value = eat(move x)
end
