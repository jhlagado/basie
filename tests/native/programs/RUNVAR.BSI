// var parameters run (67e): each result is checked, and the narrowing at
// the end traps only when every one is right.
include "STRINGS.BSI"

record Acc
    total: u16
    count: u8
end

var check: u16
var out: u8

sub add(var a: Acc, v: u16)
    a.total = a.total + v
    a.count = a.count + 1
end

sub addAll(var a: Acc, vs: u16[])
    var i: u16
    for i = 0 until vs.length
        add(a, vs[i])
    end
end

sub main() fails
    var acc: Acc
    var vs: u16[4] = [10, 20, 30, 40]
    var s: string[16]
    var t: string[16]
    addAll(acc, vs)
    check = acc.total - 100 + u16(acc.count) - 4
    try append(s, "Basie")
    try appendByte(s, '!')
    check = check + u16(s.length) - 6
    try copyFrom(t, s, 1, 3)
    toUpper(t)
    if not equal(t, "ASI")
        check = check + 1
    end
    check = check + find(s, "si") - 2
    clear(s)
    check = check + u16(s.length)
    assert check = 0
    out = u8(256 - check)
end
