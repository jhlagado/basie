// Identifier parameters: optional and not, selected, read and written
// through, passed on, and stale after a free.
forward pool nodes
record Node
    value as u8
    next as nodes?
end
pool nodes as Node[4]
var keep as id nodes?

sub show(i as id nodes?) fails
    select i
    case some(n)
        writeByte(console, n.value) else fail
    case none
        writeByte(console, '-') else fail
    end
end

sub bump(i as id nodes)
    i.value = i.value + 1
end

sub twice(i as id nodes?) fails
    show(i) else fail
    show(i) else fail
end

sub main() fails
    var a = new nodes('A', none)
    var x = id(a)
    bump(x)
    show(id(a)) else fail
    twice(x) else fail
    show(none) else fail
    keep = id(a)
    a = new nodes('Q', none)
    show(keep) else fail
    writeText(console, "\r\n") else fail
end
