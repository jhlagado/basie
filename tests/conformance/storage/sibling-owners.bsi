// Owners in sibling blocks share a frame slot; each is freed exactly once (2.7).
// spec: 7.6, 7.12
// expect output: ok\r\n

forward pool nodes

record Node
    value: u8
end

pool nodes: Node[2]

sub f(flag: boolean)
    if flag
        var a = new nodes(1)
    else
        var b = new nodes(2)
    end
end

sub main() fails IoError
    var i: u8
    for i = 1 to 20
        f(true)
        f(false)
    end
    var c = new nodes(3)
    var d = new nodes(4)
    try writeText(console, "ok\r\n")
end
