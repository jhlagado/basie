// A typed constant has exactly its type; an untyped one adopts its context's.
// spec: 8.4
// expect output: 70000 200\r\n

include "FORMAT.BSI"

const big: u32 = 70000
const small = 200

sub main() fails IoError
    var line: string[20]
    var b: u8 = small
    try appendU32(var line, big)
    try appendByte(var line, ' ')
    try appendU16(var line, b)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
