// Labels take the subject's type, signed or unsigned.
// spec: 11.7.2
// expect output: neg\r\n

sub main() fails
    var d: i8 = -3
    select d
    case -5 to -1
        try writeText(console, "neg\r\n")
    case 0
        try writeText(console, "zero\r\n")
    case else
        try writeText(console, "pos\r\n")
    end
end
