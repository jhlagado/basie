// Counted loops that end at the edge of the counter's type: the next value
// is tested before it is stored, so nothing wraps and nothing traps, and
// the counter keeps the last value stored (12.5; review finding C1).
// spec: 12.5
// expect output: 7..0 255 254 127 5..0 3 0 65535\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[60]
    var c: u8
    var s: i8
    var w: u16
    var count: u16 = 0
    for c = 7 to 0 step -1
        if c = 7
            try appendU16(line, c)
        end
    end
    try append(line, "..")
    try appendU16(line, c)
    for c = 0 to 255
    end
    try appendByte(line, ' ')
    try appendU16(line, c)
    for c = 0 to 254 step 2
    end
    try appendByte(line, ' ')
    try appendU16(line, c)
    for s = 0 to 127
    end
    try appendByte(line, ' ')
    try appendI16(line, i16(s))
    for w = 5 to 0 step -1
        if w = 5
            try appendByte(line, ' ')
            try appendU16(line, w)
        end
    end
    try append(line, "..")
    try appendU16(line, w)
    for w = 0 to 3
    end
    try appendByte(line, ' ')
    try appendU16(line, w)
    for w = 65535 to 0 step -65535
        count = count + 1
    end
    try appendByte(line, ' ')
    try appendU16(line, w)
    for w = 0 to 65535
    end
    try appendByte(line, ' ')
    try appendU16(line, w)
    try append(line, "\r\n")
    try writeText(console, line)
end
