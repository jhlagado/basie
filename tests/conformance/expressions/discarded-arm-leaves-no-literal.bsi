// A string literal passed in a discarded arm of a short circuit is
// discarded with the arm: nothing is placed after the routine for it.
// spec: 9.11, 13.4
// expect output: N\r\n

var x: boolean

sub long(s: string[]): boolean
    return s.length > 2
end

sub main() fails IoError
    x = false and long("abc")
    if x
        try writeOutputByte('Y')
    else
        try writeOutputByte('N')
    end
    try writeOutputByte(13)
    try writeOutputByte(10)
end
