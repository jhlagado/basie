// Locals of each scalar type, with and without initializers, read and
// written beside program variables (65.4 d).
var g: u16 = 500
var h: u8

sub fill()
    var a: u8
    var b: u16 = 1000
    var c: boolean = true
    var d: u8 = 'A'
    var e: u16 = d
    var f: boolean
    a = d + 1
    b = b + a * 2
    f = c and b > g
    h = a xor d
    g = b - e
    e = 0
end

sub main()
    var count: u16 = g / 3
    var last: u8 = h
    var seen: boolean = count > 100 or last = 0
    count = count + last
    seen = not seen
    g = count
end
