// Moving none stores none and writes no link (R3).
// spec: 7.11
// expect output: -\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]
var a: nodes?
var b: nodes?

sub main() fails IoError
    a = move b
    select a
    case some(i)
        try writeByte(console, i.value)
    case none
        try writeByte(console, '-')
    end
    try writeText(console, "\r\n")
end
