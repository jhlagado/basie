// Aggregate parameters beyond IX+127: a record and an open string whose
// address words, and the string's capacity word, are reached through
// their computed addresses, read through paths and passed on (65.4 h).
record pair
    a: u8
    c: u8[3]
end

var r: pair
var text: string[9] = "far"
var i: u8 = 1
var x: u8
var y: u16

sub near(s: string[], q: pair): u8
    return s[0] + q.c[i]
end

sub far(q: pair, s: string[], v0: string[], v1: string[], v2: string[], v3: string[], v4: string[], v5: string[], v6: string[], v7: string[], v8: string[], v9: string[], v10: string[], v11: string[], v12: string[], v13: string[], v14: string[], v15: string[], v16: string[], v17: string[], v18: string[], v19: string[], v20: string[], v21: string[], v22: string[], v23: string[], v24: string[], v25: string[], v26: string[], v27: string[], v28: string[], v29: string[], v30: string[], v31: string[])
    x = s.length + s[i] + q.a + q.c[i] + v31[0]
    y = s.capacity
    x = near(s, q)
end

sub main()
    far(r, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text)
    far(r, "lit", text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text, text)
end
