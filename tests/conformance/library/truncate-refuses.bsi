// truncate fails with fileExists, changing nothing, when NAME.~ exists;
// readSecret gives endOfInput on a Control-Z at the start.
// spec: 16.4; standard library 5
// input: \x1a
// file KEEP.TXT: keep me
// file KEEP.~: mine
// expect output: E E\r\n
// expect file KEEP.TXT: keep me
// expect file KEEP.~: mine

include "TEXTIO.BSI"

sub main() fails
    var line: string[10]
    var code: u8 = 0
    truncate("KEEP.TXT", 2, textMode) handle code
        if code = fileExists
            try append(var line, "E ")
        end
    end
    var secret: string[10]
    readSecret(var secret) handle code
        if code = endOfInput
            try append(var line, "E")
        end
    end
    try writeLine(console, line)
end
