// move hands the handle on and leaves none behind.
// spec: 7.11, 9.13
// expect output: -A\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

var head: nodes?
var spare: nodes?

sub main() fails IoError
    head = new nodes('A', none)
    spare = move head
    select head
    case some(i)
        try writeByte(console, 'H')
    case none
        try writeByte(console, '-')
    end
    select spare
    case some(i)
        try writeByte(console, i.value)
    case none
    end
    try writeText(console, "\r\n")
end
