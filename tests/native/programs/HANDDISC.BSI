// A statement's call discards a handle result, which is freed (after
// else fail's jump, before a handler's), and an inferred local reads a
// field through an owning local.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var g: u8
var s: string[8]
sub make(v: u8): nodes
    return new nodes(v, none)
end
sub nothing()
end
sub mk(v: u8): nodes fails IoError
    if v = 0
        fail IoError.inputFailure
    end
    return new nodes(v, none)
end
sub main() fails IoError
    make(1)
    try mk(2)
    var e: IoError
    mk(3) handle e
        if e = IoError.inputFailure
            g = 1
        end
    end
    var a = new nodes(1, none)
    var y = a.value
end
