// Boolean xor: known and computed operands on either side, chained,
// mixed with or, and in a constant.
const K: boolean = true xor false
var a: boolean
var b: boolean
var r: boolean
sub show(v: boolean) fails
    if v
        try writeByte(console, 'T')
    else
        try writeByte(console, 'F')
    end
end
sub main() fails
    a = true
    b = false
    r = a xor b
    try show(r)
    try show(a xor true)
    try show(true xor a)
    try show(false xor b)
    try show(a xor b xor a)
    try show(a xor b or b)
    try show(K)
    try show(true xor true)
    try show((a xor b) = true)
    try writeText(console, "\r\n")
end
