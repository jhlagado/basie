// No move in an operand of and (review finding C11).
// spec: 10.8, 11.4.1, 12.5.1
// expect error: move-position at 22:18

forward pool nodes
record Node
    value as u8
    next as nodes?
end
pool nodes as Node[4]
var head as nodes?
var ident as id nodes?
sub eat(n as nodes) as u8
    return 1
end
sub mk() as nodes
    return new nodes(1, none)
end
sub main()
    var x = new nodes(1, none)
    var b as boolean
    if b and eat(move x) = 2
    end
end
