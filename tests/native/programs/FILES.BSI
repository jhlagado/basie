// Files as values, run (65.4 i): File program variables, locals and
// parameters, loaded and stored at their places, a parameter written, a
// local beyond IX-128 in a large frame, a File assigned from a call with
// its failure handled, and locals whose types are inferred from their
// initializers: a File, a u8, a u16 and a Boolean.
// file IN.TXT: in\r\n\x1a
// expect output: ABCDin\r\nE6\r\n
// expect file OUT.TXT: written\r\n

var out: File
var spare: File

sub emit(f: File, b: u8) fails
    var g = f
    try writeByte(g, b)
    f = printer
    g = console
    try writeByte(g, b + 1)
end

sub pick(n: u8, f: File, s: string[]) fails
    var line: string[8]
    try readLine(f, line)
    try writeText(console, line)
    try writeText(console, s)
end

sub main() fails
    var pad: u8[130]
    var far: File = console
    var near: File
    var code: u8 = 0
    var small = pad[0] + 2
    var wide = u16(small) * 3
    var yes = small = 2
    out = far
    spare = out
    try emit(spare, 'A')
    near = out
    try emit(near, 'C')
    near = openRead("IN.TXT", textMode) handle code
    end
    try pick(small, near, "\r\n")
    try close(near)
    far = try openWrite("OUT.TXT", textMode)
    try writeText(far, "written")
    try writeByte(far, 10)
    try close(far)
    near = openRead("NONE.TXT", binaryMode) handle code
        try writeByte(console, 'E')
    end
    if yes
        try writeByte(console, u8(wide) + '0')
    end
    try writeText(console, "\r\n")
end
