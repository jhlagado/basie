// Binary files: blocks, positions, sizes and seeking in an update file.
// spec: 16; services 4.4, 4.5
// expect output: 200 256 7 50 200\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    var buf: u8[200]
    var i: u16
    for i = 0 until 200
        buf[i] = u8(i mod 256)
    end
    var f = try openWrite("DATA.BIN", binaryMode)
    try writeBlock(f, buf, 200)
    var at = try position(f)
    try appendU32(var line, at)
    try close(f)
    var g = try openUpdate("DATA.BIN")
    try appendByte(var line, ' ')
    var length = try size(g)
    try appendU32(var line, length)
    try seek(g, 7)
    var b = try readByte(g)
    try appendByte(var line, ' ')
    try appendU16(var line, b)
    try seek(g, 50)
    var n = try readBlock(g, var buf, 150)
    try appendByte(var line, ' ')
    try appendU16(var line, buf[0])
    try appendByte(var line, ' ')
    at = try position(g)
    try appendU32(var line, at)
    try close(g)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
