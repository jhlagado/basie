// Counted loops take signed counters and negative steps.
// spec: 12.4
// expect output: 2 0 -2 \r\n

include "FORMAT.BSI"

sub main() fails IoError
    var line: string[30]
    var i: i8
    for i = 2 to -2 step -2
        try appendI16(var line, i)
        try appendByte(var line, ' ')
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
