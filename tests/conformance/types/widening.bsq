// Implicit widening only where no value is lost.
// spec: 6.4
// expect output: 200 -3 200\r\n

include "FORMAT.BSQ"

sub main() fails
    var small as u8 = 200
    var wide as u16 = small
    var delta as i8 = -3
    var signed as i16 = delta
    var both as i16 = small
    var line as string[40]
    appendU16(line, wide) else fail
    appendByte(line, ' ') else fail
    appendI16(line, signed) else fail
    appendByte(line, ' ') else fail
    appendI16(line, both) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
