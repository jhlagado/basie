// With a forward declaration, a routine may call itself.
// spec: 5.9, 13.8
// expect output: 321\r\n

forward sub countDown(n: u8) fails IoError

sub countDown
    if n > 0
        try writeByte(console, '0' + n)
        try countDown(n - 1)
    end
end

sub main() fails IoError
    try countDown(3)
    try writeText(console, "\r\n")
end
