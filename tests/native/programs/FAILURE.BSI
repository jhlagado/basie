// Failure: fail with exact and computed codes, try after calls,
// assignments and local initializers, handle into program variables,
// locals and parameters, a handled call beneath a pushed left operand,
// handlers inside loops and other handlers, and failable calls as right
// operands and under not.
var code: IoError
var count: u8
var total: u16 = 1

sub check(n: u8): u8 fails IoError
    if n > 9
        var e: IoError = IoError.storageFailure
        if n > 20
            e = IoError.badName
        end
        fail e
    end
    return n
end

sub wide(n: u16): u16 fails IoError
    if n = 0
        fail IoError.inputFailure
    end
    return n * 2
end

sub relay(n: u8): u8 fails IoError
    var first: u8 = try check(n)
    var second: u8 = try check(n + 1)
    first = first + second
    return first
end

sub keep(n: u8, e: IoError): u8 fails IoError
    var local: IoError
    var r: u8
    r = check(n) handle e
        r = 0
        local = e
    end
    check(n + 20) handle local
        total = total + 1
    end
    return r
end

sub truth(n: u8): boolean fails IoError
    if n = 0
        fail IoError.fileExists
    end
    return n > 1
end

sub operands() fails IoError
    var x: u8 = 2
    var b: boolean
    x = 1 + check(x) handle code
        fail code
    end
    x = x * check(x) handle code
    end
    b = not truth(x) handle code
        fail code
    end
    b = x > 3 and truth(x) handle code
    end
    x = 200 - check(x) handle code
        fail code
    end
end

sub main() fails IoError
    var i: u8
    var w: u16
    count = try relay(3)
    total = total + wide(5) handle code
        total = 0
    end
    for i = 1 to 12
        w = u16(i) + wide(u16(i) - 1) handle code
            w = 7
            relay(i) handle code
                exit
            end
        end
        if code = IoError.inputFailure
            continue
        end
    end
    while count < 9
        check(count + 10) handle code
        end
        count = try keep(count, code)
        count = count + 1
    end
    try operands()
    fail IoError.fileNotFound
end
