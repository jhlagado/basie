// FORMAT.BSI: hexadecimal, always two or four upper-case digits.
// spec: 16.4; standard library 3
// expect output: 00 7F FF 0000 BEEF 0A0B\r\n

include "FORMAT.BSI"

sub main() fails IoError
    var line: string[40]
    try appendHex8(var line, 0)
    try appendByte(var line, ' ')
    try appendHex8(var line, 127)
    try appendByte(var line, ' ')
    try appendHex8(var line, 255)
    try appendByte(var line, ' ')
    try appendHex16(var line, 0)
    try appendByte(var line, ' ')
    try appendHex16(var line, $BEEF)
    try appendByte(var line, ' ')
    try appendHex16(var line, $0A0B)
    try append(var line, "\r\n")
    try writeText(console, line)
end
