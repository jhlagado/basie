// Records, arrays and strings may be locals, zeroed unless initialized.
// spec: 7.6
// expect output: 09\r\n

include "FORMAT.BSI"

sub main() fails IoError
    var line: string[20]
    var grid: u8[3][4]
    grid[2][3] = 9
    try appendU16(var line, grid[0][0])
    try appendU16(var line, grid[2][3])
    try writeText(console, line)
    try writeText(console, "\r\n")
end
