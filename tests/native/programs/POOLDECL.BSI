// Pools: a forward pool, owning and id handle fields, two pools and
// handle program variables, arrays of handles among them.
forward pool cells
record Node
    value: u16
    next: cells?
    other: id cells?
end
record Leaf
    v: u8
end
pool leaves: Leaf[3]
pool cells: Node[2]
var head: cells?
var mark: id leaves?
var grid: cells?[3]
sub main()
end
