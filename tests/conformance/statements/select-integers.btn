// select chooses by constants, lists and ranges, with case else.
// spec: 11.7.2
// expect output: QD?\r\n

sub classify(c as u8) fails
    select c
    case 'q', 'Q'
        writeByte(console, 'Q') else fail
    case '0' to '9'
        writeByte(console, 'D') else fail
    case else
        writeByte(console, '?') else fail
    end
end

sub main() fails
    classify('Q') else fail
    classify('7') else fail
    classify('x') else fail
    writeText(console, "\r\n") else fail
end
