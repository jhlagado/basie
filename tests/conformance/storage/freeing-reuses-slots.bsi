// An owning local is freed at the end of its block, so its slot can be reused.
// spec: 7.12
// expect output: ok\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[1]

sub main() fails
    var i: u8
    for i = 1 to 5
        var n = new nodes(i, none)
    end
    writeText(console, "ok\r\n") else fail
end
