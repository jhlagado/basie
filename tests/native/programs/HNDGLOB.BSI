// Handles dereferenced outside the frame, as the reference loads them:
// elements of a program variable's array of owners, by constant and
// variable index, read and written; an array of identifiers; and an
// array of owners through a var parameter.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var hs: nodes[2]
var ids: id nodes[2]
var g: u8
var i: u8

sub f(var a: nodes[2], k: u8): u8
    a[k].value = 7
    return a[0].value
end

sub main()
    hs[0].value = 3
    g = hs[1].value
    g = hs[i].value
    hs[i].value = g
    g = ids[1].value
    var y = f(var hs, 1)
end
