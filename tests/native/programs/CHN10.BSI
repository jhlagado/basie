include "CHN11.BSI"
// Part 10 of a chain of includes: each part includes the next, so all
// of them are open while the last loads.
var c10: u16
sub p10r0(): u16
    c10 = c10 + 0
    c10 = c10 + 1
    c10 = c10 + 2
    c10 = c10 + 3
    return c10
end
sub p10r1(): u16
    c10 = c10 + 1
    c10 = c10 + 2
    c10 = c10 + 3
    c10 = c10 + 4
    return c10
end
sub p10r2(): u16
    c10 = c10 + 2
    c10 = c10 + 3
    c10 = c10 + 4
    c10 = c10 + 5
    return c10
end
sub p10r3(): u16
    c10 = c10 + 3
    c10 = c10 + 4
    c10 = c10 + 5
    c10 = c10 + 6
    return c10
end
sub p10r4(): u16
    c10 = c10 + 4
    c10 = c10 + 5
    c10 = c10 + 6
    c10 = c10 + 7
    return c10
end
sub p10r5(): u16
    c10 = c10 + 5
    c10 = c10 + 6
    c10 = c10 + 7
    c10 = c10 + 8
    return c10
end
sub p10r6(): u16
    c10 = c10 + 6
    c10 = c10 + 7
    c10 = c10 + 8
    c10 = c10 + 9
    return c10
end
sub p10r7(): u16
    c10 = c10 + 7
    c10 = c10 + 8
    c10 = c10 + 9
    c10 = c10 + 10
    return c10
end
