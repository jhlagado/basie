// Escapes in character literals (74): each decodes as in a string's.
var a: u8 = '\n'
var b: u8 = '\t'
var c: u8 = '\0'
var d: u8 = '\x41'
var e: u8 = '\''
var f: u8 = '\\'
var g: u8 = '"'
var h: u8 = 'z'
var s: string[8] = "a\x42\'c"
sub main() fails
    if a = 10 and b = 9 and c = 0 and d = 65 and e = 39 and f = 92 and g = 34 and h = 122 and s.length = 4
        try writeText(console, "chars\r\n")
    end
    select a
    case '\n'
        try writeText(console, "newline\r\n")
    case else
        fail 1
    end
end
