// Basie standard library: numbers to text (D36).
include "STRINGS.BSI"

sub appendU16(var s as string[], v as u16) fails
    var digits as u8[5]
    var count as u8 = 0
    var n as u16 = v
    while true
        digits[count] = u8(n mod 10) + '0'
        count = count + 1
        n = n / 10
        if n = 0
            exit
        end
    end
    while count > 0
        count = count - 1
        appendByte(s, digits[count]) else fail
    end
end

sub appendI16(var s as string[], v as i16) fails
    if v < 0
        appendByte(s, '-') else fail
        // not v is -v - 1, so this is -v without overflow at -32768.
        appendU16(s, u16(not v) + 1) else fail
    else
        appendU16(s, u16(v)) else fail
    end
end

sub appendU32(var s as string[], v as u32) fails
    var digits as u8[10]
    var count as u8 = 0
    var n as u32 = v
    while true
        digits[count] = u8(n mod 10) + '0'
        count = count + 1
        n = n / 10
        if n = 0
            exit
        end
    end
    while count > 0
        count = count - 1
        appendByte(s, digits[count]) else fail
    end
end

sub appendI32(var s as string[], v as i32) fails
    if v < 0
        appendByte(s, '-') else fail
        appendU32(s, u32(not v) + 1) else fail
    else
        appendU32(s, u32(v)) else fail
    end
end

// x with the given number of decimal places, rounded to the nearest unit of
// the last place. The scaled value must fit a u32.
sub appendF32(var s as string[], x as f32, places as u8) fails
    var v as f32 = x
    if v < 0.0
        appendByte(s, '-') else fail
        v = -v
    end
    var scale as u32 = 1
    var i as u8 = 0
    while i < places
        scale = scale * 10
        i = i + 1
    end
    var n as u32 = u32(v * f32(scale) + 0.5)
    appendU32(s, n / scale) else fail
    if places > 0
        appendByte(s, '.') else fail
        var frac as u32 = n mod scale
        var div as u32 = scale / 10
        while div > 0
            appendByte(s, u8(frac / div mod 10) + '0') else fail
            div = div / 10
        end
    end
end
