// TEXTIO.BSI on files: writeLine, readAll to the end and to a full buffer,
// and truncate in both modes, which copies a prefix and replaces the file.
// spec: 16.4; standard library 5
// file DATA.TXT: 0123456789
// file RAW.BIN: ABCDEFGHIJ
// expect output: 10 4 3 128 44 00\r\n
// expect file OUT.TXT: one\r\ntwo\r\n
// expect file DATA.TXT: 012
// expect no file DATA.~

include "FORMAT.BSI"
include "TEXTIO.BSI"

sub main() fails
    var out = try openWrite("OUT.TXT", textMode)
    try writeLine(out, "one")
    try writeLine(out, "two")
    try close(out)
    var buf: u8[16]
    var f = try openRead("DATA.TXT", textMode)
    var count = try readAll(f, buf)
    try close(f)
    var line: string[30]
    try appendU16(line, count)
    try appendByte(line, ' ')
    var four: u8[4]
    f = try openRead("DATA.TXT", textMode)
    count = try readAll(f, four)
    try close(f)
    try appendU16(line, count)
    try appendByte(line, ' ')
    try truncate("DATA.TXT", 3, textMode)
    f = try openRead("DATA.TXT", textMode)
    count = try readAll(f, buf)
    try close(f)
    try appendU16(line, count)
    try truncate("RAW.BIN", 4, binaryMode)
    var data: u8[130]
    f = try openRead("RAW.BIN", binaryMode)
    count = try readAll(f, data)
    try close(f)
    try appendByte(line, ' ')
    try appendU16(line, count)
    try appendByte(line, ' ')
    try appendHex8(line, data[3])
    try appendByte(line, ' ')
    try appendHex8(line, data[4])
    try writeLine(console, line)
end
