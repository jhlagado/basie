; Fixed compiler state for the scalar-local, counted-loop, and array slice.

CompilerStateBase       .equ CompilerWorkBase

SourcePartId            .equ CompilerStateBase+$00
SourceCursor            .equ CompilerStateBase+$01
SourceEnd               .equ CompilerStateBase+$03
SourceOffset            .equ CompilerStateBase+$05
SourceLine              .equ CompilerStateBase+$07
SourceColumn            .equ CompilerStateBase+$09
SourceLineHasToken       .equ CompilerStateBase+$0B
SourceDelimiterDepth    .equ CompilerStateBase+$0C

TokenStartOffset        .equ CompilerStateBase+$0D
TokenStartLine          .equ CompilerStateBase+$0F
TokenStartColumn        .equ CompilerStateBase+$11
TokenLexemePointer      .equ CompilerStateBase+$13
TokenLength             .equ CompilerStateBase+$15

DiagnosticCode          .equ CompilerStateBase+$16
DiagnosticPartId        .equ CompilerStateBase+$17
DiagnosticOffset        .equ CompilerStateBase+$18
DiagnosticLine          .equ CompilerStateBase+$1A
DiagnosticColumn        .equ CompilerStateBase+$1C

; A diagnostic ends parsing, so the live semantic sink may reuse the eventual
; offset and line fields. DiagnosticCode and DiagnosticPartId remain clear on
; successful compilation; an error overwrites all reused bytes before return.
; The high byte of DiagnosticLine and both bytes of DiagnosticColumn extend
; past CompilerStateEnd into the dead semantic buffer. The diagnostic is
; terminal, so no semantic byte remains live.
SinkCursor              .equ CompilerStateBase+$18
SinkOperationCount      .equ CompilerStateBase+$1A

; Emission begins only after parsing succeeds. Its scratch words therefore
; overlay dead source, token, diagnostic, and sink fields. SourcePartId and
; TokenStartOffset..TokenStartColumn remain intact for an emitter diagnostic.
EmitCursor              .equ CompilerStateBase+$03
EmitCodeStart           .equ CompilerStateBase+$05
EmitLoopHead            .equ CompilerStateBase+$07
EmitExitFixup           .equ CompilerStateBase+$09
EmitFailureFixup        .equ CompilerStateBase+$0B
EmitUpdateExitFixup     .equ CompilerStateBase+$19
EmitPatchAddress        .equ CompilerStateBase+$13
EmitLimit               .equ CompilerStateBase+$15
EmitDataFixup           .equ CompilerStateBase+$17

CompilerStateEnd        .equ CompilerStateBase+$1B
SemanticBufferBase      .equ CompilerStateEnd
SemanticPayloadBase     .equ SemanticBufferBase+1
; The leading byte is an operation count and the remaining 511 bytes are a
; bounded variable-width transcript. Word aggregate operands must not make the
; complete Chapter 21 program depend on the retired byte-extent encoding.
SemanticBufferLimit     .equ SemanticBufferBase+$200

; Host-only source-map trace ports. Every instruction that uses these equates
; is conditionally absent unless the target compiler sets DebugHooks to one.
; OUT (n),A exposes the full port as (A << 8) | n; hosts classify the low byte.
DebugTraceSourcePort       .equ $D8
DebugTraceDeclarationPort  .equ $D9
DebugTraceContextPushPort  .equ $DA
DebugTraceContextPopPort   .equ $DB
DebugTraceRoutinePort      .equ $DC
DebugTraceSemanticStartPort .equ $DD
DebugTraceSemanticEndPort  .equ $DE
DebugTraceImageBytePort    .equ $DF

; One retained forward signature is enough for the first routine-call slice.
; The source bytes remain stable, so exact names are retained as pointer/length
; pairs rather than copied into another buffer.
ForwardNamePointer      .equ SemanticBufferLimit+$00
ForwardNameLength       .equ SemanticBufferLimit+$02
ForwardParameterPointer .equ SemanticBufferLimit+$03
ForwardParameterLength  .equ SemanticBufferLimit+$05
ForwardOrdinal          .equ SemanticBufferLimit+$06
ForwardCompleted        .equ SemanticBufferLimit+$07
ForwardParameterType    .equ SemanticBufferLimit+$08
ForwardResultType       .equ SemanticBufferLimit+$09

; The predictive expression path keeps one token of lookahead. $FF denotes an
; empty lookahead cell; token ordinals occupy the low half of the byte range.
ParserLookaheadKind     .equ SemanticBufferLimit+$0A
ParserLookaheadValue    .equ SemanticBufferLimit+$0B

; Source bytes remain resident through compilation, so a scalar symbol keeps
; the exact spelling as a pointer and length instead of copying name bytes.
; The entry at SymbolCount is provisional until the declaration initializer
; succeeds; lookup sees only the committed prefix.
SymbolCount             .equ SemanticBufferLimit+$0D
NextLocalSlot           .equ SemanticBufferLimit+$0E
NextProgramSlot         .equ SemanticBufferLimit+$0F
SymbolTableBase         .equ SemanticBufferLimit+$10
SymbolEntrySize         .equ 6
SymbolCapacity          .equ 16
SymbolTableLimit        .equ SymbolTableBase+SymbolEntrySize*SymbolCapacity

; Expression metadata is deliberately explicit in the correctness build.
; A bounded stack retains the left operand of recursive expression parses;
; each entry is metadata plus a constant value word. The later compression
; pass may overlay this state once its liveness has been measured.
ExpressionExpectedType  .equ SymbolTableLimit+$00
ExpressionEmitEnabled   .equ SymbolTableLimit+$01
ExpressionSuppressFault .equ SymbolTableLimit+$02
ExpressionStackDepth    .equ SymbolTableLimit+$03
ExpressionRightMeta     .equ SymbolTableLimit+$04
ExpressionRightValue    .equ SymbolTableLimit+$05
ExpressionLeftMeta      .equ SymbolTableLimit+$07
ExpressionLeftValue     .equ SymbolTableLimit+$08
ExpressionOperator      .equ SymbolTableLimit+$0A
ExpressionOperatorOffset .equ SymbolTableLimit+$0B
DeclarationInfo         .equ SymbolTableLimit+$0D
DeclarationPayload      .equ SymbolTableLimit+$0E
DeclarationNamePointer  .equ SymbolTableLimit+$10
DeclarationNameLength   .equ SymbolTableLimit+$12
ExpressionCallOffset    .equ SymbolTableLimit+$13
DeclarationNamePosition .equ SymbolTableLimit+$15 ; offset, line, column
ExpressionValuePosition .equ SymbolTableLimit+$1B ; offset, line, column
ExpressionLeftPositionPointer .equ SymbolTableLimit+$21
ExpressionStackBase     .equ SymbolTableLimit+$23
ExpressionStackCapacity .equ 16
ExpressionStackEntrySize .equ 13
ExpressionStackLimit    .equ ExpressionStackBase+ExpressionStackCapacity*ExpressionStackEntrySize

; Boolean short-circuit emission retains one forward patch per nesting level.
EmitBooleanFixupDepth   .equ ExpressionStackLimit+$00
EmitBooleanFixupBase    .equ ExpressionStackLimit+$01
EmitBooleanFixupCapacity .equ 16
EmitBooleanFixupLimit   .equ EmitBooleanFixupBase+EmitBooleanFixupCapacity*2

; Structured-control parsing and Z80 emission occur in disjoint phases.
; The parser uses bounded ten-byte control frames; after successful parsing the
; Z80 backend reuses the same region for absolute labels and branch fixups.
ControlWorkspaceBase    .equ EmitBooleanFixupLimit
ControlDepth            .equ ControlWorkspaceBase+$00
ControlNextLabel        .equ ControlWorkspaceBase+$01
ControlGlobalSymbolCount .equ ControlWorkspaceBase+$02
ControlRoutineKind      .equ ControlWorkspaceBase+$03
ControlResultType       .equ ControlWorkspaceBase+$04
ControlSequenceFallsThrough .equ ControlWorkspaceBase+$05
ControlFrameBase        .equ ControlWorkspaceBase+$08
ControlFrameSize        .equ 10
ControlFrameCapacity    .equ 8
ControlFrameLimit       .equ ControlFrameBase+ControlFrameSize*ControlFrameCapacity

ControlKindIf           .equ 1
ControlKindWhile        .equ 2
ControlKindFor          .equ 3
ControlKindHandler      .equ 4
ControlRoutineNone      .equ 0
ControlRoutineValue     .equ 1
ControlRoutineLabel     .equ 31
ControlFrameKind        .equ 0
ControlFrameLabelA      .equ 1
ControlFrameContinue    .equ 2
ControlFrameExit        .equ 3
ControlFrameCounter     .equ 4
ControlFrameMode        .equ 5
ControlFrameStep        .equ 6
ControlFrameTrapOffset  .equ 8
ControlNoCounter        .equ $FF

EmitControlFixupCount   .equ ControlWorkspaceBase+$00
EmitControlLabelValidBase .equ ControlWorkspaceBase+$01
EmitControlLabelCapacity .equ 32
EmitControlLabelAddressBase .equ EmitControlLabelValidBase+EmitControlLabelCapacity
EmitControlFixupBase    .equ EmitControlLabelAddressBase+EmitControlLabelCapacity*2
EmitControlFixupSize    .equ 3
EmitControlFixupCapacity .equ 32
EmitControlFixupLimit   .equ EmitControlFixupBase+EmitControlFixupSize*EmitControlFixupCapacity
; Published program metadata must survive source parsing. It therefore cannot
; overlay SourceCursor as the earlier non-atomic slices did.
GeneratedSize           .equ EmitControlFixupLimit
.if SegmentedOutput
; Four target-adapter segments. Each retained entry is base then exclusive
; limit. Code and rodata have published image bytes;
; data and bss describe runtime storage initialized by the generated startup.
GeneratedRoDataSize     .equ GeneratedSize+2
GeneratedDataSize       .equ GeneratedRoDataSize+2
GeneratedBssSize        .equ GeneratedDataSize+2
PublishedSize           .equ GeneratedBssSize+2
PublishedRoDataSize     .equ PublishedSize+2
PublishedDataSize       .equ PublishedRoDataSize+2
PublishedBssSize        .equ PublishedDataSize+2
SegmentTableBase        .equ PublishedBssSize+2
SegmentEntrySize        .equ 4
SegmentCapacity         .equ 4
SegmentTableLimit       .equ SegmentTableBase+SegmentEntrySize*SegmentCapacity
SegmentEntryBase        .equ 0
SegmentEntryLimit       .equ 2
SegmentCode             .equ 0
SegmentRoData           .equ 1
SegmentData             .equ 2
SegmentBss              .equ 3
SegmentCodeEntry        .equ SegmentTableBase+SegmentEntrySize*SegmentCode
SegmentRoDataEntry      .equ SegmentTableBase+SegmentEntrySize*SegmentRoData
SegmentDataEntry        .equ SegmentTableBase+SegmentEntrySize*SegmentData
SegmentBssEntry         .equ SegmentTableBase+SegmentEntrySize*SegmentBss
SegmentRoDataCursor     .equ SegmentTableLimit ; word
ProgramBssLength        .equ SegmentRoDataCursor+2 ; word
Stage5WorkspaceEnd      .equ ProgramBssLength+2
.else
PublishedSize           .equ GeneratedSize+2
Stage5WorkspaceEnd      .equ PublishedSize+2
.endif

; Stage 6 retains aggregate type and layout metadata for the complete
; compilation. Type IDs 1..3 are the predefined scalars; IDs 4 and above name
; bounded four-byte descriptors. Record field offsets remain live for the
; later selection stage, while the complete static image survives into Z80
; emission.
AggregateStateBase      .equ Stage5WorkspaceEnd
AggregateMode           .equ AggregateStateBase+$00
AggregateTypeCount      .equ AggregateStateBase+$01
AggregateRecordCount    .equ AggregateStateBase+$02
AggregateFieldCount     .equ AggregateStateBase+$03
AggregateInitializerDepth .equ AggregateStateBase+$04
; Nonzero once an explicit initializer has supplied at least one value. The
; value is a Boolean allocation choice, not a retained element count.
AggregateHasInitializer .equ AggregateStateBase+$05
AggregateCurrentTypeId  .equ AggregateStateBase+$06
AggregateCurrentFieldStart .equ AggregateStateBase+$07
AggregateCurrentFieldCount .equ AggregateStateBase+$08
AggregateCurrentRecordExtent .equ AggregateStateBase+$09 ; word
AggregateCurrentObjectOffset .equ AggregateStateBase+$0B ; word
AggregateCurrentObjectExtent .equ AggregateStateBase+$0D ; word
AggregateCandidateKind .equ AggregateStateBase+$0F
AggregateCandidateAux  .equ AggregateStateBase+$10
AggregateCandidateLength .equ AggregateStateBase+$11 ; word
AggregateCandidateExtent .equ AggregateStateBase+$13 ; word
AggregateCurrentObjectEnd .equ AggregateStateBase+$15 ; word
AggregateStateEnd       .equ AggregateStateBase+$17

AggregateTypeTableBase  .equ AggregateStateEnd
AggregateTypeEntrySize  .equ 4
AggregateTypeCapacity   .equ 8
AggregateTypeTableLimit .equ AggregateTypeTableBase+AggregateTypeEntrySize*AggregateTypeCapacity
AggregateTypeKind       .equ 0
AggregateTypeAux        .equ 1
AggregateTypeLength     .equ 2 ; word
; Every dynamic type retains its complete nonzero extent as a word. Strings
; remain byte-capacity values, while arrays and records may occupy the complete
; selected program-data region.
AggregateTypeExtentBase .equ AggregateTypeTableLimit
AggregateTypeExtentLimit .equ AggregateTypeExtentBase+2*AggregateTypeCapacity

AggregateRecordTableBase .equ AggregateTypeExtentLimit
AggregateRecordEntrySize .equ 2
AggregateRecordCapacity .equ 5
AggregateRecordTableLimit .equ AggregateRecordTableBase+AggregateRecordEntrySize*AggregateRecordCapacity
AggregateRecordFieldStart .equ 0
AggregateRecordFieldCount .equ 1

AggregateFieldTableBase .equ AggregateRecordTableLimit
AggregateFieldEntrySize .equ 6
AggregateFieldCapacity  .equ 12
AggregateFieldTableLimit .equ AggregateFieldTableBase+AggregateFieldEntrySize*AggregateFieldCapacity
AggregateFieldNamePointer .equ 0
AggregateFieldNameLength .equ 2
AggregateFieldTypeId    .equ 3
AggregateFieldOffset    .equ 4 ; word

; One type ID per ordinary symbol is enough because the ordinary symbol table
; owns name identity and the payload word owns the program-data offset.
AggregateSymbolTypeBase .equ AggregateFieldTableLimit
AggregateSymbolTypeLimit .equ AggregateSymbolTypeBase+SymbolCapacity

StaticImageLength       .equ AggregateSymbolTypeLimit ; word
.if SegmentedOutput
ReadOnlyImageLength     .equ StaticImageLength+2 ; word
; One complete object is built in scratch. Published rodata keeps initialized
; data first and aggregate-constant bytes in a read-only suffix.
AggregateInitializerBase .equ ReadOnlyImageLength+2
AggregateInitializerCapacity .equ 1024
StaticImageBase         .equ AggregateInitializerBase+AggregateInitializerCapacity
StaticImageCapacity     .equ 1024
.else
StaticImageBase         .equ StaticImageLength+2
AggregateInitializerBase .equ StaticImageBase
StaticImageCapacity     .equ 255
.endif
StaticImageLimit        .equ StaticImageBase+StaticImageCapacity
AggregateWorkspaceEnd   .equ StaticImageLimit
CompilerWorkspaceEnd    .equ AggregateWorkspaceEnd

AggregateInitializerDepthCapacity .equ 4

; Emission follows successful parsing and may overlay the retained forward.
SemanticReadCursor      .equ ForwardNamePointer
EmitRoutineAddress      .equ ForwardParameterPointer
EmitRoutineCallFixup    .equ ForwardParameterLength
EmitIfFixup             .equ ForwardOrdinal

TokenEof                .equ 0
TokenNewline            .equ 1
TokenName               .equ 2
TokenCharacter          .equ 3
TokenNumber             .equ 4
TokenLeftParen          .equ 5
TokenRightParen         .equ 6
TokenEquals             .equ 7
TokenSub                .equ 8
TokenFails              .equ 9
TokenOr                 .equ 10
TokenFail               .equ 11
TokenEnd                .equ 12
TokenVar                .equ 13
TokenAs                 .equ 14
TokenU8                 .equ 15
TokenFor                .equ 16
TokenUntil              .equ 17
TokenLeftBracket        .equ 18
TokenRightBracket       .equ 19
TokenComma              .equ 20
TokenForward            .equ 21
TokenReturn             .equ 22
TokenIf                 .equ 23
TokenMinus              .equ 24
TokenPlus               .equ 25
TokenStar               .equ 26
TokenU16                .equ 27
TokenBoolean            .equ 28
TokenTrue               .equ 29
TokenFalse              .equ 30
TokenConst              .equ 31
TokenSlash              .equ 32
TokenLess               .equ 33
TokenLessEqual          .equ 34
TokenGreater            .equ 35
TokenGreaterEqual       .equ 36
TokenNotEqual           .equ 37
TokenNot                .equ 38
TokenAnd                .equ 39
TokenElseIf             .equ 40
TokenElse               .equ 41
TokenWhile              .equ 42
TokenTo                 .equ 43
TokenStep               .equ 44
TokenExit               .equ 45
TokenContinue           .equ 46
TokenStringLiteral      .equ 47
TokenRecord             .equ 48
TokenString             .equ 49
TokenDot                .equ 50
TokenHandle             .equ 51
; Ordinal 52 is intentionally unused so later token ordinals remain stable.
TokenXor                .equ 53
TokenMod                .equ 54
TokenAssert             .equ 55

DiagnosticNone          .equ 0
DiagnosticLexical       .equ 1
DiagnosticExpectedMain  .equ 17
DiagnosticExpectedWrite .equ 22
DiagnosticExpectedIndex .equ 29
DiagnosticActiveCounter .equ 36
DiagnosticExpectedTopLevel .equ 37
DiagnosticExpectedBytes .equ 38
DiagnosticExpectedArrayLength .equ 39
DiagnosticSinkCapacity  .equ 40
DiagnosticFixupRange    .equ 41
DiagnosticExpectedRead  .equ 45
DiagnosticExpectedValue .equ 51
DiagnosticExpectedResult .equ 52
DiagnosticForwardMismatch .equ 53
DiagnosticForwardIncomplete .equ 54
DiagnosticDuplicateName .equ 55
DiagnosticSymbolCapacity .equ 56
DiagnosticUnknownName   .equ 57
DiagnosticExpectedScalar .equ 58
DiagnosticExpectedType .equ 59
DiagnosticTypeMismatch .equ 60
DiagnosticIntegerRange .equ 61
DiagnosticDivisionZero .equ 62
DiagnosticNarrowing    .equ 63
DiagnosticComparisonChain .equ 64
DiagnosticExpressionCapacity .equ 65
DiagnosticBooleanFixupCapacity .equ 66
DiagnosticInternalOperation .equ 67
DiagnosticControlCapacity .equ 68
DiagnosticControlLabelCapacity .equ 69
DiagnosticControlFixupCapacity .equ 70
DiagnosticExpectedBoolean .equ 71
DiagnosticExpectedLoop .equ 72
DiagnosticLoopCounter  .equ 73
DiagnosticLoopStep     .equ 74
DiagnosticRoutineFlow  .equ 75
DiagnosticTypeMetadataCapacity .equ 76
DiagnosticInitializerCapacity .equ 77
DiagnosticInitializerShape .equ 78
DiagnosticInitializerCount .equ 79
DiagnosticStringLength .equ 80
DiagnosticProgramDataCapacity .equ 81
; Bounded string capacity is at most 253; use u8[N] plus a scalar length for
; an unterminated, caller-managed buffer.
DiagnosticStringCapacity .equ 90
DiagnosticAssertionFailed .equ 91
DiagnosticOutputSegment .equ 92
DiagnosticReadOnlyCapacity .equ 93
DiagnosticReadOnlyAssignment .equ 94
DiagnosticRecordEmpty  .equ 82
DiagnosticTypeBound    .equ 83

; Ordinary token mismatches encode the token ordinal directly. Named-value
; mismatches retain their context-specific diagnostic codes above.
DiagnosticExpectedTokenBase .equ $80
DiagnosticExpectedEof   .equ DiagnosticExpectedTokenBase+TokenEof
DiagnosticExpectedName  .equ DiagnosticExpectedTokenBase+TokenName
DiagnosticExpectedLine  .equ DiagnosticExpectedTokenBase+TokenNewline
DiagnosticExpectedChar  .equ DiagnosticExpectedTokenBase+TokenCharacter
DiagnosticExpectedNumber .equ DiagnosticExpectedTokenBase+TokenNumber
DiagnosticExpectedLeft  .equ DiagnosticExpectedTokenBase+TokenLeftParen
DiagnosticExpectedRight .equ DiagnosticExpectedTokenBase+TokenRightParen
DiagnosticExpectedEqual .equ DiagnosticExpectedTokenBase+TokenEquals
DiagnosticExpectedSub   .equ DiagnosticExpectedTokenBase+TokenSub
DiagnosticExpectedFails .equ DiagnosticExpectedTokenBase+TokenFails
DiagnosticExpectedOr    .equ DiagnosticExpectedTokenBase+TokenOr
DiagnosticExpectedFail  .equ DiagnosticExpectedTokenBase+TokenFail
DiagnosticExpectedEnd   .equ DiagnosticExpectedTokenBase+TokenEnd
DiagnosticExpectedVar   .equ DiagnosticExpectedTokenBase+TokenVar
DiagnosticExpectedAs    .equ DiagnosticExpectedTokenBase+TokenAs
DiagnosticExpectedU8    .equ DiagnosticExpectedTokenBase+TokenU8
DiagnosticExpectedFor   .equ DiagnosticExpectedTokenBase+TokenFor
DiagnosticExpectedUntil .equ DiagnosticExpectedTokenBase+TokenUntil
DiagnosticExpectedLeftBracket .equ DiagnosticExpectedTokenBase+TokenLeftBracket
DiagnosticExpectedRightBracket .equ DiagnosticExpectedTokenBase+TokenRightBracket
DiagnosticExpectedComma .equ DiagnosticExpectedTokenBase+TokenComma
DiagnosticExpectedForward .equ DiagnosticExpectedTokenBase+TokenForward
DiagnosticExpectedReturn .equ DiagnosticExpectedTokenBase+TokenReturn
DiagnosticExpectedIf    .equ DiagnosticExpectedTokenBase+TokenIf
DiagnosticExpectedMinus .equ DiagnosticExpectedTokenBase+TokenMinus
DiagnosticExpectedPlus  .equ DiagnosticExpectedTokenBase+TokenPlus
DiagnosticExpectedStar  .equ DiagnosticExpectedTokenBase+TokenStar
DiagnosticExpectedStringLiteral .equ DiagnosticExpectedTokenBase+TokenStringLiteral

ScalarTypeExact         .equ 0
ScalarTypeU8            .equ 1
ScalarTypeU16           .equ 2
ScalarTypeBoolean       .equ 3
ScalarMetaTypeMask      .equ $03
ScalarMetaConstant      .equ $80
SymbolClassConstant     .equ $00
SymbolClassProgram      .equ $04
SymbolClassLocal        .equ $08
SymbolClassParameter    .equ $0C
SymbolClassMask         .equ $0C
SymbolRecordTypeFlag    .equ $40
SymbolAggregateFlag     .equ $80
SymbolInfoRecordType    .equ SymbolRecordTypeFlag
SymbolInfoAggregateProgram .equ SymbolAggregateFlag+SymbolClassProgram

AggregateTypeIdU8       .equ ScalarTypeU8
AggregateTypeIdU16      .equ ScalarTypeU16
AggregateTypeIdBoolean  .equ ScalarTypeBoolean
AggregateFirstDynamicTypeId .equ 4
AggregateTypeKindRecord .equ 4
AggregateTypeKindString .equ 5
AggregateTypeKindArray  .equ 6
; Parameter-only open bounded-string view. It is never interned in the
; aggregate type table and therefore remains outside its compact ordinals.
AggregateOpenStringTypeId .equ $7C

SymbolInfoConstantU8    .equ SymbolClassConstant+ScalarTypeU8
SymbolInfoConstantU16   .equ SymbolClassConstant+ScalarTypeU16
SymbolInfoConstantBoolean .equ SymbolClassConstant+ScalarTypeBoolean
SymbolInfoProgramU8     .equ SymbolClassProgram+ScalarTypeU8
SymbolInfoProgramU16    .equ SymbolClassProgram+ScalarTypeU16
SymbolInfoProgramBoolean .equ SymbolClassProgram+ScalarTypeBoolean
SymbolInfoLocalU8       .equ SymbolClassLocal+ScalarTypeU8
SymbolInfoLocalU16      .equ SymbolClassLocal+ScalarTypeU16
SymbolInfoLocalBoolean  .equ SymbolClassLocal+ScalarTypeBoolean

SemanticDeclareU8       .equ 1
SemanticForUntilU8      .equ 2
SemanticWriteOutputByte .equ 3
SemanticPropagate       .equ 4
SemanticEndLoop         .equ 5
SemanticReturn          .equ 6
SemanticStaticU8Array   .equ 7
SemanticReadInputByte   .equ 8
SemanticStoreResultU8   .equ 9
SemanticLoadArrayU8     .equ 10
SemanticWriteOutputU8   .equ 11
SemanticCallLiteralU8   .equ 12
SemanticWriteLocalU8    .equ 13
SemanticBeginForwardU8  .equ 14
SemanticIfParameterZero .equ 15
SemanticReturnParameter .equ 16
SemanticEndIf           .equ 17
SemanticReturnSelfMinus .equ 18
SemanticEndRoutine      .equ 19
SemanticDefineProgramU8 .equ 20
SemanticBeginMain       .equ 21
SemanticDeclareLocalU8  .equ 22
SemanticLiteralU8       .equ 23
SemanticLoadProgramU8   .equ 24
SemanticLoadLocalU8     .equ 25
SemanticMultiplyU8      .equ 26
SemanticAddU8           .equ 27
SemanticStoreProgramU8  .equ 28
SemanticStoreLocalU8    .equ 29
SemanticWriteValueU8    .equ 30
SemanticEndMain         .equ 31
SemanticDefineProgram16 .equ 32
SemanticDeclareLocal16  .equ 33
SemanticLiteral16       .equ 34
SemanticLoadProgram16   .equ 35
SemanticLoadLocal16     .equ 36
SemanticAdd8            .equ 37
SemanticAdd16           .equ 38
SemanticSubtract8       .equ 39
SemanticSubtract16      .equ 40
SemanticMultiply8       .equ 41
SemanticMultiply16      .equ 42
SemanticDivide8         .equ 43
SemanticDivide16        .equ 44
SemanticNegate8         .equ 45
SemanticNegate16        .equ 46
SemanticNot8            .equ 47
SemanticNot16           .equ 48
SemanticNotBoolean      .equ 49
SemanticAnd8            .equ 50
SemanticAnd16           .equ 51
SemanticOr8             .equ 52
SemanticOr16            .equ 53
SemanticXor8            .equ 54
SemanticXor16           .equ 55
SemanticModulo8         .equ 56
SemanticModulo16        .equ 57
SemanticCompare8        .equ 58
SemanticCompare16       .equ 59
SemanticCompareBoolean  .equ 60
SemanticNarrowU8        .equ 61
SemanticStoreProgram16  .equ 62
SemanticStoreLocal16    .equ 63
SemanticBeginBooleanAnd .equ 64
SemanticBeginBooleanOr  .equ 65
SemanticEndBoolean      .equ 66
SemanticControlLabel    .equ 67
SemanticBranchFalse     .equ 68
SemanticJump            .equ 69
SemanticForSetup        .equ 70
SemanticForTest         .equ 71
SemanticForNext         .equ 72
SemanticForCleanup      .equ 73
SemanticBeginRoutine    .equ 74
SemanticLoadParameter8  .equ 75
SemanticLoadParameter16 .equ 76
SemanticCallScalar      .equ 77
SemanticReturnScalar    .equ 78
SemanticStoreParameter8 .equ 79
SemanticStoreParameter16 .equ 80
SemanticEndTypedRoutine .equ 81

ComparisonEqual         .equ 0
ComparisonNotEqual      .equ 1
ComparisonLess          .equ 2
ComparisonLessEqual     .equ 3
ComparisonGreater       .equ 4
ComparisonGreaterEqual  .equ 5
