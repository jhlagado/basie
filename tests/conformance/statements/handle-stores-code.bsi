// handle stores the failure code and runs its body; the success store is skipped.
// spec: 14.6
// expect output: N 7\r\n

include "FORMAT.BSI"

enum Readiness
    notReady
end

sub tryIt(ok: boolean): u8 fails Readiness
    if not ok
        fail Readiness.notReady
    end
    return 7
end

sub main() fails IoError
    var line: string[12]
    var code: Readiness
    var value: u8 = 0
    value = tryIt(false) handle code
        if code = Readiness.notReady
            try appendByte(var line, 'N')
        end
    end
    try appendByte(var line, ' ')
    value = tryIt(true) handle code
        try appendByte(var line, '!')
    end
    try appendU16(var line, value)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
