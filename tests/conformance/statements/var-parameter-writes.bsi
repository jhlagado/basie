// A var parameter changes the caller's object.
// spec: 13.4
// expect output: 6\r\n

include "FORMAT.BSI"

record Point
    x: i16
    y: i16
end

sub nudge(var p: Point)
    p.x = p.x + 5
end

sub main() fails
    var line: string[8]
    var here: Point = (1, 2)
    nudge(var here)
    try appendI16(var line, here.x)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
