// The review's doubly linked list with unlink through identifiers (4.3).
// spec: 7
// expect output: 3 2 1\r\n3 1\r\n

include "FORMAT.BSI"

forward pool dnodes

record DNode
    key: u16
    next: dnodes?
    prev: id dnodes?
end

pool dnodes: DNode[64]
var first: dnodes?
var last: id dnodes?

sub pushFront(k: u16)
    var n = new dnodes(k, none, none)
    select first
    case some(f)
        f.prev = id(n)
    case none
        last = id(n)
    end
    n.next = move first
    first = move n
end

sub unlink(x: id dnodes)
    var nx = move x.next
    select nx
    case some(n)
        n.prev = x.prev
    case none
        last = x.prev
    end
    select x.prev
    case some(p)
        p.next = move nx
    case none
        first = move nx
    end
end

sub show() fails IoError
    var line: string[40]
    var p = id(first)
    var started: boolean = false
    while true
        select p
        case some(i)
            if started
                try appendByte(var line, ' ')
            end
            started = true
            try appendU16(var line, i.key)
            p = id(i.next)
        case none
            try writeText(console, line)
            try writeText(console, "\r\n")
            return
        end
    end
end

sub main() fails IoError
    pushFront(1)
    pushFront(2)
    pushFront(3)
    try show()
    var p = id(first)
    select p
    case some(i)
        select i.next
        case some(second)
            unlink(second)
        case none
        end
    case none
    end
    try show()
end
