// The most negative value divided by -1 wraps to itself.
// spec: 9.8
// expect output: -32768\r\n

include "FORMAT.BSI"

sub main() fails IoError
    var line: string[12]
    var a: i16 = -32768
    var b: i16 = -1
    try appendI16(var line, a / b)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
