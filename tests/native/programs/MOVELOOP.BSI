// A loop that moves an owner and refills it before its back edge.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var g: u8
var c: boolean
sub main()
    var a = new nodes(1, none)
    while c
        head = move a
        a = new nodes(2, none)
    end
    g = a.value
end
