// Slot-holders: a moved-out place refilled, a returned owner, a fail.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var list: nodes?

sub pop(var l: nodes?): u8
    select l
    case some(n)
        var v = n.value
        var rest = move n.next
        l = move rest
        return v
    case none
    end
    return 0
end

sub take(var l: nodes?): nodes?
    var t = move l
    return move t
end

sub check(var l: nodes?) fails IoError
    var keep = new nodes(9, none)
    select l
    case none
        fail IoError.tooManyFiles
    case some(x)
    end
end

sub main() fails IoError
    list = new nodes('A', new nodes('B', none))
    try writeByte(console, pop(var list))
    var t = take(var list)
    try check(var list)
    try writeText(console, "\r\n")
end
