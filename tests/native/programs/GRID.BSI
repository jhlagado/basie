// Arrays of arrays, the outermost dimension first: elements reached through
// one or two computed indexes, each checked against its own bound, the
// outer address pushed while the inner index is computed; static
// initializers of nested brackets; and locals beyond IX-128, a frame of
// over a kilobyte, reached through their computed addresses (65.4 h).
record tile
    kind: u8
    marks: u16[2][2]
end

var grid: u8[3][4]
var tiles: tile[2]
const magic: u8[2][3] = [[1, 2, 3], [4, 5, 6]]
var i: u8 = 1
var j: u8 = 2
var x: u8
var y: u16

sub board(): u8[3][4]
    return grid
end

sub main()
    var screen: u8[25][40]
    var small: u16[2][3] = [[10, 20, 30], [40, 50, 60]]
    var last: tile
    var far: u8
    grid[1][2] = 9
    grid[i][j] = grid[j][i] + 1
    x = grid[i][3] + grid[2][j]
    screen[24][39] = 'X'
    screen[i][j] = screen[j][i]
    x = magic[i][j] + magic[1][i]
    y = small[i][j] + small[1][2]
    small[j - 1][i] = y
    tiles[i].marks[j - 1][i] = 7
    y = tiles[1].marks[i][j - 2]
    x = board()[i][j] + board()[2][3]
    last.marks[i][i] = 300
    y = last.marks[1][j - 1]
    far = x + 1
    last.kind = far
    x = last.kind + far
end
