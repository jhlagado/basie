// BUGS: hold the cave against the bugs.
//
// You are the @ in a small cave; bugs (B) crawl in from the edges and close
// in. Each turn, move with N, S, E or W, or zap the nearest bug in a line
// with ZAP and a direction. Zap 8 bugs to win; if one reaches you, you lose.
//
// The bugs live in a pool of 6 slots, chained in a list that owns them. A
// zapped bug is freed and its slot used again; when every slot is taken,
// no more bugs appear until one is zapped.

include "FORMAT.BSI"
include "TEXTIO.BSI"
include "RANDOM.BSI"

const width = 11
const height = 7
const goal = 8

forward pool bugs

record Bug
    x: u8
    y: u8
    next: bugs?
end

pool bugs: Bug[6]

var swarm: bugs?
var playerX: u8 = 5
var playerY: u8 = 3
var zapped: u8 = 0

sub bugAt(x: u8, y: u8): boolean
    var p = id(swarm)
    while true
        select p
        case some(b)
            if b.x = x and b.y = y
                return true
            end
            p = id(b.next)
        case none
            return false
        end
    end
    return false
end

// A new bug at a random place on the edge, unless the pool is full or the
// place is taken.
sub spawn()
    var x: u8 = u8(randomBelow(width))
    var y: u8 = 0
    if randomBelow(2) = 1
        y = height - 1
    end
    if bugAt(x, y) or (x = playerX and y = playerY)
        return
    end
    var b = new? bugs(x, y, none)
    select move b
    case some(n)
        n.next = move swarm
        swarm = move n
    case none
    end
end

sub draw() fails IoError
    var line: string[20]
    var y: u8 = 0
    while y < height
        clear(var line)
        var x: u8 = 0
        while x < width
            if x = playerX and y = playerY and bugAt(x, y)
                try appendByte(var line, '*')
            elseif x = playerX and y = playerY
                try appendByte(var line, '@')
            elseif bugAt(x, y)
                try appendByte(var line, 'B')
            else
                try appendByte(var line, '.')
            end
            x = x + 1
        end
        try writeLine(console, line)
        y = y + 1
    end
end

// One step toward a, from v.
sub toward(v: u8, a: u8): u8
    if v < a
        return v + 1
    elseif v > a
        return v - 1
    end
    return v
end

// Every bug steps toward the player, along x or y at random. True when one
// reaches the player.
sub crawl(): boolean
    var p = id(swarm)
    while true
        select p
        case some(b)
            var x = b.x
            var y = b.y
            if randomBelow(2) = 0 and x <> playerX
                x = toward(x, playerX)
            else
                y = toward(y, playerY)
            end
            if not bugAt(x, y)
                b.x = x
                b.y = y
            end
            if b.x = playerX and b.y = playerY
                return true
            end
            p = id(b.next)
        case none
            return false
        end
    end
    return false
end

// Free the bug at x, y.
sub squash(x: u8, y: u8)
    select swarm
    case some(f)
        if f.x = x and f.y = y
            swarm = move f.next
            return
        end
    case none
        return
    end
    var p = id(swarm)
    while true
        select p
        case some(i)
            select i.next
            case some(q)
                if q.x = x and q.y = y
                    i.next = move q.next
                    return
                end
                p = q
            case none
                return
            end
        case none
            return
        end
    end
end

// Zap along a direction from the player: the first bug in line is freed.
sub zap(dx: i8, dy: i8): boolean
    var x = i16(playerX)
    var y = i16(playerY)
    while true
        x = x + i16(dx)
        y = y + i16(dy)
        if x < 0 or y < 0 or x >= width or y >= height
            return false
        end
        if bugAt(u8(x), u8(y))
            squash(u8(x), u8(y))
            return true
        end
    end
    return false
end

// The direction a word names: 1 north, 2 south, 3 east, 4 west, 0 none.
sub direction(w: string[]): u8
    if equal(w, "n")
        return 1
    elseif equal(w, "s")
        return 2
    elseif equal(w, "e")
        return 3
    elseif equal(w, "w")
        return 4
    end
    return 0
end

sub walk(d: u8)
    var x = playerX
    var y = playerY
    if d = 1 and y > 0
        y = y - 1
    elseif d = 2 and y < height - 1
        y = y + 1
    elseif d = 3 and x < width - 1
        x = x + 1
    elseif d = 4 and x > 0
        x = x - 1
    end
    if not bugAt(x, y)
        playerX = x
        playerY = y
    end
end

sub main() fails IoError
    var line: string[40]
    var verb: string[8]
    var noun: string[8]
    var code: IoError
    var turn: u16 = 0
    try writeLine(console, "BUGS: zap 8 bugs before one reaches you.")
    while true
        if turn mod 2 = 0
            spawn()
        end
        try draw()
        prompt("> ", var line) handle code
            if code = IoError.endOfInput
                return
            end
            fail code
        end
        toLower(var line)
        var hasVerb = try word(line, 0, var verb)
        var hasNoun = try word(line, 1, var noun)
        if equal(verb, "zap") or equal(verb, "z")
            var d = direction(noun)
            var hit = false
            if d = 1
                hit = zap(0, -1)
            elseif d = 2
                hit = zap(0, 1)
            elseif d = 3
                hit = zap(1, 0)
            elseif d = 4
                hit = zap(-1, 0)
            end
            if hit
                zapped = zapped + 1
                try writeLine(console, "Zap!")
            else
                try writeLine(console, "Missed.")
            end
        elseif equal(verb, "quit") or equal(verb, "q")
            return
        else
            walk(direction(verb))
        end
        if zapped = goal
            try writeLine(console, "The cave is safe. You win!")
            return
        end
        if crawl()
            try draw()
            try writeLine(console, "A bug got you!")
            return
        end
        turn = turn + 1
    end
end
