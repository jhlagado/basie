// 32-bit arithmetic through the runtime helpers: wrapping, division, shifts, comparison.
// spec: 9.8, 9.10, 9.11
// expect output: 4294967295 -2147483648 3000000000 -7 1 2 T\r\n

include "FORMAT.BSQ"

sub main() fails
    var line as string[60]
    var a as u32 = 0
    var b as i32 = 2147483647
    var c as u32 = 100000
    var d as i32 = -21
    a = a - 1
    b = b + 1
    appendU32(line, a) else fail
    appendByte(line, ' ') else fail
    appendI32(line, b) else fail
    appendByte(line, ' ') else fail
    appendU32(line, c * 30000) else fail
    appendByte(line, ' ') else fail
    appendI32(line, d / 3) else fail
    appendByte(line, ' ') else fail
    appendI32(line, (d shr 1) and 1) else fail
    appendByte(line, ' ') else fail
    appendU32(line, c shr 16 + 1) else fail
    appendByte(line, ' ') else fail
    if c * 30000 > c
        appendByte(line, 'T') else fail
    end
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
