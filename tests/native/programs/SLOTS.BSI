// Slot-holders: a global, a field, an element and a parameter's place.
forward pool nodes

record Node
    value as u8
    next as nodes?
end

record Box
    tag as u8
    head as nodes?
    more as nodes?[2]
end

pool nodes as Node[8]

var list as nodes?
var box as Box
var i as u8

sub push(var l as nodes?, v as u8)
    var n = new nodes(v, move l)
    l = move n
end

sub drop(var l as nodes?)
    l = none
end

sub twice(var l as nodes?, v as u8)
    push(l, v)
    push(l, v + 1)
end

sub show(var l as nodes?) fails
    select l
    case some(n)
        writeByte(console, n.value) else fail
        select n.next
        case some(m)
            writeByte(console, m.value) else fail
        case none
        end
    case none
    end
end

sub main() fails
    var mine as nodes?
    push(list, 'A')
    push(box.head, 'B')
    push(box.more[1], 'C')
    i = 0
    push(box.more[i], 'D')
    push(mine, 'E')
    twice(mine, 'F')
    show(list) else fail
    show(box.head) else fail
    show(box.more[0]) else fail
    show(box.more[1]) else fail
    show(mine) else fail
    drop(mine)
    show(mine) else fail
    writeText(console, "\r\n") else fail
end
