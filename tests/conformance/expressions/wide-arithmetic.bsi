// 32-bit arithmetic through the runtime helpers: wrapping, division, shifts, comparison.
// spec: 9.8, 9.10, 9.11
// expect output: 4294967295 -2147483648 3000000000 -7 1 2 T\r\n

include "FORMAT.BSI"

sub main() fails IoError
    var line: string[60]
    var a: u32 = 0
    var b: i32 = 2147483647
    var c: u32 = 100000
    var d: i32 = -21
    a = a - 1
    b = b + 1
    try appendU32(var line, a)
    try appendByte(var line, ' ')
    try appendI32(var line, b)
    try appendByte(var line, ' ')
    try appendU32(var line, c * 30000)
    try appendByte(var line, ' ')
    try appendI32(var line, d / 3)
    try appendByte(var line, ' ')
    try appendI32(var line, (d shr 1) and 1)
    try appendByte(var line, ' ')
    try appendU32(var line, c shr 16 + 1)
    try appendByte(var line, ' ')
    if c * 30000 > c
        try appendByte(var line, 'T')
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
