// id() of a record nested inside a leased node is none, not the node (2.4).
// spec: 7.14
// expect output: none\r\n

forward pool nodes
forward pool subs

record Sub
    x: u16
end

record Node
    value: u16
    inner: Sub
    next: nodes?
end

pool nodes: Node[8]
pool subs: Sub[8]

sub poke(var s: Sub) fails
    var i = id(s)
    select i
    case some(j)
        try writeText(console, "some\r\n")
    case none
        try writeText(console, "none\r\n")
    end
end

sub bump(var n: Node) fails
    try poke(n.inner)
end

sub main() fails
    var h = new nodes(1)
    try bump(h)
end
