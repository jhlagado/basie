// Owning handle parameters and results: results returned through LINK0,
// owning values passed to a statement's call, parameters moved, leased
// and freed at every return, fail and the end.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var g: u8
sub make(v: u8): nodes
    return new nodes(v, none)
end
sub maybe(v: u8): nodes?
    if v = 0
        return none
    end
    var n = new nodes(v, none)
    return move n
end
sub keep(n: nodes)
    head = move n
end
sub drop(n: nodes?, k: u8)
    g = k
end
sub look(n: nodes): u8
    return n.value
end
sub lease(n: nodes?) fails IoError
    select n
    case some(x)
        x.value = 3
        fail IoError.fileNotFound
    end
end
sub main() fails IoError
    var a = make(1)
    var b: nodes? = maybe(2)
    keep(move a)
    drop(move b, 3)
    drop(new nodes(4, none), 5)
    drop(none, 6)
    keep(make(7))
    try lease(none)
end
