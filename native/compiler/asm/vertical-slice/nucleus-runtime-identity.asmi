; Canonical operating-layer runtime source, private ABI, link-rule, vector and
; helper-layout identity. The same identity may link to different resolved
; bytes when the validated target addresses differ.
NucleusRuntimeIdentity       .equ $0004
NucleusRuntimeExpectedLength .equ 364

NucleusRuntimeVectorCount  .equ 11
NucleusRuntimeVectorLength .equ NucleusRuntimeVectorCount*3
NucleusRuntimeStateLength  .equ 37
NucleusRuntimeRunStateOffset        .equ 0
NucleusRuntimeActivationLimitOffset .equ 7
; Banked targets use ScalarSlot as the selected-bank byte. The activation and
; far-return arenas retain caller-bank and return-address slots at depth-1.
; General source calls do not use the legacy scalar carrier in this mode.
NucleusRuntimeCurrentBankOffset     .equ 8

NucleusRuntimeActivationPushOffset      .equ 0
NucleusRuntimeActivationPopOffset       .equ 23
NucleusRuntimeActivationClaimOffset     .equ 43
NucleusRuntimeActivationReleaseOffset   .equ 68
NucleusRuntimeCheckArrayIndexOffset      .equ 77
NucleusRuntimeCheckStringLengthOffset    .equ 85
NucleusRuntimeCheckStringIndexOffset     .equ 95
NucleusRuntimeCheckAggregateRegionOffset .equ 115
NucleusRuntimeInitializeBssOffset        .equ 160
NucleusRuntimeMultiplyU8Offset           .equ 174
NucleusRuntimeMultiplyU16Offset          .equ 182
NucleusRuntimeDivideU16Offset            .equ 228
NucleusRuntimeModuloU16Offset            .equ 236
NucleusRuntimeCompareU16Offset           .equ 289
