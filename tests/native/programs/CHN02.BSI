include "CHN03.BSI"
// Part 2 of a chain of includes: each part includes the next, so all
// of them are open while the last loads.
var c2: u16
sub p2r0(): u16
    c2 = c2 + 0
    c2 = c2 + 1
    c2 = c2 + 2
    c2 = c2 + 3
    return c2
end
sub p2r1(): u16
    c2 = c2 + 1
    c2 = c2 + 2
    c2 = c2 + 3
    c2 = c2 + 4
    return c2
end
sub p2r2(): u16
    c2 = c2 + 2
    c2 = c2 + 3
    c2 = c2 + 4
    c2 = c2 + 5
    return c2
end
sub p2r3(): u16
    c2 = c2 + 3
    c2 = c2 + 4
    c2 = c2 + 5
    c2 = c2 + 6
    return c2
end
sub p2r4(): u16
    c2 = c2 + 4
    c2 = c2 + 5
    c2 = c2 + 6
    c2 = c2 + 7
    return c2
end
sub p2r5(): u16
    c2 = c2 + 5
    c2 = c2 + 6
    c2 = c2 + 7
    c2 = c2 + 8
    return c2
end
sub p2r6(): u16
    c2 = c2 + 6
    c2 = c2 + 7
    c2 = c2 + 8
    c2 = c2 + 9
    return c2
end
sub p2r7(): u16
    c2 = c2 + 7
    c2 = c2 + 8
    c2 = c2 + 9
    c2 = c2 + 10
    return c2
end
