private const scale = 3

forward sub later(n as u8) as u16

sub firstA(n as u8) as u16
    return later(n) * scale
end

sub showA() fails
    writeText(console, "A: the first part, ") else fail
    writeText(console, "dropped and loaded again\r\n") else fail
end
