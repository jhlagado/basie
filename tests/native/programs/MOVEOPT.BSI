// An optional owner moved leaves none, which select tests.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var g: u8
var c: boolean
sub main()
    var a: nodes? = new nodes(1, none)
    head = move a
    select a
    case some(x)
        g = 1
    end
end
