// xor works on booleans and on integers.
// spec: 9.12
// expect output: T15\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[8]
    var a: boolean = true
    var m: u8 = $F0
    if a xor false
        try appendByte(line, 'T')
    end
    try appendU16(line, m xor $FF)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
