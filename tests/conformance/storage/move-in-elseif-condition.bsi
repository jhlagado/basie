// A move in an elseif condition reaches the else body (review finding C2).
// spec: 10.8, 11.4.1, 12.5.1
// expect error: use-after-move at 20:32

forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[4]
sub eat(n: nodes): u8
    return 1
end
sub main() fails
    var x = new nodes(65, none)
    var b: boolean = false
    if b
    elseif eat(move x) = 2
    else
        try writeByte(console, x.value)
        x.value = 99
        try writeByte(console, x.value)
    end
    try writeText(console, "\r\n")
end
