// Basie standard library: numbers to text (D36; standard library section 3).
include "STRINGS.BSI"

sub appendU16(var s: string[], v: u16) fails IoError
    var digits: u8[5]
    var count: u8 = 0
    var n: u16 = v
    while true
        digits[count] = u8(n mod 10) + '0'
        count = count + 1
        n = n / 10
        if n = 0
            exit
        end
    end
    while count > 0
        count = count - 1
        try appendByte(var s, digits[count])
    end
end

sub appendI16(var s: string[], v: i16) fails IoError
    if v < 0
        try appendByte(var s, '-')
        // not v is -v - 1, so this is -v without overflow at -32768.
        try appendU16(var s, u16(not v) + 1)
    else
        try appendU16(var s, u16(v))
    end
end

sub appendU32(var s: string[], v: u32) fails IoError
    var digits: u8[10]
    var count: u8 = 0
    var n: u32 = v
    while true
        digits[count] = u8(n mod 10) + '0'
        count = count + 1
        n = n / 10
        if n = 0
            exit
        end
    end
    while count > 0
        count = count - 1
        try appendByte(var s, digits[count])
    end
end

sub appendI32(var s: string[], v: i32) fails IoError
    if v < 0
        try appendByte(var s, '-')
        try appendU32(var s, u32(not v) + 1)
    else
        try appendU32(var s, u32(v))
    end
end

// x with the given number of decimal places, rounded to the nearest unit of
// the last place. The scaled value must fit a u32.
sub appendF32(var s: string[], x: f32, places: u8) fails IoError
    var v: f32 = x
    if v < 0.0
        try appendByte(var s, '-')
        v = -v
    end
    var scale: u32 = 1
    var i: u8 = 0
    while i < places
        scale = scale * 10
        i = i + 1
    end
    var n: u32 = u32(v * f32(scale) + 0.5)
    try appendU32(var s, n / scale)
    if places > 0
        try appendByte(var s, '.')
        var frac: u32 = n mod scale
        var div: u32 = scale / 10
        while div > 0
            try appendByte(var s, u8(frac / div mod 10) + '0')
            div = div / 10
        end
    end
end

private sub hexDigit(v: u8): u8
    if v < 10
        return v + '0'
    end
    return v - 10 + 'A'
end

// Two upper-case hexadecimal digits.
sub appendHex8(var s: string[], v: u8) fails IoError
    try appendByte(var s, hexDigit(v shr 4))
    try appendByte(var s, hexDigit(v and 15))
end

// Four upper-case hexadecimal digits.
sub appendHex16(var s: string[], v: u16) fails IoError
    try appendHex8(var s, u8(v shr 8))
    try appendHex8(var s, u8(v and 255))
end

// Append the name of a service failure, such as fileNotFound (D54).
sub appendIoError(var s: string[], e: IoError) fails IoError
    select e
    case IoError.endOfInput
        try append(var s, "endOfInput")
    case IoError.inputFailure
        try append(var s, "inputFailure")
    case IoError.outputFailure
        try append(var s, "outputFailure")
    case IoError.storageFailure
        try append(var s, "storageFailure")
    case IoError.fileNotFound
        try append(var s, "fileNotFound")
    case IoError.fileExists
        try append(var s, "fileExists")
    case IoError.badName
        try append(var s, "badName")
    case IoError.tooManyFiles
        try append(var s, "tooManyFiles")
    case IoError.fileClosed
        try append(var s, "fileClosed")
    case IoError.diskFull
        try append(var s, "diskFull")
    case IoError.directoryFull
        try append(var s, "directoryFull")
    case IoError.readOnly
        try append(var s, "readOnly")
    case IoError.seekFailure
        try append(var s, "seekFailure")
    case IoError.lineTooLong
        try append(var s, "lineTooLong")
    case IoError.notAvailable
        try append(var s, "notAvailable")
    case IoError.fileBusy
        try append(var s, "fileBusy")
    case IoError.noSearch
        try append(var s, "noSearch")
    case IoError.badMode
        try append(var s, "badMode")
    case IoError.invalid
        try append(var s, "invalid")
    end
end
