// Locals whose types are inferred from their initializers (D21; step 67):
// a character literal alone is a u8, a typed constant gives its type, an
// aggregate variable, constant or routine result is copied, and a scalar
// a path selects begins an expression that goes on.
record point
    x: u8
    y: u16
end
const origin: point = (1, 2)
const delta: u16 = 40
var where: point
var row: u8[4] = [1, 2, 3, 4]
var name: string[6] = "abc"
var out: u16

sub make(n: u8): point
    where.x = n
    return where
end

sub maybe(n: u8): point fails
    if n = 0
        fail 9
    end
    return where
end

sub main() fails
    var c = 'A'
    var d = ('B')
    var e = +'C'
    var s = delta
    var p = origin
    var q = where
    var r = make(3)
    var t = maybe(4) else fail
    var x = where.x + 1
    var y = row[2] * 2 + c
    var z = name.length
    var w = make(5).y - s
    var v = r.x
    out = c + d + e + s + p.y + q.x + r.x + t.y + x + y + z + w + v
end
