// 8-bit arithmetic in every operand position (65.4 c).
var a as u8 = 200
var b as u8 = 9
var c as u8

sub main()
    c = a + b
    c = a - b
    c = a * b
    c = a / b
    c = a mod b
    c = a and b
    c = a or b
    c = a xor b
    c = a + 1
    c = a - 2
    c = a * 3
    c = a / 4
    c = a mod 5
    c = a and 15
    c = a or 16
    c = a xor 255
    c = 1 + a
    c = 2 - a
    c = 3 * a
    c = 40 / a
    c = 50 mod a
    c = 15 and a
    c = 16 or a
    c = 255 xor a
    c = (a + b) * (a - b)
    c = a + b * c - a / b
    c = 'A' + a
end
