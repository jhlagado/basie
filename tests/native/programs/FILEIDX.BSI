// File elements at computed places (74): stored and loaded through their
// addresses as a long is.
var outs: File[3]
sub pick(i: u8): File
    return outs[i]
end
sub main() fails
    var i: u8
    for i = 0 to 2
        outs[i] = console
    end
    i = 1
    try writeText(outs[i], "computed\r\n")
    outs[i + 1] = pick(i)
    if outs[2] <> console
        fail 1
    end
end
