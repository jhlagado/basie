// Records, arrays and strings may be locals, zeroed unless initialized.
// spec: 7.6
// expect output: 09\r\n

include "FORMAT.BSQ"

sub main() fails
    var line as string[20]
    var grid as u8[3][4]
    grid[2][3] = 9
    appendU16(line, grid[0][0]) else fail
    appendU16(line, grid[2][3]) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
