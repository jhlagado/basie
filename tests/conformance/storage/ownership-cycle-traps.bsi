// Storing a node into its own descendant traps.
// spec: 7.15, 15.2
// expect trap: ownership-cycle at 32

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

var head: nodes?

sub main()
    head = new nodes(1, new nodes(2, none))
    var top: id nodes? = none
    var child: id nodes? = none
    select head
    case some(h)
        top = h
        select h.next
        case some(c)
            child = c
        case none
        end
    case none
    end
    select child
    case some(c)
        c.next = move head
    case none
    end
end
