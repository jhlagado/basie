// f32 constants (67f): literals rounded to nearest, ties to even; folding
// as Math.fround folds, with results below the smallest normal flushed to
// +0 and the one value that rounds up to it kept; integers adopting f32
// exactly; conversions rounded or truncated; -0.0 kept where the reference
// keeps it, an integer zero +0.0.
const third: f32 = 1.0 / 3.0
const back: f32 = third * 3.0 - 1.0
const negzero: f32 = -0.0
const intzero: f32 = -0
const bigsum: f32 = 16777216.0 + 1.0
const largest: f32 = 3.4028234e38
const tiny: f32 = 1.17549435e-38
const halved: f32 = tiny * 0.5
const kept: f32 = tiny / 1.0000001
const whole: f32 = 100
const rounded: f32 = f32(16777217)
const negated: f32 = -(2.5)
const exponent: f32 = 6.02e23
const fraction: f32 = 0.000001
const long: f32 = 123456789012345678901234567890.0
const ties: f32 = 16777218.0 + 1.0
const scaled: f32 = 2.5e-3 * 4e3
const unsigned: f32 = f32(4294967295)
const signed: f32 = f32(-2147483648)
var lt: boolean = third < back
var eq: boolean = negzero = 0.0
var mixed: boolean = 1.5 > 1
var trunc: i32 = i32(-2.75)
var high: u8 = u8(255.9)
var low: i16 = i16(-32768.5)
var table: f32[5] = [1.0, 2, -3.5e-3, 1e10, intzero]

record point
x: f32
y: f32
end

var origin: point = (0.0, -1.5)

sub main()
    const k: u16 = 40000
    var w: f32 = k
    var u: f32 = whole + k * 2.0
    var v = 0.25
    v = v + third
    w = w / largest
end
