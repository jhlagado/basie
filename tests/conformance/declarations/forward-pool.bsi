// A forward pool lets a record name its own pool.
// spec: 8.11
// expect output: X\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

sub main() fails IoError
    var n = new nodes('X', none)
    try writeByte(console, n.value)
    try writeText(console, "\r\n")
end
