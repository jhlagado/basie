// select move takes the value out; some(n) owns it for the arm.
// spec: 11.7.3
// expect output: A-\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]
var head: nodes?

sub bumpOut() fails
    select move head
    case some(n)
        try writeByte(console, n.value)
    case none
        try writeByte(console, '?')
    end
end

sub main() fails
    head = new nodes('A', none)
    try bumpOut()
    select head
    case some(i)
        try writeByte(console, i.value)
    case none
        try writeByte(console, '-')
    end
    try writeText(console, "\r\n")
end
