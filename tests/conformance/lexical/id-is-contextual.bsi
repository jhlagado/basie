// `id` is an ordinary name outside handle types, so it can name a field.
// spec: 3.5
// expect output: 7\r\n

include "FORMAT.BSI"

record Part
    id: u16
end

var part: Part

sub main() fails
    var line: string[8]
    part.id = 7
    appendU16(line, part.id) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
