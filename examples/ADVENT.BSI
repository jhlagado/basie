// ADVENT: a small text adventure.
//
// Find the gold and bring it back to the cellar. Commands are a verb and
// sometimes a noun: LOOK, NORTH (or N), SOUTH, EAST, WEST, TAKE thing,
// DROP thing, INVENTORY (or I), HELP and QUIT.

include "TEXTIO.BSI"

const cellar = 0
const hall = 1
const library = 2
const passage = 3
const vault = 4
const blocked = 255

// Where an item is: a room number, or carried.
const carried = 254

record Room
    name: string[16]
    text: string[80]
    north: u8
    south: u8
    east: u8
    west: u8
end

const rooms: Room[5] = [
    ("Cellar", "A damp cellar. Stone steps lead up to the north.", hall, blocked, blocked, blocked),
    ("Hall", "A dusty hall. Doors open east and west; the cellar is south.", blocked, cellar, passage, library),
    ("Library", "Shelves of rotting books. The only way out is east.", blocked, blocked, hall, blocked),
    ("Passage", "A narrow passage. An iron door stands to the east.", blocked, blocked, vault, hall),
    ("Vault", "A small vault, empty but for what you see.", blocked, blocked, blocked, passage)
]

record Item
    name: string[8]
    place: u8
end

var items: Item[3] = [("lamp", hall), ("key", library), ("gold", vault)]

var here: u8 = cellar

sub say(text: string[]) fails
    try writeLine(console, text)
end

// The item named, or 255.
sub itemNamed(noun: string[]): u8
    var i: u8 = 0
    while i < 3
        if equal(items[i].name, noun)
            return i
        end
        i = i + 1
    end
    return 255
end

sub carrying(name: string[]): boolean
    var i = itemNamed(name)
    return i <> 255 and items[i].place = carried
end

sub look() fails
    if here = passage and not carrying("lamp")
        try say("It is too dark to see.")
        return
    end
    try say(rooms[here].name)
    try say(rooms[here].text)
    var i: u8 = 0
    while i < 3
        if items[i].place = here
            var line: string[40]
            try append(line, "There is a ")
            try append(line, items[i].name)
            try append(line, " here.")
            try say(line)
        end
        i = i + 1
    end
end

sub go(way: u8) fails
    if way = blocked
        try say("You can't go that way.")
        return
    end
    if way = vault and not carrying("key")
        try say("The iron door is locked.")
        return
    end
    here = way
    try look()
end

sub take(noun: string[]) fails
    var i = itemNamed(noun)
    if i = 255 or items[i].place <> here
        try say("You don't see that here.")
        return
    end
    items[i].place = carried
    try say("Taken.")
end

sub drop(noun: string[]) fails
    var i = itemNamed(noun)
    if i = 255 or items[i].place <> carried
        try say("You aren't carrying that.")
        return
    end
    items[i].place = here
    try say("Dropped.")
end

sub inventory() fails
    var empty = true
    var i: u8 = 0
    while i < 3
        if items[i].place = carried
            var line: string[20]
            try append(line, "  ")
            try append(line, items[i].name)
            try say(line)
            empty = false
        end
        i = i + 1
    end
    if empty
        try say("You are empty-handed.")
    end
end

sub main() fails
    var line: string[60]
    var verb: string[12]
    var noun: string[12]
    var code: u8 = 0
    try say("ADVENT: bring the gold back to the cellar.")
    try look()
    while true
        prompt("> ", line) handle code
            if code = endOfInput
                return
            end
            fail code
        end
        toLower(line)
        var hasVerb = try word(line, 0, verb)
        var hasNoun = try word(line, 1, noun)
        if not hasVerb
            continue
        end
        if equal(verb, "look") or equal(verb, "l")
            try look()
        elseif equal(verb, "north") or equal(verb, "n")
            try go(rooms[here].north)
        elseif equal(verb, "south") or equal(verb, "s")
            try go(rooms[here].south)
        elseif equal(verb, "east") or equal(verb, "e")
            try go(rooms[here].east)
        elseif equal(verb, "west") or equal(verb, "w")
            try go(rooms[here].west)
        elseif equal(verb, "take") or equal(verb, "get")
            try take(noun)
        elseif equal(verb, "drop")
            try drop(noun)
        elseif equal(verb, "inventory") or equal(verb, "i")
            try inventory()
        elseif equal(verb, "help")
            try say("Try LOOK, N, S, E, W, TAKE, DROP, I and QUIT.")
        elseif equal(verb, "quit") or equal(verb, "q")
            try say("Goodbye.")
            return
        else
            try say("I don't understand that.")
        end
        if items[2].place = cellar
            try say("The gold is safe in the cellar. You win!")
            return
        end
    end
end
