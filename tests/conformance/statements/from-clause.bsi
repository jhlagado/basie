// A from clause lets a result be rooted in a parameter.
// spec: 13.6
// expect output: K\r\n

record Entry
    value: u8
end

sub pick(items: Entry[4], index: u8): Entry from items
    return items[index]
end

sub main() fails IoError
    var list: Entry[4]
    list[2].value = 'K'
    try writeByte(console, pick(list, 2).value)
    try writeText(console, "\r\n")
end
