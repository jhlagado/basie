// Names are CP/M names; anything else is badName, including reserved $ types.
// spec: 16; services 4.1
// expect output: badName badName badName badName\r\n

include "FORMAT.BSI"

sub attempt(name: string[]): IoError
    var code: IoError
    var f: File
    f = openRead(name, textMode) handle code
    end
    return code
end

sub main() fails IoError
    var line: string[64]
    try appendIoError(var line, attempt("TOOLONGNAME.TXT"))
    try appendByte(var line, ' ')
    try appendIoError(var line, attempt("A B.TXT"))
    try appendByte(var line, ' ')
    try appendIoError(var line, attempt("X.$01"))
    try appendByte(var line, ' ')
    try appendIoError(var line, attempt(""))
    try writeText(console, line)
    try writeText(console, "\r\n")
end
