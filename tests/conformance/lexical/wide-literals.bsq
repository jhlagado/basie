// Integer literals cover the u32 range; hexadecimal takes up to eight digits.
// spec: 3.6
// expect output: 4294967295 65536\r\n

include "FORMAT.BSQ"

sub main() fails
    var line as string[40]
    var top as u32 = $FFFFFFFF
    var next as u32 = 65536
    appendU32(line, top) else fail
    appendByte(line, ' ') else fail
    appendU32(line, next) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
