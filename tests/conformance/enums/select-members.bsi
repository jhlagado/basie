// An enum select without case else names every member, and then needs no
// return after it (D51).
// spec: 11.7.2
// expect output: NE\r\n

enum Dir
    north
    east
end

sub letter(d: Dir): u8
    select d
    case Dir.north
        return 'N'
    case Dir.east
        return 'E'
    end
end

sub main() fails IoError
    try writeByte(console, letter(Dir.north))
    try writeByte(console, letter(Dir.east))
    try writeText(console, "\r\n")
end
