// f32 runs (67f): each result is checked, folded and computed alike, and
// the narrowing at the end traps only when every one is right.
var check: u16
var out: u8

sub cube(x: f32): f32
    return x * x * x
end

sub main()
    var a: f32 = 1.5
    var b: f32 = 0.1
    var n: i16 = -7
    var t: f32 = 0.0
    var i: u8
    if cube(a) <> 3.375
        check = check + 1
    end
    for i = 1 to 10
        t = t + b
    end
    if t = 1.0 or t < 0.99999 or t > 1.00001
        check = check + 1
    end
    if i16(f32(n) * a) <> -10 or u8(a * a * 4.0) <> 9
        check = check + 1
    end
    if -a >= a or not (b < a) or a / 0.5 <> 3.0
        check = check + 1
    end
    if f32(65535) + 1 <> 65536.0 or f32(u32(4000000000)) <> 4e9
        check = check + 1
    end
    t = 3.0
    if i32(-t / 2.0) <> -1 or i32(t * -1e5) <> -300000
        check = check + 1
    end
    out = u8(256 - check)
end
