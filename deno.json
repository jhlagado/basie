{
  "tasks": {
    "check": "deno fmt --check tests tools ref && deno lint tests tools ref",
    "test": "deno test --config deno.runtime.json --allow-read=.,../atom tests/",
    "fmt": "deno fmt tests tools ref",
    "lint": "deno lint tests tools ref"
  },
  "fmt": {
    "exclude": [
      "**/*.md"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  }
}
