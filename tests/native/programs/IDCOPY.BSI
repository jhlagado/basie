// Fields reached through an identifier pass to value parameters as copies:
// a record, a string to an open string and an array to an open array.
forward pool boxes

record Inner
    w: u16
    c: u8
end

record Box
    inner: Inner
    name: string[8]
    bytes: u8[3]
end

pool boxes: Box[2]

var keep: id boxes?

sub look(x: Inner, s: string[], b: u8[]) fails
    try writeByte(console, x.c)
    try writeByte(console, s[0])
    try writeByte(console, b[2])
end

sub main() fails
    var h = new boxes()
    keep = id(h)
    select keep
    case some(j)
        j.inner.c = 'I'
        j.name = "Name"
        j.bytes[2] = 'Z'
        try look(j.inner, j.name, j.bytes)
    case none
    end
    try writeText(console, "\r\n")
end
