// f32 at run time (67f): variables, locals, parameters, results, fields
// and elements in DEHL; the operators through FADD, FSUB, FMUL, FDIV and
// FCMP, a constant left loaded after the right; negation by the sign bit;
// conversions from every integer type through I2F and U2F and to each
// through F2I and F2U, then narrowed.
record sample
v: f32
n: u8
end

var s: sample
var series: f32[8]
var total: f32

sub mean(values: f32[], count: u8): f32
    var sum: f32 = 0.0
    var i: u8
    for i = 0 until count
        sum = sum + values[i]
    end
    return sum / f32(count)
end

sub scale(x: f32, by: i16): f32
    return x * by - 1 / x
end

sub main()
    var a: f32 = 2.5
    var b: f32 = -a
    var c: u8 = 7
    var d: i8 = -3
    var e: u16 = 60000
    var f: i16 = -30000
    var g: u32 = 4000000000
    var h: i32 = -2000000000
    var far: u8[140]
    var z: f32
    series[1] = a * b
    series[c and 7] = a / 3.0 - b
    s.v = 1.0 - a
    total = mean(series, 8) + scale(s.v, f)
    z = a + c + d + e + f
    z = f32(g) + f32(h) - 0.5
    z = 2.0 - z
    z = 10 / z
    if z < a or z >= b and a <> b
        z = -z
    end
    if 1.5 > z and z <= total and z = 3.0
        z = z * 0.5
    end
    c = u8(a * 10.0)
    d = i8(b)
    e = u16(a + 1000)
    f = i16(b * 100.0)
    g = u32(a * 1e9)
    h = i32(b * 1e9)
    far[139] = u8(z)
end
