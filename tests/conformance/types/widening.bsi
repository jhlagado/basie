// Implicit widening only where no value is lost.
// spec: 6.4
// expect output: 200 -3 200\r\n

include "FORMAT.BSI"

sub main() fails IoError
    var small: u8 = 200
    var wide: u16 = small
    var delta: i8 = -3
    var signed: i16 = delta
    var both: i16 = small
    var line: string[40]
    try appendU16(var line, wide)
    try appendByte(var line, ' ')
    try appendI16(var line, signed)
    try appendByte(var line, ' ')
    try appendI16(var line, both)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
