// Identifiers: id() of an owning local, none, an identifier copied, stored
// in a local, a program variable and a field, written and read through,
// and selected on.
forward pool nodes
record Node
    value: u8
    next: nodes?
    peer: id nodes?
end
pool nodes: Node[8]
var keep: id nodes?
var g: u8
sub main()
    var n = new nodes(1, none, none)
    var i = id(n)
    var j: id nodes? = none
    var k: id nodes? = id(n)
    j = i
    keep = id(n)
    n.peer = j
    i.value = 7
    g = i.value
    select k
    case some(x)
        x.peer = id(n)
        g = x.value
    case none
    end
    var m = i
end
