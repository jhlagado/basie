// An integer zero becomes the f32 0.0, however it was computed: integers
// have no negative zero, so a negated zero or a zero times a negative
// number adopts f32 as +0.0, while an f32's own -0.0 stays a value.
// spec: 6.4, 9.6
// expect output: 0.00 0.00 0.00 0.00\r\n

include "FORMAT.BSI"

const minus: i16 = -0
var a: f32 = -0
var b: f32 = 0 * -5
var c: f32 = f32(-0)

sub main() fails
    var line: string[24]
    var d: f32 = minus
    try appendF32(line, a, 2)
    try appendByte(line, ' ')
    try appendF32(line, b, 2)
    try appendByte(line, ' ')
    try appendF32(line, c, 2)
    try appendByte(line, ' ')
    try appendF32(line, d, 2)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
