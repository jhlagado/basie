// Floating-point literals need a digit on both sides of the point, or an
// exponent, and have type f32.
// spec: 3.6
// expect output: 1.50 0.25 1000.00 0.00\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    appendF32(line, 1.5, 2) else fail
    appendByte(line, ' ') else fail
    appendF32(line, 0.25, 2) else fail
    appendByte(line, ' ') else fail
    appendF32(line, 1e3, 2) else fail
    appendByte(line, ' ') else fail
    appendF32(line, 2.5e-3, 2) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
