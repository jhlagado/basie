// select move of a program variable binds an owner in its some arm.
forward pool nodes
record Node
    value as u8
    next as nodes?
end
pool nodes as Node[8]
var head as nodes?
var g as u8
var c as boolean
sub main()
    head = new nodes(1, none)
    select move head
    case some(x)
        g = x.value
    case none
    end
    select head
    case some(y)
        g = 2
    end
end
