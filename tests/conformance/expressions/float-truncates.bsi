// Converting f32 to an integer truncates toward zero.
// spec: 9.6
// expect output: -2\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[12]
    var x: f32 = -2.75
    appendI16(line, i16(x)) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
