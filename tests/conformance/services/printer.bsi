// The printer accepts writeByte and writeText (BDOS 5); reading it is notAvailable.
// spec: 16; services 3.4
// expect output: \x00LH\x00Li15\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[8]
    var code: u8 = 0
    try writeText(printer, "Hi")
    var b: u8
    b = readByte(printer) handle code
    end
    try appendU16(var line, code)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
