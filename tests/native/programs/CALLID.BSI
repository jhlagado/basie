// Identifiers read from a call's aggregate result (74): its path parsed
// from the result's address, the identifier's four bytes loaded.
forward pool nodes
record Node
    v: u16
    next: nodes?
end
pool nodes: Node[4]
record Holder
    head: nodes?
    ref: id nodes?
    n: u16
end
var hold: Holder
var keep: id nodes?
var all: Holder[2]
sub get(): Holder
    return hold
end
sub row(): Holder[2]
    return all
end
sub use(i: id nodes?): u8
    select i
    case some(n)
        return 1
    case none
        return 0
    end
end
sub main() fails
    var n = new nodes(5, none)
    hold.ref = id(n)
    var p: id nodes? = get().ref
    keep = get().ref
    var k: u8 = use(get().ref) + use(row()[1].ref)
    if p = keep and k = 1
        writeText(console, "identifiers from calls\r\n") else fail
    end
end
