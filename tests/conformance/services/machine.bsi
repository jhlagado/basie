// Machine services: the current drive and user, and free memory.
// spec: 16; services 6
// expect output: 0 0 T\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[20]
    appendU16(line, currentDrive()) else fail
    appendByte(line, ' ') else fail
    appendU16(line, currentUser()) else fail
    appendByte(line, ' ') else fail
    if freeMemory() > 1000
        appendByte(line, 'T') else fail
    end
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
