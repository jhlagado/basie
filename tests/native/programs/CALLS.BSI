// Calls with parameters of each scalar type and results in A and HL:
// arguments pushed left to right, widened to words, constants loaded at
// the parameter's type, calls nested in arguments and in expressions, and
// RETN removing the arguments (65.4 e).
var total: u16 = 10
var small: u8 = 3
var flag: boolean

sub note()
    total = total + 1
end

sub twice(n: u16): u16
    return n + n
end

sub low(n: u16): u8
    return u8(n mod 256)
end

sub gate(c: boolean)
    flag = c and flag
end

sub both(a: u8, b: u16, c: boolean): u16
    var sum: u16 = b + a
    gate(c)
    return sum
end

sub pick(a: boolean, b: boolean): boolean
    return a or b
end

sub set(n: u8)
    n = n + 1
    small = n
end

sub main()
    var a: u16 = twice(total)
    var b: u8 = low(a + 300)
    note()
    a = twice(twice(a)) + both(b, a, true)
    b = low(twice(small)) + low(7)
    flag = pick(a > 9, flag) and pick(false, b = 0)
    set(b)
    set(250)
    total = both(small, 12, flag) - twice(a / 3)
end
