// new allocates; select on an optional handle tests it.
// spec: 7.10, 11.7.3
// expect output: H\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

var head: nodes?

sub main() fails IoError
    head = new nodes('H', none)
    select head
    case some(i)
        try writeByte(console, i.value)
    case none
        try writeByte(console, '-')
    end
    try writeText(console, "\r\n")
end
