// Floating-point literals need a digit on both sides of the point, or an
// exponent, and have type f32.
// spec: 3.6
// expect output: 1.50 0.25 1000.00 0.00\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    try appendF32(var line, 1.5, 2)
    try appendByte(var line, ' ')
    try appendF32(var line, 0.25, 2)
    try appendByte(var line, ' ')
    try appendF32(var line, 1e3, 2)
    try appendByte(var line, ' ')
    try appendF32(var line, 2.5e-3, 2)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
