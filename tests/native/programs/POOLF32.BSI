// The FLOAT and OWNERS overlays share the area above NAMES: an f32
// constant, an owner descriptor, then f32 constants again, each overlay
// loaded again when it is next needed.
const half: f32 = 0.5
forward pool p
record R
    h: p?
    x: f32
end
pool p: R[2]
var y: f32 = 2.25
sub main()
    var z: f32 = half * 3.0
    y = z + 1.5
end
