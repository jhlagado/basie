// Integer literals cover the u32 range; hexadecimal takes up to eight digits.
// spec: 3.6
// expect output: 4294967295 65536\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    var top: u32 = $FFFFFFFF
    var next: u32 = 65536
    try appendU32(line, top)
    try appendByte(line, ' ')
    try appendU32(line, next)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
