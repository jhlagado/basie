// Parts are compiled once, each before the parts that include it, in
// depth-first order, so a part included twice is compiled once; its
// public names are visible to every later part (4.3.2).
// spec: 4.3.2
// expect output: 5\r\n

include "TWICEA.BSI"
include "TWICEB.BSI"

sub main() fails IoError
    try writeByte(console, '0' + fromA() + fromB())
    try writeText(console, "\r\n")
end
