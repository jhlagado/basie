// A statement's call discards a handle result, which is freed (after
// else fail's jump, before a handler's), and an inferred local reads a
// field through an owning local.
forward pool nodes
record Node
    value as u8
    next as nodes?
end
pool nodes as Node[8]
var head as nodes?
var g as u8
var s as string[8]
sub make(v as u8) as nodes
    return new nodes(v, none)
end
sub nothing()
end
sub mk(v as u8) as nodes fails
    if v = 0
        fail 1
    end
    return new nodes(v, none)
end
sub main() fails
    make(1)
    mk(2) else fail
    var e as u8
    mk(3) handle e
        g = e
    end
    var a = new nodes(1, none)
    var y = a.value
end
