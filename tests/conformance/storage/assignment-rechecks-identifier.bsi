// The right side frees the slot an assignment target goes through: the
// identifier is checked again before the store (7.13; review finding B1).
// spec: 7.13, 10.4
// expect trap: stale-handle at 32
include "FORMAT.BSI"
record Box
    w: u16
    arr: u16[4]
end
pool boxes: Box[1]
var gb: boxes?
sub churn(): u16
    gb = none
    gb = new boxes()
    return 7
end
sub show() fails
    var line: string[20]
    select gb
    case some(j)
        appendU16(line, j.w) else fail
        appendByte(line, ' ') else fail
        appendU16(line, j.arr[2]) else fail
    case none
    end
    writeText(console, line) else fail
end
sub main() fails
    gb = new boxes()
    select gb
    case some(j)
        j.w = churn()
    case none
    end
    show() else fail
end
