// TEXTIO.BSI on the console: prompt, readSecret with backspace, words of a
// command line, and writeLine.
// spec: 16.4; standard library 5
// input: Ann\rpa\x08ss\r
// tail:   copy  A.TXT\tB.TXT
// expect output: Name? \n\r\n[Ann] [pss] 3 [COPY|A.TXT|B.TXT] F\r\n

include "TEXTIO.BSI"

sub main() fails
    var name: string[20]
    var secret: string[20]
    try prompt("Name? ", name)
    try readSecret(secret)
    var line: string[60]
    try append(line, "[")
    try append(line, name)
    try append(line, "] [")
    try append(line, secret)
    try append(line, "] ")
    var tail: string[60]
    commandTail(tail)
    var w: string[20]
    var n: u8 = 0
    var more = try word(tail, 0, w)
    while more
        n = n + 1
        more = try word(tail, n, w)
    end
    try appendByte(line, '0' + n)
    try append(line, " [")
    var i: u8 = 0
    while i < n
        if i > 0
            try appendByte(line, '|')
        end
        var got = try word(tail, i, w)
        try append(line, w)
        i = i + 1
    end
    try append(line, "] ")
    var small: string[2]
    var code: u8 = 0
    var found: boolean = false
    found = word(tail, 1, small) handle code
        if code = lineTooLong
            try appendByte(line, 'F')
        end
    end
    try writeLine(console, line)
end
