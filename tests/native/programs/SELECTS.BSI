// select on every integer type (67d): single labels, lists and ranges,
// the whole range of a byte and of a word, case else, empty arms; the
// subject a local, a parameter, a program variable, a field, an element,
// a string's character, a call's result, an expression in parentheses,
// a conversion and a typed constant; arms with their own locals; a
// select in a loop whose arms exit and continue; nested selects; a
// function whose arms all return; and a subject beyond IX-128.
record pair
    a: u8
    w: i16
end
var g: u16 = 300
var p: pair
var bytes: u8[4]
var s: string[6] = "hello"
var n: u32 = 70000
const tk: i8 = -2

sub code(c: u8): u8
    select c
    case 'a' to 'z'
        return 1
    case 'A' to 'Z', '_'
        return 2
    case '0' to '9'
        return 3
    case else
        return 0
    end
end

sub kind(v: i16): u8
    var r: u8
    select v
    case -32768 to -1
        r = 1
    case 0
    case 1, 2, 3
        var t: u8 = 4
        r = t + 1
    case 100 to 32767
        r = 9
    case else
    end
    return r
end

sub wide(v: u32, m: i32): u8
    select v
    case 0
        return 1
    case 1 to 65535
        select m
        case -2147483648 to -1
            return 2
        case else
            return 3
        end
    case 4000000000 to 4294967295
        return 4
    case else
    end
    return 5
end

sub all(b: u8, w: u16, sb: i8): u8
    var k: u8
    select b
    case 0 to 255
        k = 1
    end
    select w
    case 0 to 65535
        k = k + 1
    end
    select sb
    case -128 to 127
        k = k + 1
    end
    select w
    case 5 to 65535
        k = k + 1
    case else
    end
    return k
end

sub far()
    var big: u8[200]
    var i: u8
    select big[i]
    case 0
        big[1] = 1
    case 1 to 4
        big[2] = 2
    case else
    end
    select i
    case 7
        i = 8
    case else
    end
end

sub main()
    var i: u8
    var total: u16
    while i < 20
        i = i + 1
        select (i mod 4)
        case 0
            continue
        case 1, 2
            total = total + 1
        case 3
            if total > 10
                exit
            end
        case else
        end
    end
    for i = 1 to 9
        select i
        case 5
            exit
        case 2 to 3
            continue
        case else
        end
        total = total + i
    end
    select g
    case 300
        g = 1
    case else
    end
    select p.a
    case 1
        p.w = 2
    case else
    end
    select p.w
    case -5 to 5
        p.a = 3
    case else
    end
    select bytes[i and 3]
    case 9
        bytes[0] = 1
    case else
    end
    select s[1]
    case 'e'
        s[2] = 'x'
    case else
    end
    select n
    case 70000
        n = 1
    case else
    end
    select code('q')
    case 1
        g = 2
    case else
    end
    select (g + 1)
    case 3
        g = 4
    case else
    end
    select u16(i) * 2
    case 0 to 100
        g = 5
    case else
    end
    select tk
    case -2
        g = 6
    case else
    end
    select kind(-7)
    case 1
        g = 8
    case else
        g = 7
    end
    g = wide(70000, -1) + all(1, 2, 3)
    far()
end
