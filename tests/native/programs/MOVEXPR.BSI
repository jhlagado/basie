// Owning arguments to calls inside expressions: moves, new and none.
forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[8]

var g: u8

sub eat(n: nodes): u8
    return n.value
end

sub maybe(n: nodes?): u8
    select n
    case some(m)
        return m.value
    case none
    end
    return '-'
end

sub wrap(v: u8): nodes
    return new nodes(v, none)
end

sub total(): u8
    var a = new nodes(1, none)
    return eat(move a) + 1
end

sub main() fails
    var x = new nodes('A', none)
    g = eat(move x)
    writeByte(console, g) else fail
    var y = new nodes('B', none)
    if eat(move y) = 'B'
        writeByte(console, 'b') else fail
    end
    writeByte(console, eat(wrap('C'))) else fail
    writeByte(console, eat(new nodes('D', none)) + 1) else fail
    writeByte(console, maybe(none)) else fail
    var z: nodes? = new nodes('F', none)
    select maybe(move z)
    case 'F'
        writeByte(console, 'f') else fail
    case else
    end
    var w = new nodes(3, none)
    var i: u8
    for i = 1 to eat(move w)
        writeByte(console, '0' + i) else fail
    end
    writeByte(console, '0' + total()) else fail
    writeText(console, "\r\n") else fail
end
