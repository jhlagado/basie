// Declarations anywhere and block scope (D28; step 67): locals declared
// after statements and inside every kind of block, their frame slots
// released at the block's end and taken again by the next block, the
// same name in sibling blocks with different types, and blocks nested
// in loops and handlers.
var total: u16
var flag: boolean = true
record pair
    a: u8
    b: u16
end

sub work(n: u8): u8 fails
    if n > 200
        fail n
    end
    var doubled: u8 = n + n
    return doubled
end

sub main() fails
    total = 1
    var first: u8 = 3
    total = total + first
    if flag
        var count: u8 = 1
        var wide: u16 = 1000
        total = total + count + wide
    elseif total > 5
        var count: u16 = 2
        total = total + count
    else
        var other: pair
        other.a = 4
        var last: u8 = other.a
        total = total + last
    end
    var second: u16 = total
    while second > 100
        var stride: u16 = 300
        second = second - stride
        if second < 2000
            var inner: u8 = 7
            second = second - inner
            exit
        end
        var later: boolean = second > 50
        if later
            continue
        end
    end
    var i: u8
    for i = 1 to 3
        var square: u8 = i * i
        var j: u8
        for j = 1 until i
            var both: u16 = square + j
            total = total + both
        end
        total = total + square
    end
    var code: u8
    total = total + work(250) handle code
        var shifted: u16 = code
        total = total + shifted
    end
    var p: pair
    p.b = total
    var tail: u16 = p.b
    total = tail + i
end
