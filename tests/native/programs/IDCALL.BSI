// A call's result passed after a path through an identifier is no copy.
forward pool boxes
forward pool nodes
record Node
    value: u8
    next: nodes?
end
record A
    w: u16
end
record B
    q: u8
end
record Holder
    h: nodes?
end
record Box
    a: A
    b: B
    hold: Holder
    name: string[4]
    own: nodes?
end
pool boxes: Box[2]
pool nodes: Node[2]
var keep: id boxes?
var gl: A
sub mk(): A
    return gl
end
sub two(x: A, y: A)
end
sub pb(x: B)
end
sub vb(var x: B)
end
sub ph(x: Holder)
end
sub vs(var s: string[])
end
sub ps(s: string[])
end
sub main()
    select keep
    case some(i)
        two(i.a, mk())
    case none
    end
end
