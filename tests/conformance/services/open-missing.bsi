// Opening a file that doesn't exist fails with fileNotFound and allocates nothing.
// spec: 16; services 4.2, 9
// expect output: 5\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[8]
    var code: u8 = 0
    var f: File
    f = openRead("NOPE.TXT", textMode) handle code
    end
    try appendU16(var line, code)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
