// id( is id(...), whatever is declared: here beside a variable named id.
forward pool nodes
record Node
    value: u8
    next: nodes?
    peer: id nodes?
    ps: id nodes?[2]
end
pool nodes: Node[8]
var keep: id nodes?
var ks: id nodes?[3]
var g: u8
var head: nodes?
sub take(x: nodes?)
end
sub main()
    var id: u8 = 2
    var n: nodes? = new nodes(1, none, none)
    var o = new nodes(2, none, none)
    keep = id(o)
end
