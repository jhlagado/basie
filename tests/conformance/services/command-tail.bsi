// commandTail gives the tail as typed, without its leading separator.
// spec: 16; services 5
// tail: HELLO WORLD
// expect output: [HELLO WORLD]\r\n

sub main() fails IoError
    var text: string[40]
    commandTail(var text)
    try writeText(console, "[")
    try writeText(console, text)
    try writeText(console, "]\r\n")
end
