// STRINGS.BSI: clear, copyFrom, compare, find, case, trim and the capacity rule.
// spec: 16.4; standard library 2
// expect output: lo W|-1 0 1 -1 1|4 0 65535 65535|HELLO, hello,|[a b]|[]|F14\r\n

include "FORMAT.BSI"

sub sign(var line: string[], v: i8, last: boolean) fails
    try appendI16(line, i16(v))
    if not last
        try appendByte(line, ' ')
    end
end

sub main() fails
    var line: string[80]
    var part: string[8]
    try copyFrom(part, "Hello World", 3, 4)
    try append(line, part)
    try append(line, "|")
    try sign(line, compare("abc", "abd"), false)
    try sign(line, compare("abc", "abc"), false)
    try sign(line, compare("b", "abc"), false)
    try sign(line, compare("ab", "abc"), false)
    try sign(line, compare("abc", "ab"), true)
    try append(line, "|")
    try appendU16(line, find("Hello World", "o W"))
    try appendByte(line, ' ')
    try appendU16(line, find("abc", ""))
    try appendByte(line, ' ')
    try appendU16(line, find("abc", "abcd"))
    try appendByte(line, ' ')
    try appendU16(line, find("abcabd", "abe"))
    try append(line, "|")
    var word: string[10]
    try append(word, "HeLLo,")
    toUpper(word)
    try append(line, word)
    try appendByte(line, ' ')
    toLower(word)
    try append(line, word)
    try append(line, "|[")
    var padded: string[10]
    try append(padded, " \ta b \t")
    trim(padded)
    try append(line, padded)
    try append(line, "]|[")
    clear(padded)
    try append(padded, "   ")
    trim(padded)
    try append(line, padded)
    try append(line, "]|")
    var small: string[3]
    try copyFrom(small, "abcdef", 0, 2)
    var code: u8 = 0
    copyFrom(small, "abcdef", 1, 5) handle code
        try appendByte(line, 'F')
        try appendU16(line, u16(code))
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
