// A loop that moves an owner and refills it before its back edge.
forward pool nodes
record Node
    value as u8
    next as nodes?
end
pool nodes as Node[8]
var head as nodes?
var g as u8
var c as boolean
sub main()
    var a = new nodes(1, none)
    while c
        head = move a
        a = new nodes(2, none)
    end
    g = a.value
end
