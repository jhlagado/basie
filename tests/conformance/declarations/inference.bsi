// A local without a type takes its initializer's definite type.
// spec: 8.10
// expect output: -42\r\n

include "FORMAT.BSI"

sub twice(n: i16): i16
    return n * 2
end

sub main() fails
    var line: string[12]
    var d = twice(-21)
    try appendI16(line, d)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
