// Binary files with 32-bit positions (67b): position, size and seek take
// and return u32 values; each is checked, and the narrowing at the end
// traps only when every one is right.
var buf: u8[200]
var check: u32
var out: u8

sub main() fails
    var i: u16
    for i = 0 until 200
        buf[i] = u8(i mod 256)
    end
    var f = try openWrite("DATA.BIN", binaryMode)
    try writeBlock(f, buf, 200)
    var at = try position(f)
    check = at - 200
    try close(f)
    var g = try openUpdate("DATA.BIN")
    var length = try size(g)
    check = check + length - 256
    try seek(g, 7)
    var b = try readByte(g)
    check = check + u32(b) - 7
    try seek(g, at - 150)
    var n = try readBlock(g, buf, 150)
    check = check + u32(buf[0]) - 50 + u32(n) - 150
    at = try position(g)
    check = check + at - 200
    try close(g)
    out = u8(256 - check)
end
