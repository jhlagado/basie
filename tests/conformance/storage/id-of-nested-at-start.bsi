// id(n) of a record nested at the start of a node: its address is the
// node's, but the slot's pool word shows it is not a node of the pool (7.14;
// review finding B4).
// spec: 7.14
// expect output: none\r\n
forward pool nodes
forward pool subs

record Sub
    x: u16
end

record Node
    inner: Sub
    value: u16
    next: nodes?
end

pool nodes: Node[8]
pool subs: Sub[8]

sub poke(var s: Sub) fails
    var i = id(s)
    select i
    case some(j)
        try writeText(console, "some\r\n")
    case none
        try writeText(console, "none\r\n")
    end
end

sub bump(var n: Node) fails
    try poke(n.inner)
end

sub main() fails
    var h = new nodes()
    try bump(h)
end
