// var parameters of owning array types: a routine changes an array of
// owning handles, or of records that own, in place. Each store through the
// parameter frees what it overwrites; the owner word the caller passes
// says whether the array lies in a pool slot.
record Job
    number: u16
end
pool jobs: Job[16]
record Bucket
    items: jobs?[4]
    count: u8
end
var table: Bucket[4]
var spare: jobs?[3]

sub fill(var slots: jobs?[3], base: u16)
    var i: u8
    for i = 0 to 2
        slots[i] = new jobs(base + u16(i))
    end
end

sub clear(var slots: jobs?[3], at: u8)
    slots[at] = none
end

sub swap(var slots: jobs?[3])
    var t = move slots[0]
    slots[0] = move slots[2]
    slots[2] = move t
end

sub add(var b: Bucket, v: u16)
    b.items[b.count] = new jobs(v)
    b.count = b.count + 1
end

sub addAll(var t: Bucket[4], v: u16)
    var k: u8
    for k = 0 to 3
        add(var t[k], v + u16(k))
    end
end

sub row(var t: Bucket[4], k: u8): var Bucket from t
    return t[k]
end

sub total(slots: jobs?[3]): u16
    var sum: u16 = 0
    var i: u8
    for i = 0 to 2
        select slots[i]
        case some(j)
            sum = sum + j.number
        case none
        end
    end
    return sum
end

sub main() fails IoError
    fill(var spare, 10)
    var before: u16 = total(spare)
    swap(var spare)
    clear(var spare, 1)
    var after: u16 = total(spare)
    select spare[0]
    case some(j)
        if j.number <> 12
            fail IoError.inputFailure
        end
    case none
        fail IoError.outputFailure
    end
    var local: jobs?[3]
    fill(var local, 20)
    clear(var local, 0)
    var l: u16 = total(local)
    addAll(var table, 100)
    add(var row(var table, 2), 7)
    var c: u8 = table[2].count + table[0].count
    if before = 33 and after = 22 and l = 43 and c = 3
        try writeText(console, "var owning arrays\r\n")
    end
end
