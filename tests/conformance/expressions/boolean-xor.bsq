// xor works on booleans and on integers.
// spec: 9.12
// expect output: T15\r\n

include "FORMAT.BSQ"

sub main() fails
    var line as string[8]
    var a as boolean = true
    var m as u8 = $F0
    if a xor false
        appendByte(line, 'T') else fail
    end
    appendU16(line, m xor $FF) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
