// A var record parameter given a field reached through an owning handle
// local: the root has no owner word, so none is passed.
record Leaf
    v: u8
    s: string[3]
end
record Outer
    w: u8
    inn: Leaf
    arr: Leaf[2]
end
pool outers: Outer[3]
var go: outers?
var gl: Leaf
var g: u8
sub fv(r: Leaf)
    g = r.v
end
sub fr(var r: Leaf)
    r.v = 1
end
sub fs(var s: string[])
end
sub fo(var o: Outer)
end
sub main()
    var c = new outers(1)
    fr(var c.inn)
end
