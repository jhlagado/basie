// Text files: CR LF, lone LF and lone CR all read as one newline; writing a
// newline gives CR LF; openWrite replaces the file at close.
// spec: 16; services 4.3, 4.6
// file IN.TXT: one\r\ntwo\nthree\rfour\x1a
// file OUT.TXT: old contents
// expect file OUT.TXT: one\r\ntwo\r\nthree\r\nfour\r\n
// expect output: 4\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    var count: u16 = 0
    var code: u8
    var src = try openRead("IN.TXT", textMode)
    var dst = try openWrite("OUT.TXT", textMode)
    while true
        readLine(src, var line) handle code
            if code = endOfInput
                exit
            end
            fail code
        end
        try writeText(dst, line)
        try writeByte(dst, 10)
        count = count + 1
    end
    try close(src)
    try close(dst)
    var report: string[8]
    try appendU16(var report, count)
    try writeText(console, report)
    try writeText(console, "\r\n")
end
