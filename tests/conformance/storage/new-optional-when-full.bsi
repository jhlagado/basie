// new? yields none when the pool is full.
// spec: 7.10
// expect output: full\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[1]

sub main() fails
    var a = new nodes(1, none)
    var b = new? nodes(2, none)
    select b
    case some(n)
        try writeText(console, "got\r\n")
    case none
        try writeText(console, "full\r\n")
    end
end
