// else fail passes a failure on and leaves the routine, so its owning
// locals are freed first, as a fail statement frees them.
// spec: 7.12, 14.4
// expect output: ok\r\n

forward pool nodes

record Node
    value: u8
end

pool nodes: Node[1]

sub inner() fails
    fail 3
end

sub outer() fails
    var n = new nodes(1)
    inner() else fail
end

sub main() fails
    var i: u8
    var e: u8
    for i = 1 to 3
        outer() handle e
        end
    end
    writeText(console, "ok\r\n") else fail
end
