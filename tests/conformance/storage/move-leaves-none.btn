// move hands the handle on and leaves none behind.
// spec: 7.11, 9.13
// expect output: -A\r\n

forward pool nodes

record Node
    value as u8
    next as nodes?
end

pool nodes as Node[4]

var head as nodes?
var spare as nodes?

sub main() fails
    head = new nodes('A', none)
    spare = move head
    select head
    case some(i)
        writeByte(console, 'H') else fail
    case none
        writeByte(console, '-') else fail
    end
    select spare
    case some(i)
        writeByte(console, i.value) else fail
    case none
    end
    writeText(console, "\r\n") else fail
end
