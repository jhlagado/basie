// Names are CP/M names; anything else is badName, including reserved $ types.
// spec: 16; services 4.1
// expect output: 7 7 7 7\r\n

include "FORMAT.BSI"

sub try(name: string[]): u8
    var code: u8 = 0
    var f: File
    f = openRead(name, textMode) handle code
    end
    return code
end

sub main() fails
    var line: string[20]
    appendU16(line, try("TOOLONGNAME.TXT")) else fail
    appendByte(line, ' ') else fail
    appendU16(line, try("A B.TXT")) else fail
    appendByte(line, ' ') else fail
    appendU16(line, try("X.$01")) else fail
    appendByte(line, ' ') else fail
    appendU16(line, try("")) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
