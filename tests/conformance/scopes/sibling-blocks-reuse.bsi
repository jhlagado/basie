// Blocks that do not enclose each other may declare the same name.
// spec: 5.6
// expect output: A\r\n

sub main() fails
    var flag: boolean = true
    if flag
        var count: u8 = 1
        try writeText(console, "A")
    else
        var count: u16 = 2
        try writeText(console, "B")
    end
    try writeText(console, "\r\n")
end
