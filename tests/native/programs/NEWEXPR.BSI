// new inside an expression: the enclosing expression's state survives
// its fields, and an elseif after a move is a condition of its own.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var g: u8
var w: u16
var b: boolean
sub eat(n: nodes): u8
    return n.value
end
sub big(n: nodes): u16
    return n.value
end
sub maybe(n: nodes?): u8
    return 1
end
sub main() fails IoError
    w = big(new nodes(1, none)) and not 0
    g = g + eat(new nodes(1, none))
    b = false and maybe(new nodes(1, none)) = 1
    g = eat(new nodes(eat(new nodes(7, none)) + 1, none)) * 2
    var x = new nodes(5, none)
    if b
        g = eat(move x)
    elseif b and g = 1
        g = 2
    end
    try writeByte(console, '0' + g)
    try writeText(console, "\r\n")
end
