; Compact target descriptor retained by pointer across source parsing. The
; part-bank array remains adapter-owned and stable for the compilation.
; The descriptor itself belongs to the operating adapter and remains stable.

TargetDescriptorRuntimeIdentity   .equ 0  ; word
TargetDescriptorImageBase         .equ 2  ; word
TargetDescriptorImageCapacity     .equ 4  ; word
TargetDescriptorWritableBase      .equ 6  ; word
TargetDescriptorWritableCapacity  .equ 8  ; word
TargetDescriptorFlags             .equ 10 ; byte
TargetDescriptorBankCount         .equ 11 ; byte
TargetDescriptorEntryBank         .equ 12 ; byte
TargetDescriptorPartBanksPointer  .equ 13 ; word
TargetDescriptorSize              .equ 15
TargetDescriptorEstablishStack    .equ 1
TargetStackRequirement            .equ 3840

; Target-only parse-time aggregate-constant lengths reuse dead post-fixup
; workspace at the same addresses as the historical segmented proof fields.
; They do not depend on generated-image publication metadata.
TargetBankRoLengthBase  .equ EmitControlFixupLimit+2
TargetBankRoLengthLimit .equ TargetBankRoLengthBase+2*TargetBankCapacity
TargetBankStateBase      .equ EmitControlFixupLimit+16
TargetBankStateSize      .equ 4
TargetBankStateCursor    .equ 0 ; word
TargetBankStateRemaining .equ 2 ; word
TargetBankStateLimit     .equ TargetBankStateBase+TargetBankStateSize*TargetBankCapacity

TargetDescriptorPointer .equ SourceMultipartWorkspaceEnd ; word
TargetCompilerWorkspaceEnd .equ TargetDescriptorPointer+2

; Parsing has completed before these values become live. They reuse the dead
; LL(1) parser stack beginning at TargetCompilerWorkspaceEnd.
TargetLayoutBase          .equ TargetCompilerWorkspaceEnd
TargetOutputBank          .equ TargetLayoutBase+$00
TargetImageBase           .equ TargetLayoutBase+$01 ; word
TargetImageCapacity       .equ TargetLayoutBase+$03 ; word
TargetLinkedRuntimeBase   .equ TargetLayoutBase+$05 ; word
TargetReadOnlyBase        .equ TargetLayoutBase+$07 ; word
TargetReadOnlyLength      .equ TargetLayoutBase+$09 ; word
TargetCodeBase            .equ TargetLayoutBase+$0B ; word
TargetCodeLength          .equ TargetLayoutBase+$0D ; word
TargetCodeCapacity        .equ TargetLayoutBase+$0F ; word
; During lowering these flat-publication fields are otherwise dead and retain
; the selected bank's aggregate-constant bounds. Banked MAP publication uses
; the per-bank tables, so the overlay does not destroy required state.
TargetCurrentRoCapacity   .equ TargetCodeLength
TargetCurrentRoBase       .equ TargetCodeCapacity
TargetWritableBase        .equ TargetLayoutBase+$11 ; word
TargetWritableCapacity    .equ TargetLayoutBase+$13 ; word
TargetBssBase             .equ TargetLayoutBase+$15 ; word
TargetLayoutMode          .equ TargetLayoutBase+$17
TargetStackMode           .equ TargetLayoutBase+$18
TargetStartupLength       .equ TargetLayoutBase+$19 ; word
TargetTerminalAddress     .equ TargetLayoutBase+$1B ; word
TargetRuntimeContext      .equ TargetLayoutBase+$1D
TargetContextRuntimeBase  .equ TargetRuntimeContext+$00 ; word
TargetContextWritableBase .equ TargetRuntimeContext+$02 ; word
TargetContextWritableCapacity .equ TargetRuntimeContext+$04 ; word
TargetContextStateBase    .equ TargetRuntimeContext+$06 ; word
TargetContextVectorBase   .equ TargetRuntimeContext+$08 ; word
TargetContextDataBase     .equ TargetRuntimeContext+$0A ; word
TargetContextDataCapacity .equ TargetRuntimeContext+$0C ; word
TargetContextRoDataBase   .equ TargetRuntimeContext+$0E ; word
TargetContextRoDataCapacity .equ TargetRuntimeContext+$10 ; word
TargetContextSize         .equ $12
; Finalization begins only after startup/code emission and any loaded-mode
; provider request. The complete map therefore reuses dead startup, terminal,
; and runtime-link-context storage without increasing compiler workspace.
TargetFlatMapBase         .equ TargetStartupLength
TargetMapEntryBank        .equ TargetFlatMapBase+$00
TargetMapEntryAddress     .equ TargetFlatMapBase+$01 ; word
TargetMapUsedLength       .equ TargetFlatMapBase+$03 ; word
TargetMapReadOnlyBase     .equ TargetFlatMapBase+$05 ; word
TargetMapReadOnlyLength   .equ TargetFlatMapBase+$07 ; word
TargetMapCodeBase         .equ TargetFlatMapBase+$09 ; word
TargetMapCodeLength       .equ TargetFlatMapBase+$0B ; word
TargetMapWritableBase     .equ TargetFlatMapBase+$0D ; word
TargetMapWritableCapacity .equ TargetFlatMapBase+$0F ; word
TargetMapVectorBase       .equ TargetFlatMapBase+$11 ; word
TargetMapVectorLength     .equ TargetFlatMapBase+$13 ; word
TargetMapInitializedBase  .equ TargetFlatMapBase+$15 ; word
TargetMapInitializedLength .equ TargetFlatMapBase+$17 ; word
TargetMapBssBase          .equ TargetFlatMapBase+$19 ; word
TargetMapBssLength        .equ TargetFlatMapBase+$1B ; word
TargetMapStackRequirement .equ TargetFlatMapBase+$1D ; word
TargetMapDataLoadBank     .equ TargetFlatMapBase+$1F
TargetMapDataLoadAddress  .equ TargetFlatMapBase+$20 ; word
TargetMapDataLoadLength   .equ TargetFlatMapBase+$22 ; word
TargetMapAggregateBase    .equ TargetFlatMapBase+$24 ; word
TargetMapAggregateLength  .equ TargetFlatMapBase+$26 ; word
TargetMapSize             .equ $28
TargetLayoutEnd           .equ TargetFlatMapBase+TargetMapSize
; The retained descriptor bytes remain live during both parsing and lowering,
; so they follow the shared 64-byte parser-stack/post-parse-layout overlay.
TargetDescriptorBankCountValue .equ TargetLayoutEnd ; byte
TargetDescriptorEntryBankValue .equ TargetDescriptorBankCountValue+1 ; byte
; The production compiler retains the caller's hardware stack pointer across
; parsing and replaces it with an output-abort continuation during generation.
; Its lifetime spans both sides of the parser-stack/target-layout overlay.
CompilerAbortSp           .equ TargetDescriptorEntryBankValue+1 ; word
TargetWorkspaceEnd        .equ CompilerAbortSp+2

DiagnosticTargetConfiguration .equ 95
DiagnosticTargetCapacity      .equ 96
DiagnosticTargetOutput        .equ 97

TargetLayoutLoaded .equ 0
TargetLayoutRom    .equ 1
TargetOutputClosed .equ $FF
