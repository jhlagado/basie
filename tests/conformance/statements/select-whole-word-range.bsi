// A range that covers every value of a word subject, u16 or i16, takes
// every value (11.7.2).
// spec: 11.7.2
// expect output: AAB\r\n

sub wide(v: u16): u8
    select v
    case 0 to 65535
        return 'A'
    end
    return '?'
end

sub signed(v: i16): u8
    select v
    case -32768 to 32767
        return 'B'
    end
    return '?'
end

sub main() fails IoError
    try writeByte(console, wide(0))
    try writeByte(console, wide(40000))
    try writeByte(console, signed(-5))
    try writeText(console, "\r\n")
end
