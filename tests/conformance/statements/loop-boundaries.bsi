// Counted loops that end at the edge of the counter's type: the next value
// is tested before it is stored, so nothing wraps and nothing traps, and
// the counter keeps the last value stored (12.5; review finding C1).
// spec: 12.5
// expect output: 7..0 255 254 127 5..0 3 0 65535\r\n

include "FORMAT.BSI"

sub main() fails
    var line as string[60]
    var c as u8
    var s as i8
    var w as u16
    var count as u16 = 0
    for c = 7 to 0 step -1
        if c = 7
            appendU16(line, c) else fail
        end
    end
    append(line, "..") else fail
    appendU16(line, c) else fail
    for c = 0 to 255
    end
    appendByte(line, ' ') else fail
    appendU16(line, c) else fail
    for c = 0 to 254 step 2
    end
    appendByte(line, ' ') else fail
    appendU16(line, c) else fail
    for s = 0 to 127
    end
    appendByte(line, ' ') else fail
    appendI16(line, i16(s)) else fail
    for w = 5 to 0 step -1
        if w = 5
            appendByte(line, ' ') else fail
            appendU16(line, w) else fail
        end
    end
    append(line, "..") else fail
    appendU16(line, w) else fail
    for w = 0 to 3
    end
    appendByte(line, ' ') else fail
    appendU16(line, w) else fail
    for w = 65535 to 0 step -65535
        count = count + 1
    end
    appendByte(line, ' ') else fail
    appendU16(line, w) else fail
    for w = 0 to 65535
    end
    appendByte(line, ' ') else fail
    appendU16(line, w) else fail
    append(line, "\r\n") else fail
    writeText(console, line) else fail
end
