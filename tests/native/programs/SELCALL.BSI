// select on a path from a call's aggregate result (74): an owner, an
// identifier and an integer subject.
forward pool nodes
record Node
    v: u16
    next: nodes?
end
pool nodes: Node[4]
record Holder
    head: nodes?
    ref: id nodes?
    n: u8
end
var hold: Holder
var all: Holder[2]
sub get(): Holder
    return hold
end
sub row(): Holder[2]
    return all
end
sub main() fails
    hold.head = new nodes(3, none)
    hold.ref = id(hold.head)
    hold.n = 2
    var t: u16 = 0
    select get().head
    case some(i)
        t = t + i.v
    case none
    end
    select get().ref
    case some(i)
        t = t + i.v
    case none
    end
    select row()[1].ref
    case some(i)
        fail 1
    case none
        t = t + 1
    end
    select get().n
    case 2
        t = t + 10
    case else
    end
    select get().n + 1
    case 3
        t = t + 100
    case else
    end
    if t = 117
        try writeText(console, "select on calls\r\n")
    end
end
