// readLine on the console reads one edited line without its terminator.
// spec: 16; services 3.3
// input: hello\r
// expect output: <hello>\r\n

sub main() fails
    var line as string[40]
    readLine(console, line) else fail
    writeText(console, "<") else fail
    writeText(console, line) else fail
    writeText(console, ">\r\n") else fail
end
