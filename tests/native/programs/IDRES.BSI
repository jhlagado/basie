// Identifier results: a routine hands back an identifier, a copy that the
// caller may keep; it is checked on each use, so a stale one tests none.
forward pool nodes
record Node
    value: u16
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var kept: id nodes?

sub push(v: u16)
    var n = new nodes(v, move head)
    head = move n
end

sub find(key: u16): id nodes?
    var p = id(head)
    while true
        select p
        case some(i)
            if i.value = key
                return p
            end
            p = id(i.next)
        case none
            exit
        end
    end
    return p
end

sub first(): id nodes?
    return id(head)
end

sub pick(key: u16): id nodes? fails
    var p = find(key)
    select p
    case some(i)
        return p
    case none
        fail 3
    end
end

sub main() fails
    push(10)
    push(20)
    push(30)
    kept = find(20)
    var found: u8 = 0
    select kept
    case some(i)
        i.value = 21
        found = 1
    case none
    end
    select find(99)
    case some(i)
        fail 1
    case none
        found = found + 1
    end
    var f = first()
    var g = try pick(30)
    select f
    case some(i)
        if i.value = 30 and g = f
            found = found + 1
        end
    case none
    end
    head = none
    select kept
    case some(i)
        fail 1
    case none
        found = found + 1
    end
    if found = 4
        try writeText(console, "identifier results\r\n")
    end
end
