// var parameters (67e): records, arrays and strings passed by address and
// written through it; a var record's owner word, zero from storage and
// passed on from a var record parameter, a field of it or its whole; a
// var result passed as a var argument; a far field through the alias.
record Inner
    a: u8
    b: u16
    c: u32
end

record Outer
    n: u16
    i: Inner
    pad: u8[40]
    far: i16
end

var g: Outer
var cells: u16[4]

sub inner(var r: Inner)
    r.a = r.a + 1
    r.b = 4000
    r.c = r.c + 70000
end

sub outer(var o: Outer, k: Outer)
    o.n = k.n + 1
    inner(var o.i)
    o.far = -5
    o.pad[33] = 7
    o = k
    o.far = o.far - 1
end

sub again(var o: Outer)
    outer(var o, g)
    inner(var o.i)
end

sub keep(var o: Outer): var Inner from o
    return o.i
end

sub fill(var w: u16[4], var t: string[10])
    w[2] = w[1] + 3
    t = "abc"
    t[1] = 'X'
end

sub main()
    var l: Outer
    var rs: Inner[3]
    var s: string[10]
    outer(var l, g)
    again(var g)
    inner(var rs[2])
    inner(var keep(var l))
    fill(var cells, var s)
end
