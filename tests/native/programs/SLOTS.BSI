// Slot-holders: a global, a field, an element and a parameter's place.
forward pool nodes

record Node
    value: u8
    next: nodes?
end

record Box
    tag: u8
    head: nodes?
    more: nodes?[2]
end

pool nodes: Node[8]

var list: nodes?
var box: Box
var i: u8

sub push(var l: nodes?, v: u8)
    var n = new nodes(v, move l)
    l = move n
end

sub drop(var l: nodes?)
    l = none
end

sub twice(var l: nodes?, v: u8)
    push(var l, v)
    push(var l, v + 1)
end

sub show(var l: nodes?) fails IoError
    select l
    case some(n)
        try writeByte(console, n.value)
        select n.next
        case some(m)
            try writeByte(console, m.value)
        case none
        end
    case none
    end
end

sub main() fails IoError
    var mine: nodes?
    push(var list, 'A')
    push(var box.head, 'B')
    push(var box.more[1], 'C')
    i = 0
    push(var box.more[i], 'D')
    push(var mine, 'E')
    twice(var mine, 'F')
    try show(var list)
    try show(var box.head)
    try show(var box.more[0])
    try show(var box.more[1])
    try show(var mine)
    drop(var mine)
    try show(var mine)
    try writeText(console, "\r\n")
end
