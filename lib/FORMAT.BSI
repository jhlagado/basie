// Basie standard library: numbers to text (D36; standard library section 3).
include "STRINGS.BSI"

sub appendU16(var s: string[], v: u16) fails
    var digits: u8[5]
    var count: u8 = 0
    var n: u16 = v
    while true
        digits[count] = u8(n mod 10) + '0'
        count = count + 1
        n = n / 10
        if n = 0
            exit
        end
    end
    while count > 0
        count = count - 1
        appendByte(s, digits[count]) else fail
    end
end

sub appendI16(var s: string[], v: i16) fails
    if v < 0
        appendByte(s, '-') else fail
        // not v is -v - 1, so this is -v without overflow at -32768.
        appendU16(s, u16(not v) + 1) else fail
    else
        appendU16(s, u16(v)) else fail
    end
end

sub appendU32(var s: string[], v: u32) fails
    var digits: u8[10]
    var count: u8 = 0
    var n: u32 = v
    while true
        digits[count] = u8(n mod 10) + '0'
        count = count + 1
        n = n / 10
        if n = 0
            exit
        end
    end
    while count > 0
        count = count - 1
        appendByte(s, digits[count]) else fail
    end
end

sub appendI32(var s: string[], v: i32) fails
    if v < 0
        appendByte(s, '-') else fail
        appendU32(s, u32(not v) + 1) else fail
    else
        appendU32(s, u32(v)) else fail
    end
end

// x with the given number of decimal places, rounded to the nearest unit of
// the last place. The scaled value must fit a u32.
sub appendF32(var s: string[], x: f32, places: u8) fails
    var v: f32 = x
    if v < 0.0
        appendByte(s, '-') else fail
        v = -v
    end
    var scale: u32 = 1
    var i: u8 = 0
    while i < places
        scale = scale * 10
        i = i + 1
    end
    var n: u32 = u32(v * f32(scale) + 0.5)
    appendU32(s, n / scale) else fail
    if places > 0
        appendByte(s, '.') else fail
        var frac: u32 = n mod scale
        var div: u32 = scale / 10
        while div > 0
            appendByte(s, u8(frac / div mod 10) + '0') else fail
            div = div / 10
        end
    end
end

private sub hexDigit(v: u8): u8
    if v < 10
        return v + '0'
    end
    return v - 10 + 'A'
end

// Two upper-case hexadecimal digits.
sub appendHex8(var s: string[], v: u8) fails
    appendByte(s, hexDigit(v shr 4)) else fail
    appendByte(s, hexDigit(v and 15)) else fail
end

// Four upper-case hexadecimal digits.
sub appendHex16(var s: string[], v: u16) fails
    appendHex8(s, u8(v shr 8)) else fail
    appendHex8(s, u8(v and 255)) else fail
end
