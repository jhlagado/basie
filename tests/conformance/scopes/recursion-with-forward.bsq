// With a forward declaration, a routine may call itself.
// spec: 5.9, 13.8
// expect output: 321\r\n

forward sub countDown(n as u8) fails

sub countDown
    if n > 0
        writeByte(console, '0' + n) else fail
        countDown(n - 1) else fail
    end
end

sub main() fails
    countDown(3) else fail
    writeText(console, "\r\n") else fail
end
