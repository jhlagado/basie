// When one operand widens to the other, the wider type is used.
// spec: 9.7
// expect output: -50\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[12]
    var small: u8 = 200
    var delta: i16 = -250
    try appendI16(var line, small + delta)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
