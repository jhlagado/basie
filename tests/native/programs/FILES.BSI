// Files as values, run (65.4 i): File program variables, locals and
// parameters, loaded and stored at their places, a parameter written, a
// local beyond IX-128 in a large frame, a File assigned from a call with
// its failure handled, and locals whose types are inferred from their
// initializers: a File, a u8, a u16 and a Boolean.
// file IN.TXT: in\r\n\x1a
// expect output: ABCDin\r\nE6\r\n
// expect file OUT.TXT: written\r\n

var out as File
var spare as File

sub emit(f as File, b as u8) fails
    var g = f
    writeByte(g, b) else fail
    f = printer
    g = console
    writeByte(g, b + 1) else fail
end

sub pick(n as u8, f as File, s as string[]) fails
    var line as string[8]
    readLine(f, line) else fail
    writeText(console, line) else fail
    writeText(console, s) else fail
end

sub main() fails
    var pad as u8[130]
    var far as File = console
    var near as File
    var code as u8 = 0
    var small = pad[0] + 2
    var wide = u16(small) * 3
    var yes = small = 2
    out = far
    spare = out
    emit(spare, 'A') else fail
    near = out
    emit(near, 'C') else fail
    near = openRead("IN.TXT", textMode) handle code
    end
    pick(small, near, "\r\n") else fail
    close(near) else fail
    far = openWrite("OUT.TXT", textMode) else fail
    writeText(far, "written") else fail
    writeByte(far, 10) else fail
    close(far) else fail
    near = openRead("NONE.TXT", binaryMode) handle code
        writeByte(console, 'E') else fail
    end
    if yes
        writeByte(console, u8(wide) + '0') else fail
    end
    writeText(console, "\r\n") else fail
end
