// exists, rename, delete and a directory search.
// spec: 16; services 4.7
// file A.TXT: a
// file B.TXT: b
// file C.DAT: c
// expect output: T F A.TXT B.TXT; Z.TXT\r\n
// expect no file C.DAT
// expect file Z.TXT: a

include "STRINGS.BSI"

sub flag(b: boolean): u8
    if b
        return 'T'
    end
    return 'F'
end

sub main() fails
    var line: string[60]
    var name: string[14]
    var there = try exists("A.TXT")
    try appendByte(var line, flag(there))
    try appendByte(var line, ' ')
    there = try exists("Q.TXT")
    try appendByte(var line, flag(there))
    var more = try findFirst("*.TXT", var name)
    while more
        try appendByte(var line, ' ')
        try append(var line, name)
        more = try findNext(var name)
    end
    try delete("C.DAT")
    try rename("A.TXT", "Z.TXT")
    try appendByte(var line, ';')
    more = try findFirst("Z*.*", var name)
    if more
        try appendByte(var line, ' ')
        try append(var line, name)
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
