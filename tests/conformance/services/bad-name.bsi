// Names are CP/M names; anything else is badName, including reserved $ types.
// spec: 16; services 4.1
// expect output: 7 7 7 7\r\n

include "FORMAT.BSI"

sub attempt(name: string[]): u8
    var code: u8 = 0
    var f: File
    f = openRead(name, textMode) handle code
    end
    return code
end

sub main() fails
    var line: string[20]
    try appendU16(var line, attempt("TOOLONGNAME.TXT"))
    try appendByte(var line, ' ')
    try appendU16(var line, attempt("A B.TXT"))
    try appendByte(var line, ' ')
    try appendU16(var line, attempt("X.$01"))
    try appendByte(var line, ' ')
    try appendU16(var line, attempt(""))
    try writeText(console, line)
    try writeText(console, "\r\n")
end
