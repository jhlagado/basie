// select chooses by constants, lists and ranges, with case else.
// spec: 11.7.2
// expect output: QD?\r\n

sub classify(c: u8) fails
    select c
    case 'q', 'Q'
        try writeByte(console, 'Q')
    case '0' to '9'
        try writeByte(console, 'D')
    case else
        try writeByte(console, '?')
    end
end

sub main() fails
    try classify('Q')
    try classify('7')
    try classify('x')
    try writeText(console, "\r\n")
end
