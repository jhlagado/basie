// A var P? parameter lends a place the callee may move into.
// spec: 7.14
// expect output: Y\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

var list: nodes?

sub push(var l: nodes?, v: u8)
    var n = new nodes(v, move l)
    l = move n
end

sub main() fails IoError
    push(var list, 'X')
    push(var list, 'Y')
    select list
    case some(i)
        try writeByte(console, i.value)
    case none
    end
    try writeText(console, "\r\n")
end
