// Failure: fail with exact and computed codes, else fail after calls,
// assignments and local initializers, handle into program variables,
// locals and parameters, a handled call beneath a pushed left operand,
// handlers inside loops and other handlers, and failable calls as right
// operands and under not.
var code: u8
var total: u16 = 1

sub check(n: u8): u8 fails
    if n > 9
        fail n - 9
    end
    return n
end

sub wide(n: u16): u16 fails
    if n = 0
        fail 1
    end
    return n * 2
end

sub relay(n: u8): u8 fails
    var first: u8 = try check(n)
    var second: u8 = try check(n + 1)
    first = first + second
    return first
end

sub keep(e: u8): u8 fails
    var local: u8
    local = check(e) handle e
        local = e
    end
    check(e + 20) handle local
        total = total + local
    end
    return local
end

sub truth(n: u8): boolean fails
    if n = 0
        fail 5
    end
    return n > 1
end

sub operands() fails
    var x: u8 = 2
    var b: boolean
    x = 1 + check(x) handle code
        fail code
    end
    x = x * check(x) handle code
    end
    b = not truth(x) handle code
        fail code
    end
    b = x > 3 and truth(x) handle code
    end
    x = 200 - check(x) handle code
        fail code
    end
end

sub main() fails
    var i: u8
    var w: u16
    code = try relay(3)
    total = total + wide(5) handle code
        total = 0
    end
    for i = 1 to 12
        w = u16(i) + wide(u16(i) - 1) handle code
            w = 7
            relay(i) handle code
                exit
            end
        end
        if code > 1
            continue
        end
    end
    while code < 5
        check(code + 10) handle code
        end
        code = try keep(code)
    end
    try operands()
    fail 4
end
