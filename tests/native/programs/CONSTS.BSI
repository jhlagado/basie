// Typed and local constants (D20; step 67): a typed scalar constant has
// exactly its type, so arithmetic with it wraps at its width; untyped
// ones adopt their context's; constants declared in blocks, typed and
// untyped, of every scalar type, and a typed constant as a loop's step.
const small: u8 = 200
const wide: u16 = small * 2
const yes: boolean = true
const k = u8(12)
const plain = 70
var out: u16
var b: u8

sub main()
    const local = 5
    const lw: u16 = 60000
    const lb: u8 = 250
    out = small + 100
    out = out + wide + local
    b = lb + 10
    if yes
        const inner: u8 = 3
        const half = 128
        b = b + inner + half
    end
    var i: u8
    const by: u8 = 2
    for i = 0 to 10 step by
        out = out + i
    end
    out = out + lw / k + plain
    const flip: boolean = not yes
    if flip
        out = 0
    end
end
