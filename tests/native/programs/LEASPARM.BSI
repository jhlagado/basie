// Leases of an owning parameter, to var and value record parameters.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
record Leaf
    v: u8
end
pool nodes: Node[8]
pool leaves: Leaf[2]
var list: nodes?
var keep: id nodes?
var g: u8
sub bump(var n: Node)
    n.value = n.value + 1
end
sub look(n: Node)
    g = n.value
end
sub make(): nodes
    return new nodes(1, none)
end
sub f(h: nodes)
    bump(var h)
    look(h)
end
sub main()
end
