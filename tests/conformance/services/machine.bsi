// Machine services: the current drive and user, and free memory.
// spec: 16; services 6
// expect output: 0 0 T\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[20]
    try appendU16(line, currentDrive())
    try appendByte(line, ' ')
    try appendU16(line, currentUser())
    try appendByte(line, ' ')
    if freeMemory() > 1000
        try appendByte(line, 'T')
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
