// PARSE.BSI: integers, with blanks, signs, $hex and the limits of each type.
// spec: 16.4; standard library 4
// expect output: 0 65535 B B 4660 B 12 B \r\n
// expect output: -32768 32767 B B 5 -7 B \r\n
// expect output: 4294967295 B -2147483648 2147483647 B 32 B \r\n

include "FORMAT.BSI"
include "PARSE.BSI"

sub u16Case(var line: string[], text: string[]) fails
    var code: u8 = 0
    var v: u16 = 0
    v = parseU16(text) handle code
        try append(line, "B ")
        return
    end
    try appendU16(line, v)
    try appendByte(line, ' ')
end

sub i16Case(var line: string[], text: string[]) fails
    var code: u8 = 0
    var v: i16 = 0
    v = parseI16(text) handle code
        try append(line, "B ")
        return
    end
    try appendI16(line, v)
    try appendByte(line, ' ')
end

sub u32Case(var line: string[], text: string[]) fails
    var code: u8 = 0
    var v: u32 = 0
    v = parseU32(text) handle code
        try append(line, "B ")
        return
    end
    try appendU32(line, v)
    try appendByte(line, ' ')
end

sub i32Case(var line: string[], text: string[]) fails
    var code: u8 = 0
    var v: i32 = 0
    v = parseI32(text) handle code
        try append(line, "B ")
        return
    end
    try appendI32(line, v)
    try appendByte(line, ' ')
end

sub finish(var line: string[]) fails
    try append(line, "\r\n")
    try writeText(console, line)
    clear(line)
end

sub main() fails
    var line: string[100]
    try u16Case(line, "0")
    try u16Case(line, "65535")
    try u16Case(line, "65536")
    try u16Case(line, "")
    try u16Case(line, "$1234")
    try u16Case(line, "$")
    try u16Case(line, " \t12  ")
    try u16Case(line, "1 2")
    try finish(line)
    try i16Case(line, "-32768")
    try i16Case(line, "32767")
    try i16Case(line, "32768")
    try i16Case(line, "-32769")
    try i16Case(line, "+5")
    try i16Case(line, " -7 ")
    try i16Case(line, "$10")
    try finish(line)
    try u32Case(line, "4294967295")
    try u32Case(line, "4294967296")
    try i32Case(line, "-2147483648")
    try i32Case(line, "2147483647")
    try i32Case(line, "2147483648")
    try i32Case(line, "32")
    try i32Case(line, "-")
    try finish(line)
end
