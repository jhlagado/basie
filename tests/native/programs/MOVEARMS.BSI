// An owner moved in every arm of an if, then given a new value.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var g: u8
var c: boolean
sub main()
    var a = new nodes(1, none)
    if c
        head = move a
    else
        head = move a
    end
    a = new nodes(2, none)
    g = a.value
end
