// Branch shrinking (67c): loops and ifs whose bodies put their jumps
// on either side of a JR's reach, forward and back; jumps that reach
// only once the jumps inside them shrink; string literals after shrunk
// code; and a routine long enough that its references and line entries
// need absolute offsets once the dropped jumps are gone.
var n as u16
var b as u8
var s as string[20]

sub edge0()
    while n < 1000
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
        n = n + 1
    end
    if b = 0
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
        b = b + 1
    else
        s = "else"
    end
end

