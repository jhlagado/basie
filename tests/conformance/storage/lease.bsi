// Passing an owned node to a var record parameter lends it.
// spec: 7.14, 13.4
// expect output: B\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

sub bump(var n: Node)
    n.value = n.value + 1
end

sub main() fails
    var h = new nodes('A', none)
    bump(h)
    try writeByte(console, h.value)
    try writeText(console, "\r\n")
end
