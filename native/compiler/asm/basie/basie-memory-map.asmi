; BASIE.COM's memory under CP/M (toolchain §7.1). The compiler loads at $0100
; behind a jump to the shell; its workspace and the resident source parts
; follow the image, and the stack sits below the BDOS entry.
;
; The target addresses below them are the forked compiler's flat proof
; target. Placed output is discarded until blob output replaces it (native
; compiler plan, 65.4), so they are only numbers the compiler checks.

CompilerCoreBase    .equ $0103
CompilerCoreLimit   .equ $4800
CompilerWorkBase    .equ $4800      ; the image must end below here
CompilerWorkLimit   .equ $5800
BasieWorkBase       .equ $5700      ; the shell's workspace
SourceBase          .equ $5800      ; resident source parts, up to the stack
BasieStackRoom      .equ $0400      ; kept below the BDOS entry for the stack

ReleasedGeneratedStagingBase  .equ $5800
ReleasedGeneratedStagingLimit .equ $6800
GeneratedBase       .equ ReleasedGeneratedStagingBase
GeneratedLimit      .equ ReleasedGeneratedStagingLimit
GeneratedCodeBase   .equ GeneratedBase
GeneratedCodeLimit  .equ GeneratedLimit

TargetRuntimeBase   .equ $6800
TargetRuntimeLimit  .equ $7800

ExecutionBase       .equ $7800
ExecutionLimit      .equ $8800

ProgramDataBase           .equ ExecutionBase+$0100
ProgramDataLimit          .equ ProgramDataBase+$0400
ProgramBssBase            .equ ProgramDataLimit
ProgramBssLimit           .equ ProgramBssBase+$0400
ProgramDataRegionLimit    .equ ProgramBssLimit
ProgramDataRegionCapacity .equ ProgramDataRegionLimit-ProgramDataBase
GeneratedRoDataCapacity   .equ $0400

ServiceBase         .equ $8800
ServiceLimit        .equ $9000
