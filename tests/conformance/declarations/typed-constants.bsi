// A typed constant has exactly its type; an untyped one adopts its context's.
// spec: 8.4
// expect output: 70000 200\r\n

include "FORMAT.BSI"

const big: u32 = 70000
const small = 200

sub main() fails
    var line: string[20]
    var b: u8 = small
    appendU32(line, big) else fail
    appendByte(line, ' ') else fail
    appendU16(line, b) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
