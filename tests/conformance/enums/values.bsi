// Nominal enum values survive storage, calls, comparisons and selection.
// expect output: E\r\n

enum Direction
    north
    east
    south
    west
end

enum Colour
    north
    blue
end

const home as Direction = Direction.north
const away as Direction = Direction.south
const preferred = Direction.south
const colours as Colour[2] = [Colour.north, Colour.blue]
var heading as Direction
var route as Direction[3] = [Direction.east, Direction.south, Direction.west]

record Position
    padding as u8[140]
    facing as Direction
    trail as Direction[2]
end

var global as Position

sub echo(value as Direction) as Direction
    return value
end

sub choose(value as Direction) as Direction
    if value = Direction.north
        return Direction.east
    end
    return Direction.west
end

sub turn(var point as Position, direction as Direction)
    point.facing = direction
    point.trail[1] = echo(direction)
end

sub first(items as Direction[]) as Direction
    return items[0]
end

sub main() fails
    var local as Direction
    var inferred = Direction.west
    const east as Direction = Direction.east
    const localMember = Direction.west
    const equal as boolean = home = Direction.north
    const different as boolean = home <> away
    var point as Position
    assert heading = home
    assert local = home
    assert global.facing = home
    assert point.trail[0] = home
    assert inferred = Direction.west
    assert inferred = localMember
    assert preferred = away
    assert equal and different
    assert colours[1] = Colour.blue
    heading = echo(route[1])
    assert heading = away
    assert Direction.south = heading
    assert heading <> home
    assert home <> heading
    local = choose(echo(home))
    assert local = east
    turn(point, local)
    assert point.facing = east
    assert point.trail[1] = east
    global = point
    assert global.facing = east
    route[0] = local
    assert first(route) = east
    var matched as boolean
    select heading
    case Direction.north, Direction.east
        matched = false
    case away
        matched = true
    case else
        matched = false
    end
    assert matched
    writeText(console, "E\r\n") else fail
end
