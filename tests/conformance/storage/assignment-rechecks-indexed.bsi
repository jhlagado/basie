// The right side frees the slot an assignment target goes through: the
// identifier is checked again before the store (7.13; review finding B1).
// spec: 7.13, 10.4
// expect trap: stale-handle at 33
include "FORMAT.BSI"
record Box
    w: u16
    arr: u16[4]
end
pool boxes: Box[1]
var gb: boxes?
sub churn(): u16
    gb = none
    gb = new boxes()
    return 7
end
sub show() fails IoError
    var line: string[20]
    select gb
    case some(j)
        try appendU16(var line, j.w)
        try appendByte(var line, ' ')
        try appendU16(var line, j.arr[2])
    case none
    end
    try writeText(console, line)
end
sub main() fails IoError
    gb = new boxes()
    select gb
    case some(j)
        var k: u8 = 2
        j.arr[k] = churn()
    case none
    end
    try show()
end
