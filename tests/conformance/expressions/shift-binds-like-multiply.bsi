// shl binds as tightly as multiplication.
// spec: 9.3
// expect output: 13\r\n

include "FORMAT.BSI"

sub main() fails IoError
    var line: string[8]
    var a: u16 = 1
    var b: u16 = 3
    try appendU16(var line, a + b shl 2)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
