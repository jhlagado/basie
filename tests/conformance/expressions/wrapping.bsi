// Integer arithmetic wraps in every type.
// spec: 9.8
// expect output: 0 -32768\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[30]
    var u: u8 = 255
    var s: i16 = 32767
    u = u + 1
    s = s + 1
    try appendU16(line, u)
    try appendByte(line, ' ')
    try appendI16(line, s)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
