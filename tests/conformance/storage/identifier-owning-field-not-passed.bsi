// A field that owns handles, reached through an identifier, can't be passed:
// a copy would duplicate its owner (7.13; review finding B2).
// spec: 7.13
// expect error: owning-copy at 47:18
include "FORMAT.BSI"
forward pool nodes
record Node
    v: u16
    next: nodes?
end
pool nodes: Node[1]
record Holder
    h: nodes?
    w: u16
end
record Box
    inner: Holder
end
pool boxes: Box[1]
var gb: boxes?
sub look(x: Holder) fails
    gb = none
    gb = new boxes()
    select gb
    case some(bi)
        bi.inner.h = new nodes(9, none)
        bi.inner.w = 555
    case none
    end
    var line: string[20]
    try appendU16(var line, x.w)
    try appendByte(var line, ' ')
    select x.h
    case some(k)
        try appendU16(var line, k.v)
    case none
        try appendByte(var line, 'N')
    end
    try writeText(console, line)
end
sub main() fails
    gb = new boxes()
    select gb
    case some(bi)
        bi.inner.h = new nodes(7, none)
        bi.inner.w = 1
        try look(bi.inner)
    case none
    end
end
