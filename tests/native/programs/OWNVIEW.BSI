// Open arrays of records that own handles: read through a view, a handle
// field selected and its identifier made; changed through a var view, a
// field's handle made, moved out or dropped, and the view passed on; a
// view of an array in a record of arrays; fixed arrays of any length,
// program variables and locals, passed.
record Job
    number: u16
end
pool jobs: Job[4]
record Box
    h: jobs?
    n: u8
end
record Bucket
    items: Box[2]
end
var a: Box[3]
var b: Box[5]
var buckets: Bucket[3]

sub total(bs: Box[]): u16
    var t: u16 = 0
    select bs[1].h
    case some(j)
        t = j.number
    case none
    end
    return t + u16(bs[0].n)
end

sub keep(bs: Box[]): id jobs?
    return id(bs[0].h)
end

sub fill(var bs: Box[], v: u16)
    bs[1].h = new jobs(v)
    bs[1].n = 2
end

sub take(var bs: Box[]): jobs?
    return move bs[1].h
end

sub clear(var bs: Box[])
    bs[0].h = none
end

sub pass(var bs: Box[])
    clear(var bs)
end

sub deep(var bk: Bucket[], v: u16)
    bk[0].items[1].h = new jobs(v)
end

sub main()
    var loc: Box[2]
    fill(var a, 5)
    fill(var loc, 6)
    var c = total(a) + total(b) + total(loc)
    var k = keep(a)
    var h = take(var a)
    pass(var b)
    deep(var buckets, 7)
end
