// handle stores the failure code and runs its body; the success store is skipped.
// spec: 14.6
// expect output: 48 7\r\n

include "FORMAT.BSI"

const notReady = 48

sub tryIt(ok: boolean): u8 fails
    if not ok
        fail notReady
    end
    return 7
end

sub main() fails
    var line: string[12]
    var code: u8 = 0
    var value: u8 = 0
    value = tryIt(false) handle code
        try appendU16(line, code)
    end
    try appendByte(line, ' ')
    value = tryIt(true) handle code
        try appendByte(line, '!')
    end
    try appendU16(line, value)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
