// More open arrays of records that own: an element passed to a var record
// parameter, whose owner word is zero; a var record's array field passed
// as a var view; and an open array whose elements are owning arrays, an
// element passed on as a fixed array.
record Job
    number as u16
end
pool jobs as Job[4]
record Box
    h as jobs?
    n as u8
end
record Bucket
    items as Box[2]
end
var a as Box[3]
var b as Bucket
var m as Box[3][2]

sub r(var bx as Box)
    bx.h = new jobs(1)
end

sub fill(var bs as Box[])
    r(bs[1])
    bs[0].n = 1
end

sub viaRecord(var k as Bucket)
    fill(k.items)
end

sub pair(var two as Box[2])
    two[1].h = none
end

sub rows(var v as Box[][2])
    v[1][0].h = new jobs(2)
    pair(v[0])
end

sub main()
    fill(a)
    viaRecord(b)
    rows(m)
end
