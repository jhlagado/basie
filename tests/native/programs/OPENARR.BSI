// Open arrays and open strings (67e): T[] parameters taking arrays of
// their element type and open arrays passed on, var or not; .length,
// elements at run-time and constant indexes, checked at run time; arrays
// of arrays and records as elements; s.length set through STR_SETL, a
// var string[]'s characters and capacity; a u8[] for a service.
record Pair
    k: u8
    v: i16
end

sub sum(a: u16[]): u16
    var t: u16 = 0
    var i: u16
    for i = 0 until a.length
        t = t + a[i]
    end
    return t + a[1]
end

sub bump(var a: u16[])
    a[0] = a[0] + sum(a)
end

sub pairs(var p: Pair[], k: u8)
    var i: u16
    for i = 0 until p.length
        p[i].k = k
        p[i].v = -i16(i)
    end
end

sub grid(var g: u8[][3]): u8
    g[1][2] = 9
    return g[g.length - 1][0]
end

sub chop(var s: string[], n: u8)
    if n < s.length
        s.length = n
    end
    s[0] = u8(s.capacity)
end

sub reads(f: File, var buf: u8[]): u16 fails IoError
    var n = try readBlock(f, var buf, 4)
    return n
end

sub main() fails IoError
    var w: u16[5] = [1, 2, 3, 4, 5]
    var ps: Pair[4]
    var gr: u8[2][3]
    var line: string[12] = "hello"
    var bytes: u8[8]
    var t: u16 = sum(w)
    bump(var w)
    pairs(var ps, 7)
    var c: u8 = grid(var gr)
    chop(var line, 2)
    var n = try reads(console, var bytes)
end
