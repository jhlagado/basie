sub cascade()
    while n < 2000
        if n = 0
            n = n + 2
            b = b + 1
        end
        if n = 1
            n = n + 2
            b = b + 1
        end
        if n = 2
            n = n + 2
            b = b + 1
        end
        if n = 3
            n = n + 2
            b = b + 1
        end
        if n = 4
            n = n + 2
            b = b + 1
        end
        if n = 5
            n = n + 2
            b = b + 1
        end
        n = n + 1
        if b > 3
            continue
        end
        b = b + 1
    end
end

sub long()
    if n = 0
        s = "case 0"
    end
    if n = 1
        s = "case 1"
    end
    if n = 2
        s = "case 2"
    end
    if n = 3
        s = "case 3"
    end
