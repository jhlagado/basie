// STRINGS.BSI: clear, copyFrom, compare, find, case, trim and the capacity rule.
// spec: 16.4; standard library 2
// expect output: lo W|-1 0 1 -1 1|4 0 65535 65535|HELLO, hello,|[a b]|[]|FlineTooLong\r\n

include "FORMAT.BSI"

sub sign(var line: string[], v: i8, last: boolean) fails IoError
    try appendI16(var line, i16(v))
    if not last
        try appendByte(var line, ' ')
    end
end

sub main() fails IoError
    var line: string[80]
    var part: string[8]
    try copyFrom(var part, "Hello World", 3, 4)
    try append(var line, part)
    try append(var line, "|")
    try sign(var line, compare("abc", "abd"), false)
    try sign(var line, compare("abc", "abc"), false)
    try sign(var line, compare("b", "abc"), false)
    try sign(var line, compare("ab", "abc"), false)
    try sign(var line, compare("abc", "ab"), true)
    try append(var line, "|")
    try appendU16(var line, find("Hello World", "o W"))
    try appendByte(var line, ' ')
    try appendU16(var line, find("abc", ""))
    try appendByte(var line, ' ')
    try appendU16(var line, find("abc", "abcd"))
    try appendByte(var line, ' ')
    try appendU16(var line, find("abcabd", "abe"))
    try append(var line, "|")
    var word: string[10]
    try append(var word, "HeLLo,")
    toUpper(var word)
    try append(var line, word)
    try appendByte(var line, ' ')
    toLower(var word)
    try append(var line, word)
    try append(var line, "|[")
    var padded: string[10]
    try append(var padded, " \ta b \t")
    trim(var padded)
    try append(var line, padded)
    try append(var line, "]|[")
    clear(var padded)
    try append(var padded, "   ")
    trim(var padded)
    try append(var line, padded)
    try append(var line, "]|")
    var small: string[3]
    try copyFrom(var small, "abcdef", 0, 2)
    var code: IoError
    copyFrom(var small, "abcdef", 1, 5) handle code
        try appendByte(var line, 'F')
        try appendIoError(var line, code)
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
