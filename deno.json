{
  "tasks": {
    "check": "deno fmt --check tests tools ref && deno lint tests tools ref",
    "brl": "deno run --config deno.runtime.json --allow-read=.,../atom,../z80-tool-services --allow-write=build --allow-env tools/brl.ts runtime/cpm22/cpm22.asm build/CPM22.BRL",
    "msg": "deno run --allow-read=. --allow-write=build,docs tools/msgfile.ts build/BASIE.MSG",
    "test": "deno test --config deno.runtime.json --allow-read=.,../atom,../triptych,../z80-tool-services --allow-write=build --allow-env tests/",
    "fmt": "deno fmt tests tools ref",
    "lint": "deno lint tests tools ref",
    "conformance": "deno run --config deno.runtime.json --allow-read=.,../atom tests/conformance/runner.ts",
    "census": "deno run --config deno.runtime.json --allow-read=/ tools/census.ts"
  },
  "fmt": {
    "exclude": [
      "**/*.md"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs/walk": "jsr:@std/fs@1/walk"
  }
}
