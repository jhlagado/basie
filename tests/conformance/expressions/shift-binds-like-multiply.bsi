// shl binds as tightly as multiplication.
// spec: 9.3
// expect output: 13\r\n

include "FORMAT.BSI"

sub main() fails
    var line as string[8]
    var a as u16 = 1
    var b as u16 = 3
    appendU16(line, a + b shl 2) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
