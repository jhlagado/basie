; Compact variable-length keyword table followed by parser-only names.

KeywordTable:
            .db  3,"var",TokenVar
            .db  2,"as",TokenAs
            .db  2,"u8",TokenU8
            .db  3,"u16",TokenU16
            .db  7,"boolean",TokenBoolean
            .db  4,"true",TokenTrue
            .db  5,"false",TokenFalse
            .db  5,"const",TokenConst
            .db  2,"or",TokenOr
            .db  3,"xor",TokenXor
            .db  3,"mod",TokenMod
            .db  6,"assert",TokenAssert
            .db  3,"and",TokenAnd
            .db  3,"not",TokenNot
            .db  4,"fail",TokenFail
            .db  3,"end",TokenEnd
            .db  3,"sub",TokenSub
            .db  5,"fails",TokenFails
            .db  3,"for",TokenFor
            .db  5,"until",TokenUntil
            .db  7,"forward",TokenForward
            .db  6,"return",TokenReturn
            .db  2,"if",TokenIf
            .db  6,"elseif",TokenElseIf
            .db  4,"else",TokenElse
            .db  5,"while",TokenWhile
            .db  2,"to",TokenTo
            .db  4,"step",TokenStep
            .db  4,"exit",TokenExit
            .db  8,"continue",TokenContinue
            .db  6,"record",TokenRecord
            .db  6,"string",TokenString
            .db  6,"handle",TokenHandle
KeywordCount            .equ 33

PunctuationTable:
            .db  "=",TokenEquals
            .db  ",",TokenComma
            .db  "-",TokenMinus
            .db  "+",TokenPlus
            .db  "*",TokenStar
            .db  "/",TokenSlash
            ; High-bit descriptors route numeric prefixes to the based-number
            ; scanner; the low seven bits retain its one-past digit count.
.if AggregateCallSlices
            .db  ".",TokenDot
            .db  "$",$85
            .db  "%",$91
PunctuationCount        .equ 9
.else
            .db  "$",$85
            .db  "%",$91
PunctuationCount        .equ 8
.endif

NameMain:               .db "main"
.if LegacyCompilerSlices
NameIndex:              .db "index"
NameBytes:              .db "bytes"
.endif
.if AggregateCallSlices
NameLength:             .db "length"

; Predefined services and error constants remain ordinary names to the
; tokenizer. The packed table gives the parser one namespace and dispatch
; authority without installing source-visible symbol entries.
Stage8PredefinedTable:
            .db 13
NameReadInputByte:
            .db "readInputByte"
            .db 15
NameWriteOutputByte:
            .db "writeOutputByte"
            .db 15,"readStorageByte"
            .db 18,"rewindStorageInput"
            .db 16,"writeStorageByte"
            .db 17,"seekStorageOutput"
            .db 10,"endOfInput"
            .db 12,"inputFailure"
            .db 13,"outputFailure"
            .db 14,"storageFailure"
Stage8PredefinedCount .equ 10

; Complete service selectors: target ID in bits 0..2, argument type in bits
; 3..4, successful u8 result in bit 5, and service kind in bit 7.
Stage8ServiceSignatureTable:
            .db Stage8CallableServiceFlag+Stage8ServiceResultU8+Stage8ServiceReadInput
            .db Stage8CallableServiceFlag+(ScalarTypeU8*8)+Stage8ServiceWriteOutput
            .db Stage8CallableServiceFlag+Stage8ServiceResultU8+Stage8ServiceReadStorage
            .db Stage8CallableServiceFlag+Stage8ServiceRewindStorage
            .db Stage8CallableServiceFlag+(ScalarTypeU8*8)+Stage8ServiceWriteStorage
            .db Stage8CallableServiceFlag+(ScalarTypeU16*8)+Stage8ServiceSeekStorage
.else
; Earlier proof fixtures retain their deliberately narrower parsers. These
; names are their immutable comparison strings and are not a second service
; namespace in the active packed LL(1) compiler.
NameReadInputByte:      .db "readInputByte"
NameWriteOutputByte:    .db "writeOutputByte"
.endif
.if LegacyCompilerSlices
NameResult:             .db "result"
.endif
