// File values in fields, elements and results (74): four bytes each,
// read and written as a File variable's are.
record Channel
    out: File
    count: u8
end
var chan: Channel
var outs: File[2]

sub pick(which: u8): File
    return outs[which]
end

sub say(var c: Channel, text: string[]) fails
    try writeText(c.out, text)
    c.count = c.count + 1
end

sub main() fails
    chan.out = console
    outs[0] = console
    outs[1] = chan.out
    var local: Channel
    local.out = pick(1)
    try writeText(chan.out, "field\r\n")
    try writeText(outs[1], "element\r\n")
    try writeText(pick(0), "result\r\n")
    try say(var local, "through a var record\r\n")
    var both: File[2]
    both[1] = outs[0]
    if local.count = 1 and both[1] = console and local.out = console
        try writeText(both[1], "files\r\n")
    end
end
