// readByte on the console echoes each key; Control-Z ends console input, for good.
// spec: 16; services 3.2
// input: ab
// expect output: ab[endOfInput][endOfInput]\r\n

include "FORMAT.BSI"

sub main() fails IoError
    var line: string[48]
    var code: IoError
    var b: u8
    b = try readByte(console)
    b = try readByte(console)
    b = readByte(console) handle code
        try appendByte(var line, '[')
        try appendIoError(var line, code)
        try appendByte(var line, ']')
    end
    b = readByte(console) handle code
        try appendByte(var line, '[')
        try appendIoError(var line, code)
        try appendByte(var line, ']')
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
