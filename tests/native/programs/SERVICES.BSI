// Services through the helper table, run (65.4 i): every kind of argument
// a service takes (a File, a string literal, a string, an open string
// passed on, a var string[], a u8[] and its var form, u8, u16), results
// of every type the native compiler takes (u8, u16, boolean, File) used as
// values, kept in inferred locals and discarded, failure passed on and
// handled, and the predeclared constants, exact as the reference's are.
// input: Line\rxy
// tail: SOME WORDS
// file DATA.TXT: abc\r\n\x1a
// expect output: [SOME WORDS]<Line>xy 4 1 T abc 301 3\r\n

record entry
    tag: u8
    data: u8[4]
    name: string[12]
end

var cells: u8[6]
var total: u16

sub put(s: string[]) fails IoError
    try writeText(console, s)
end

sub putNumber(n: u16) fails IoError
    var digits: string[6]
    var k: u16 = 10000
    var started: boolean = false
    while k > 0
        if n >= k or started or k = 1
            started = true
            try writeByte(console, u8(n / k) + '0')
            n = n mod k
        end
        k = k / 10
    end
end

sub drive(): u8
    return currentDrive()
end

sub main() fails IoError
    var e: entry
    var text: string[24]
    var code: IoError
    var tiny: u8[binaryMode]
    var i: u8
    var got: u16
    var free = freeMemory()
    var user = currentUser()
    var f = try openRead("DATA.TXT", textMode)
    commandTail(var text)
    try put("[")
    try put(text)
    try writeText(console, "]<")
    try readLine(console, var e.name)
    try writeText(console, e.name)
    try writeByte(console, '>')
    e.tag = readKey()
    try writeByte(console, e.tag)
    try writeByte(console, readKey())
    try writeByte(console, ' ')
    openRead("NOPE.TXT", textMode) handle code
    end
    if code = IoError.fileNotFound
        try putNumber(4)
    end
    try writeByte(console, ' ')
    try putNumber(drive() + user + binaryMode)
    if free > 1000 or keyReady()
        try writeText(console, " T ")
    end
    try readLine(f, var text)
    try close(f)
    try put(text)
    total = binaryMode + 300
    try writeByte(console, ' ')
    try putNumber(total)
    for i = 0 to 4 step binaryMode
        cells[i] = i
    end
    e.data[2] = 3
    got = readBlock(console, var e.data, 2) handle code
    end
    try writeByte(console, ' ')
    try putNumber(e.data[2])
    try writeText(console, "\r\n")
end
