// Shifts: shr keeps the sign of signed values; counts beyond the width give 0 or -1.
// spec: 9.10
// expect output: -4 1 0 -1\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    var s: i16 = -8
    var u: u16 = $8000
    var n: u8 = 20
    appendI16(line, s shr 1) else fail
    appendByte(line, ' ') else fail
    appendU16(line, u shr 15) else fail
    appendByte(line, ' ') else fail
    appendU16(line, u shl n) else fail
    appendByte(line, ' ') else fail
    appendI16(line, s shr n) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
