// keyReady holds a waiting key for the next read; readKey doesn't echo.
// spec: 16; services 3.2
// input: xy
// expect output: T<x><y>\r\n

sub main() fails
    if keyReady()
        try writeByte(console, 'T')
    end
    var a = readKey()
    var b = readKey()
    try writeByte(console, '<')
    try writeByte(console, a)
    try writeText(console, "><")
    try writeByte(console, b)
    try writeText(console, ">\r\n")
end
