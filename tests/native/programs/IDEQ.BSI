// Identifiers and Files compared: id(...) and paths on the left, none and
// non-optional identifiers on the right, inside and, or and not.
forward pool nodes
record Node
    value: u8
    next: nodes?
    peer: id nodes?
end
pool nodes: Node[4]
var keep: id nodes?
var out: File
sub flag(b: boolean) fails
    if b
        try writeByte(console, 'T')
    else
        try writeByte(console, 'F')
    end
end
sub main() fails
    var a = new nodes(1, none, none)
    var b = new nodes(2, none, none)
    var ia = id(a)
    keep = id(b)
    a.peer = id(b)
    try flag(id(a) = ia)
    try flag(a.peer = keep)
    try flag(keep <> none)
    try flag(ia = keep or ia = none)
    try flag(not (ia = keep))
    try flag(ia <> keep and keep = a.peer)
    out = printer
    try flag(out = printer)
    try flag(console <> out)
    try writeText(console, "\r\n")
end
