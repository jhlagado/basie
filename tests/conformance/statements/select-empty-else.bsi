// An empty case else lets the other values do nothing (D51).
// spec: 11.7.2
// expect output: Q.\r\n

sub show(c: u8) fails IoError
    select c
    case 'q'
        try writeByte(console, 'Q')
    case else
    end
end

sub main() fails IoError
    try show('q')
    try show('x')
    try writeText(console, ".\r\n")
end
