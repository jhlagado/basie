// Each computed index of a path is applied to the element the indexes
// before it select: an inner index does not overwrite an outer one, nor
// the address of a call's result, and a character reached that way is
// passed whole to a string[] parameter.
// spec: 6.2, 9.5, 13.4
// expect output: ABCDEF\r\n

record Row
    cells: u8[3]
    name: string[4]
end

var grid: u8[3][4]
var rows: Row[2]
var i: u8 = 1
var j: u8 = 2

sub second(): Row
    return rows[1]
end

sub first(s: string[]): u8
    return s[0]
end

sub main() fails IoError
    grid[1][2] = 'A'
    rows[1].cells[2] = 'B'
    rows[1].name = "CD"
    grid[2][1] = 'E'
    try writeOutputByte(grid[i][j])
    try writeOutputByte(rows[i].cells[j])
    try writeOutputByte(rows[i].name[i - 1])
    try writeOutputByte(second().name[i])
    try writeOutputByte(grid[j][i])
    try writeOutputByte(first(rows[i].name) + 3)
    try writeOutputByte(13)
    try writeOutputByte(10)
end
