// FORMAT.BSI: hexadecimal, always two or four upper-case digits.
// spec: 16.4; standard library 3
// expect output: 00 7F FF 0000 BEEF 0A0B\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    appendHex8(line, 0) else fail
    appendByte(line, ' ') else fail
    appendHex8(line, 127) else fail
    appendByte(line, ' ') else fail
    appendHex8(line, 255) else fail
    appendByte(line, ' ') else fail
    appendHex16(line, 0) else fail
    appendByte(line, ' ') else fail
    appendHex16(line, $BEEF) else fail
    appendByte(line, ' ') else fail
    appendHex16(line, $0A0B) else fail
    append(line, "\r\n") else fail
    writeText(console, line) else fail
end
