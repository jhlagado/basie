// new and new?, nested new, none, a program variable assigned, and owning
// locals freed at the end of their blocks and at every return, fail,
// exit and continue that leaves them, innermost scope first.
forward pool nodes
record Node
    value as u8
    next as nodes?
end
pool nodes as Node[4]
var head as nodes?
sub count(k as u8) as u16
    var t = new nodes(k, none)
    if k = 0
        return 7
    end
    var u as nodes? = none
    return u16(k) + 1
end
sub check(k as u8) fails
    var t = new? nodes(k, none)
    if k = 3
        fail 9
    end
end
sub main() fails
    var a = new nodes(1, none)
    var b as nodes? = new? nodes(2, new nodes(3, none))
    var c as nodes?
    head = new nodes(4, none)
    if true
        var d = new nodes(5, none)
    end
    var i as u8
    for i = 1 to 3
        var n = new? nodes(i, none)
        if i = 2
            exit
        end
    end
    while i < 9
        var m = new nodes(i, none)
        i = i + 1
        if i = 5
            continue
        end
    end
    var r = count(2)
    check(1) else fail
end
