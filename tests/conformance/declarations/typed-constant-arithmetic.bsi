// A typed constant beside a literal behaves like its type: the literal
// adopts it, so u8 arithmetic wraps and the result fits a u8 (8.4; review
// finding B3).
// spec: 8.4, 9.7
// expect output: 144 44 -4\r\n

include "FORMAT.BSI"

const a: u8 = 200
const c: u16 = a * 2
const m: i8 = -5

sub main() fails IoError
    var line: string[30]
    var b: u8 = a + 100
    var n: i8 = m + 1
    try appendU16(var line, c)
    try appendByte(var line, ' ')
    try appendU16(var line, b)
    try appendByte(var line, ' ')
    try appendI16(var line, i16(n))
    try append(var line, "\r\n")
    try writeText(console, line)
end
