// Aggregate constants in routines' bodies (67e): each takes its ordinal
// where it is declared and its read-only blob follows its routine's, a
// forward's completion's too; one in a block is gone at the block's end.
record P
    x: u8
    y: u16
end

const top: P = (1, 2)

forward sub g(): u8

sub f(): u8
    const k: P = (5, 600)
    const w: u8[3] = [7, 8, 9]
    return k.x + w[1] + top.x
end

sub main()
    const s: string[8] = "abc"
    var t: string[8] = s
    var a: u8 = f() + g()
    if a > 3
        const q: u16[2] = [100, 200]
        a = u8(q[1] - 190)
    end
    while a < 20
        const r: P[2] = [(1, 2), (3, 4)]
        a = a + r[1].x
    end
end

sub g
    const z: u8[2] = [4, 5]
    return z[0]
end
