// Counted loops take signed counters and negative steps.
// spec: 12.4
// expect output: 2 0 -2 \r\n

include "FORMAT.BSI"

sub main() fails
    var line as string[30]
    var i as i8
    for i = 2 to -2 step -2
        appendI16(line, i) else fail
        appendByte(line, ' ') else fail
    end
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
