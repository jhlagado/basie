// A from clause lets a result be rooted in a parameter.
// spec: 13.6
// expect output: K\r\n

record Entry
    value as u8
end

sub pick(items as Entry[4], index as u8) as Entry from items
    return items[index]
end

sub main() fails
    var list as Entry[4]
    list[2].value = 'K'
    writeByte(console, pick(list, 2).value) else fail
    writeText(console, "\r\n") else fail
end
