// Exact operands of shl, shr and not: an all-exact shift is folded exactly;
// an exact value shifted by a typed count, or under not, takes its
// context's type (9.7, 9.10, 9.12; review finding B8).
// spec: 9.7, 9.10, 9.12
// expect output: 8 255 8 15 8 65534\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    var x: u8 = 3
    var a: u8 = 1 shl 3
    var b: u8 = not 0
    var c: u8 = 1 shl x
    var d: u8 = 255 shr 4
    var e: u8 = 12 and 10
    var f: u16 = not 1
    try appendU16(line, a)
    try appendByte(line, ' ')
    try appendU16(line, b)
    try appendByte(line, ' ')
    try appendU16(line, c)
    try appendByte(line, ' ')
    try appendU16(line, d)
    try appendByte(line, ' ')
    try appendU16(line, e)
    try appendByte(line, ' ')
    try appendU16(line, f)
    try append(line, "\r\n")
    try writeText(console, line)
end
