// Files, leases and a name `id`, as the reference takes them: a File field
// of a call's record result passed; File arguments in parentheses; a File
// compared with one in parentheses; an owner lent in parentheses; and a
// variable named id read as an identifier's value, id(...) beside it.
record Channel
    out: File
end
record Job
    number: u16
end
pool jobs: Job[4]
var chan: Channel
var out: File
var g: jobs?
var id: id jobs?
var keep: id jobs?

sub mk(): Channel
    return chan
end

sub look(j: Job): u16
    return j.number
end

sub main() fails
    chan.out = console
    out = console
    writeText(mk().out, "a") else fail
    writeText((console), "b") else fail
    writeText(((chan.out)), "c") else fail
    var same = out = (console)
    var other = out <> ((chan.out))
    var h: jobs = new jobs(4)
    var n = look((h))
    keep = id
    keep = id (g)
    var b = id = keep
end
