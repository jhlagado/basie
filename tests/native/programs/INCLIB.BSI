// A part for INCMAIN.BSI, including INCUTIL.BSI before its declarations.
// Its private names may repeat the private names of INCUTIL.BSI.
include "INCUTIL.BSI"

private const scale = 5

private sub helper(p: pair): u16
    return p.b + triple(p.a)
end

sub combine(a: u8, b: u16): u16
    var p: pair
    p.a = a
    p.b = b
    return helper(p) * scale
end

sub later
    return n + 1
end
