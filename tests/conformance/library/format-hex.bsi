// FORMAT.BSI: hexadecimal, always two or four upper-case digits.
// spec: 16.4; standard library 3
// expect output: 00 7F FF 0000 BEEF 0A0B\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[40]
    try appendHex8(line, 0)
    try appendByte(line, ' ')
    try appendHex8(line, 127)
    try appendByte(line, ' ')
    try appendHex8(line, 255)
    try appendByte(line, ' ')
    try appendHex16(line, 0)
    try appendByte(line, ' ')
    try appendHex16(line, $BEEF)
    try appendByte(line, ' ')
    try appendHex16(line, $0A0B)
    try append(line, "\r\n")
    try writeText(console, line)
end
