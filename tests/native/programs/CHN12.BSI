include "CHN13.BSI"
// Part 12 of a chain of includes: each part includes the next, so all
// of them are open while the last loads.
var c12: u16
sub p12r0(): u16
    c12 = c12 + 0
    c12 = c12 + 1
    c12 = c12 + 2
    c12 = c12 + 3
    return c12
end
sub p12r1(): u16
    c12 = c12 + 1
    c12 = c12 + 2
    c12 = c12 + 3
    c12 = c12 + 4
    return c12
end
sub p12r2(): u16
    c12 = c12 + 2
    c12 = c12 + 3
    c12 = c12 + 4
    c12 = c12 + 5
    return c12
end
sub p12r3(): u16
    c12 = c12 + 3
    c12 = c12 + 4
    c12 = c12 + 5
    c12 = c12 + 6
    return c12
end
sub p12r4(): u16
    c12 = c12 + 4
    c12 = c12 + 5
    c12 = c12 + 6
    c12 = c12 + 7
    return c12
end
sub p12r5(): u16
    c12 = c12 + 5
    c12 = c12 + 6
    c12 = c12 + 7
    c12 = c12 + 8
    return c12
end
sub p12r6(): u16
    c12 = c12 + 6
    c12 = c12 + 7
    c12 = c12 + 8
    c12 = c12 + 9
    return c12
end
sub p12r7(): u16
    c12 = c12 + 7
    c12 = c12 + 8
    c12 = c12 + 9
    c12 = c12 + 10
    return c12
end
