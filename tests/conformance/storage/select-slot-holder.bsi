// select on a slot-holder binds an identifier, not a lease: the arm frees the
// slot through the program variable the slot-holder names, and the next
// access traps (11.7.3; review finding C5).
// spec: 11.7.3
// expect trap: stale-handle at 18
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[4]
var head: nodes?
sub f(var list: nodes?) fails
    select list
    case some(n)
        head = none
        var m = new nodes(66, none)
        n.value = 90
        try writeByte(console, m.value)
    case none
    end
end
sub main() fails
    head = new nodes(65, none)
    try f(head)
    try writeText(console, "\r\n")
end
