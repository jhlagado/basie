// A field's owner moved out of a record reached through an owning local.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var g: u8
var c: boolean
sub main()
    var a = new nodes(1, new nodes(2, none))
    head = move a.next
    g = a.value
end
