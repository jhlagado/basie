// select on a stale identifier takes the none arm and never traps.
// spec: 11.7.3
// expect output: gone\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

var keep: id nodes?

sub make()
    var n = new nodes(1, none)
    keep = id(n)
end

sub main() fails
    make()
    select keep
    case some(i)
        try writeText(console, "live\r\n")
    case none
        try writeText(console, "gone\r\n")
    end
end
