// readByte on the console echoes each key; Control-Z ends console input, for good.
// spec: 16; services 3.2
// input: ab
// expect output: ab[1][1]\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[12]
    var code: u8
    var b: u8
    b = try readByte(console)
    b = try readByte(console)
    b = readByte(console) handle code
        try appendByte(line, '[')
        try appendU16(line, code)
        try appendByte(line, ']')
    end
    b = readByte(console) handle code
        try appendByte(line, '[')
        try appendU16(line, code)
        try appendByte(line, ']')
    end
    try writeText(console, line)
    try writeText(console, "\r\n")
end
