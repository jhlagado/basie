// DUMP: show a file in hexadecimal and ASCII, 16 bytes to a line.
//
//     A>DUMP NAME.EXT
//
// Each line gives the offset, the bytes in hex, and the bytes again as
// characters, with a dot for anything that doesn't print. CP/M keeps files
// in 128-byte records, so a dump ends at a record boundary, padding included.

include "FORMAT.BSI"
include "TEXTIO.BSI"

const usage = 48

sub dumpLine(offset: u16, bytes: u8[], count: u16) fails
    var line: string[80]
    try appendHex16(line, offset)
    try append(line, ": ")
    var i: u16 = 0
    while i < 16
        if i < count
            try appendHex8(line, bytes[i])
        else
            try append(line, "  ")
        end
        try appendByte(line, ' ')
        if i = 7
            try appendByte(line, ' ')
        end
        i = i + 1
    end
    try appendByte(line, ' ')
    i = 0
    while i < count
        var b = bytes[i]
        if b >= 32 and b < 127
            try appendByte(line, b)
        else
            try appendByte(line, '.')
        end
        i = i + 1
    end
    try writeLine(console, line)
end

sub main() fails
    var tail: string[80]
    var name: string[20]
    commandTail(tail)
    var named = try word(tail, 0, name)
    if not named
        try writeLine(console, "Usage: DUMP NAME.EXT")
        fail usage
    end
    var there = try exists(name)
    if not there
        var line: string[40]
        try append(line, "No file ")
        try append(line, name)
        try writeLine(console, line)
        fail fileNotFound
    end
    var f = try openRead(name, binaryMode)
    var bytes: u8[16]
    var offset: u16 = 0
    while true
        var got = try readBlock(f, bytes, 16)
        if got = 0
            exit
        end
        try dumpLine(offset, bytes, got)
        offset = offset + got
    end
    try close(f)
end
