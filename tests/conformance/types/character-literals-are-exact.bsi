// A character literal is exact, like an integer literal with its byte's
// value, so it fits any integer type holding that value; where nothing
// else types it, it is u8 (6.4, 9.7; review finding B10).
// spec: 6.4, 9.7
// expect output: 65 66 67 65\r\n

include "FORMAT.BSI"

const C = 'A'

sub main() fails IoError
    var line: string[30]
    var a: i8 = 'A'
    var b: i8 = a + 1
    var w: u16 = 'C'
    var c = 'A'
    try appendI16(var line, i16(a))
    try appendByte(var line, ' ')
    try appendI16(var line, i16(b))
    try appendByte(var line, ' ')
    try appendU16(var line, w)
    try appendByte(var line, ' ')
    try appendU16(var line, c)
    try append(var line, "\r\n")
    try writeText(console, line)
end
