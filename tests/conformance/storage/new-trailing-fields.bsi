// new may omit trailing fields, which are zeroed: the only way to build a
// record holding an array of owning handles (R8).
// spec: 7.10
// expect output: 1-\r\n

forward pool trees

record Tree
    key: u8
    kids: trees?[4]
end

pool trees: Tree[8]

sub main() fails IoError
    var t = new trees('1')
    try writeByte(console, t.key)
    select t.kids[3]
    case some(k)
        try writeByte(console, k.key)
    case none
        try writeByte(console, '-')
    end
    try writeText(console, "\r\n")
end
