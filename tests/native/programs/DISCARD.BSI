// Discarded arms of constant short circuits that hold paths, string
// literals and inner short circuits: their code is not written and their
// literals are not placed, while the stack they would use is still counted,
// as the reference discards them (65.4 h).
var x: boolean
var y: u16 = 3
var c: u8[4]
var i: u8 = 1

sub long(s: string[]): boolean
    return s.length > 2
end

sub main()
    x = false and long("abc")
    x = true or (c[i] > 1 and long("xy"))
    x = false and (y > 1 and y < 5)
    y = 19279
    x = long("done")
end
