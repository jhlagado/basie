// Records, arrays and strings as locals: zeroed, one byte at a time up to
// four bytes and with LDIR above, given static initializers stored byte
// by byte, or copied from variables, constants, parameters and calls;
// their fields, elements and characters read, written and passed on
// (65.4 h).
record pair
    a: u8
    b: u16
end

var g: pair
var name: string[6] = "basie"
const twos: u8[3] = [2, 4, 8]
var i: u8 = 1
var x: u8
var y: u16

sub first(s: string[]): u8
    return s[0]
end

sub sum(p: pair): u16
    return p.a + p.b
end

sub made(): pair
    return g
end

sub copies(q: pair)
    var mine: pair = q
    var also: pair = made()
    mine.b = also.b + 1
    y = sum(mine)
end

sub main()
    var small: pair
    var cells: u8[4]
    var text: string[8]
    var big: u16[6]
    var word: string[5] = "hi"
    var spot: pair = (7, 700)
    var row: u8[3] = [1, 2, 3]
    var pairs: pair[2] = [(1, 10), (2, 20)]
    var copy: u8[3] = twos
    var other: string[6] = name
    small.a = 3
    small.b = small.b + spot.b
    cells[i] = row[2] + cells[3]
    big[5] = big[i] + pairs[1].b
    text = "local"
    text[i] = 'X'
    x = text.length + text[i] + first(text) + first(word) + other[4]
    y = sum(spot) + sum(pairs[i]) + copy[2]
    pairs[0] = spot
    word = "yo"
    g = small
    copies(spot)
end
