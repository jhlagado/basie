// Identifiers compare with = and <>, against each other and none; id P
// widens to id P? for the comparison. File values compare too (9.11, 16.3;
// review findings B7 and C12).
// spec: 9.11, 16.3
// expect output: TFTFT TFT\r\n

forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

sub flag(b: boolean): u8
    if b
        return 'T'
    end
    return 'F'
end

sub main() fails IoError
    var a = new nodes(1, none)
    var b = new nodes(2, none)
    var ia = id(a)
    var ib = id(b)
    var ia2 = id(a)
    var empty: id nodes? = none
    try writeByte(console, flag(ia = ia2))
    try writeByte(console, flag(ia = ib))
    try writeByte(console, flag(ia <> ib))
    try writeByte(console, flag(ia = empty))
    try writeByte(console, flag(empty = none))
    try writeByte(console, ' ')
    var f = console
    try writeByte(console, flag(f = console))
    try writeByte(console, flag(f = printer))
    try writeByte(console, flag(f <> printer))
    try writeText(console, "\r\n")
end
