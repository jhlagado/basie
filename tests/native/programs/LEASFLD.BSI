// An owning field of a var record parameter moved out and back.
forward pool nodes
record Node
    value as u8
    next as nodes?
end
record Leaf
    v as u8
end
pool nodes as Node[8]
pool leaves as Leaf[2]
var list as nodes?
var keep as id nodes?
var g as u8
sub bump(var n as Node)
    n.value = n.value + 1
end
sub look(n as Node)
    g = n.value
end
sub make() as nodes
    return new nodes(1, none)
end
sub f(var n as Node)
    var x = move n.next
    n.next = move x
end
sub main()
end
