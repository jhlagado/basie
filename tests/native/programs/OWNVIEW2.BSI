// More open arrays of records that own: an element passed to a var record
// parameter, whose owner word is zero; a var record's array field passed
// as a var view; and an open array whose elements are owning arrays, an
// element passed on as a fixed array.
record Job
    number: u16
end
pool jobs: Job[4]
record Box
    h: jobs?
    n: u8
end
record Bucket
    items: Box[2]
end
var a: Box[3]
var b: Bucket
var m: Box[3][2]

sub r(var bx: Box)
    bx.h = new jobs(1)
end

sub fill(var bs: Box[])
    r(var bs[1])
    bs[0].n = 1
end

sub viaRecord(var k: Bucket)
    fill(var k.items)
end

sub pair(var two: Box[2])
    two[1].h = none
end

sub rows(var v: Box[][2])
    v[1][0].h = new jobs(2)
    pair(var v[0])
end

sub main()
    fill(var a)
    viaRecord(var b)
    rows(var m)
end
