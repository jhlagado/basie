// ADVENT: a small text adventure.
//
// Find the gold and bring it back to the cellar. Commands are a verb and
// sometimes a noun: LOOK, NORTH (or N), SOUTH, EAST, WEST, TAKE thing,
// DROP thing, INVENTORY (or I), HELP and QUIT.

include "TEXTIO.BSI"

const cellar = 0
const hall = 1
const library = 2
const passage = 3
const vault = 4
const blocked = 255

// Where an item is: a room number, or carried.
const carried = 254

record Room
    name as string[16]
    text as string[80]
    north as u8
    south as u8
    east as u8
    west as u8
end

const rooms as Room[5] = [
    ("Cellar", "A damp cellar. Stone steps lead up to the north.", hall, blocked, blocked, blocked),
    ("Hall", "A dusty hall. Doors open east and west; the cellar is south.", blocked, cellar, passage, library),
    ("Library", "Shelves of rotting books. The only way out is east.", blocked, blocked, hall, blocked),
    ("Passage", "A narrow passage. An iron door stands to the east.", blocked, blocked, vault, hall),
    ("Vault", "A small vault, empty but for what you see.", blocked, blocked, blocked, passage)
]

record Item
    name as string[8]
    place as u8
end

var items as Item[3] = [("lamp", hall), ("key", library), ("gold", vault)]

var here as u8 = cellar

sub say(text as string[]) fails
    writeLine(console, text) else fail
end

// The item named, or 255.
sub itemNamed(noun as string[]) as u8
    var i as u8 = 0
    while i < 3
        if equal(items[i].name, noun)
            return i
        end
        i = i + 1
    end
    return 255
end

sub carrying(name as string[]) as boolean
    var i = itemNamed(name)
    return i <> 255 and items[i].place = carried
end

sub look() fails
    if here = passage and not carrying("lamp")
        say("It is too dark to see.") else fail
        return
    end
    say(rooms[here].name) else fail
    say(rooms[here].text) else fail
    var i as u8 = 0
    while i < 3
        if items[i].place = here
            var line as string[40]
            append(line, "There is a ") else fail
            append(line, items[i].name) else fail
            append(line, " here.") else fail
            say(line) else fail
        end
        i = i + 1
    end
end

sub go(way as u8) fails
    if way = blocked
        say("You can't go that way.") else fail
        return
    end
    if way = vault and not carrying("key")
        say("The iron door is locked.") else fail
        return
    end
    here = way
    look() else fail
end

sub take(noun as string[]) fails
    var i = itemNamed(noun)
    if i = 255 or items[i].place <> here
        say("You don't see that here.") else fail
        return
    end
    items[i].place = carried
    say("Taken.") else fail
end

sub drop(noun as string[]) fails
    var i = itemNamed(noun)
    if i = 255 or items[i].place <> carried
        say("You aren't carrying that.") else fail
        return
    end
    items[i].place = here
    say("Dropped.") else fail
end

sub inventory() fails
    var empty = true
    var i as u8 = 0
    while i < 3
        if items[i].place = carried
            var line as string[20]
            append(line, "  ") else fail
            append(line, items[i].name) else fail
            say(line) else fail
            empty = false
        end
        i = i + 1
    end
    if empty
        say("You are empty-handed.") else fail
    end
end

sub main() fails
    var line as string[60]
    var verb as string[12]
    var noun as string[12]
    var code as u8 = 0
    say("ADVENT: bring the gold back to the cellar.") else fail
    look() else fail
    while true
        prompt("> ", line) handle code
            if code = endOfInput
                return
            end
            fail code
        end
        toLower(line)
        var hasVerb = word(line, 0, verb) else fail
        var hasNoun = word(line, 1, noun) else fail
        if not hasVerb
            continue
        end
        if equal(verb, "look") or equal(verb, "l")
            look() else fail
        elseif equal(verb, "north") or equal(verb, "n")
            go(rooms[here].north) else fail
        elseif equal(verb, "south") or equal(verb, "s")
            go(rooms[here].south) else fail
        elseif equal(verb, "east") or equal(verb, "e")
            go(rooms[here].east) else fail
        elseif equal(verb, "west") or equal(verb, "w")
            go(rooms[here].west) else fail
        elseif equal(verb, "take") or equal(verb, "get")
            take(noun) else fail
        elseif equal(verb, "drop")
            drop(noun) else fail
        elseif equal(verb, "inventory") or equal(verb, "i")
            inventory() else fail
        elseif equal(verb, "help")
            say("Try LOOK, N, S, E, W, TAKE, DROP, I and QUIT.") else fail
        elseif equal(verb, "quit") or equal(verb, "q")
            say("Goodbye.") else fail
            return
        else
            say("I don't understand that.") else fail
        end
        if items[2].place = cellar
            say("The gold is safe in the cellar. You win!") else fail
            return
        end
    end
end
