// readLine on the console reads one edited line without its terminator.
// spec: 16; services 3.3
// input: hello\r
// expect output: <hello>\r\n

sub main() fails
    var line: string[40]
    try readLine(console, var line)
    try writeText(console, "<")
    try writeText(console, line)
    try writeText(console, ">\r\n")
end
