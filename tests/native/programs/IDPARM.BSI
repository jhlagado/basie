// Identifier parameters: optional and not, selected, read and written
// through, passed on, and stale after a free.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[4]
var keep: id nodes?

sub show(i: id nodes?) fails IoError
    select i
    case some(n)
        try writeByte(console, n.value)
    case none
        try writeByte(console, '-')
    end
end

sub bump(i: id nodes)
    i.value = i.value + 1
end

sub twice(i: id nodes?) fails IoError
    try show(i)
    try show(i)
end

sub main() fails IoError
    var a = new nodes('A', none)
    var x = id(a)
    bump(x)
    try show(id(a))
    try twice(x)
    try show(none)
    keep = id(a)
    a = new nodes('Q', none)
    try show(keep)
    try writeText(console, "\r\n")
end
