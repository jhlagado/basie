// A var parameter changes the caller's object.
// spec: 13.4
// expect output: 6\r\n

include "FORMAT.BSI"

record Point
    x as i16
    y as i16
end

sub nudge(var p as Point)
    p.x = p.x + 5
end

sub main() fails
    var line as string[8]
    var here as Point = (1, 2)
    nudge(here)
    appendI16(line, here.x) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
