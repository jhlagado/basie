// An open array parameter views any length and reports it as .length.
// spec: 6.2, 13.4
// expect output: 3 60\r\n

include "FORMAT.BSI"

sub total(items: u16[]): u16
    var sum: u16 = 0
    var i: u16 = 0
    while i < items.length
        sum = sum + items[i]
        i = i + 1
    end
    return sum
end

sub main() fails
    var line: string[12]
    var three: u16[3] = [10, 20, 30]
    try appendU16(line, 3)
    try appendByte(line, ' ')
    try appendU16(line, total(three))
    try writeText(console, line)
    try writeText(console, "\r\n")
end
