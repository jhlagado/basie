// An owning destination with a call in its index: the target path is
// evaluated first, then the right side, then the store (10.4; review
// finding C6).
// spec: 10.4
// expect output: TR\r\n
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var hs: nodes?[4]
var code: IoError
sub t(): u8
    writeOutputByte('T') handle code
    end
    return 1
end
sub r(): nodes
    writeOutputByte('R') handle code
    end
    return new nodes(1, none)
end
sub main() fails IoError
    hs[t()] = r()
    try writeText(console, "\r\n")
end
