// Baton standard library: numbers to text (D36).
include "STRINGS.BTN"

sub appendU16(var s as string[], v as u16) fails
    var digits as u8[5]
    var count as u8 = 0
    var n as u16 = v
    while true
        digits[count] = u8(n mod 10) + '0'
        count = count + 1
        n = n / 10
        if n = 0
            exit
        end
    end
    while count > 0
        count = count - 1
        appendByte(s, digits[count]) else fail
    end
end

sub appendI16(var s as string[], v as i16) fails
    if v < 0
        appendByte(s, '-') else fail
        // not v is -v - 1, so this is -v without overflow at -32768.
        appendU16(s, u16(not v) + 1) else fail
    else
        appendU16(s, u16(v)) else fail
    end
end
