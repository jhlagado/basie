// Owning record locals: zeroed, filled through their owning fields, and
// freed at the end of their block, at a return and at exit.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[2]

sub fill() fails IoError
    var head: Node
    head.next = new nodes('A', none)
    select head.next
    case some(n)
        try writeByte(console, n.value)
    case none
    end
end

sub early(stop: boolean): u8
    var head: Node
    head.next = new nodes('B', none)
    if stop
        return 1
    end
    while true
        var inner: Node
        inner.next = new nodes('C', none)
        exit
    end
    return 2
end

sub main() fails IoError
    try fill()
    try fill()
    try fill()
    try writeByte(console, '0' + early(true))
    try writeByte(console, '0' + early(false))
    try writeByte(console, '0' + early(false))
    try writeText(console, "\r\n")
end
