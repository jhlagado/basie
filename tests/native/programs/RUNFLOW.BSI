// Control flow and failure, run: counted loops up and down, continue and
// exit, a failure handled inside an expression and one passed on. The
// last statement traps (narrowing) only when the total is right.
var big: u16 = 300
var r: u8

sub tally(limit: u8): u16 fails
    var i: u8
    var s: u16
    for i = 1 to limit
        if i = 7
            continue
        end
        if i > 20
            fail i
        end
        s = s + i
    end
    return s
end

sub main() fails
    var t: u16
    var w: u16
    var e: u8
    var n: u8
    t = try tally(10)
    for w = 1000 to 0 step -300
        t = t + w / 100
    end
    t = t + tally(30) handle e
        t = t + e
    end
    while n < 250
        n = n + 50
        if n = 150
            exit
        end
    end
    t = t + n
    for n = 250 until 255
        t = t + 1
    end
    t = t + n
    if t = 500
        r = u8(big)
    end
end
