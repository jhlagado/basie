// Handle values in parentheses, as the reference's primary allows: an
// owner made, moved or none, assigned, passed, returned and initializing
// a typed local; an identifier made or none, assigned.
record Job
    number: u16
end
pool jobs: Job[4]
var g: jobs?
var k: id jobs?

sub take(x: jobs?)
end

sub make(): jobs?
    return (new jobs(3))
end

sub main()
    g = (new jobs(1))
    k = (id(g))
    take(((move g)))
    take((new jobs(2)))
    var h: jobs? = (make())
    g = (none)
    k = ((none))
end
