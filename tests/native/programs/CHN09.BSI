include "CHN10.BSI"
// Part 9 of a chain of includes: each part includes the next, so all
// of them are open while the last loads.
var c9 as u16
sub p9r0() as u16
    c9 = c9 + 0
    c9 = c9 + 1
    c9 = c9 + 2
    c9 = c9 + 3
    return c9
end
sub p9r1() as u16
    c9 = c9 + 1
    c9 = c9 + 2
    c9 = c9 + 3
    c9 = c9 + 4
    return c9
end
sub p9r2() as u16
    c9 = c9 + 2
    c9 = c9 + 3
    c9 = c9 + 4
    c9 = c9 + 5
    return c9
end
sub p9r3() as u16
    c9 = c9 + 3
    c9 = c9 + 4
    c9 = c9 + 5
    c9 = c9 + 6
    return c9
end
sub p9r4() as u16
    c9 = c9 + 4
    c9 = c9 + 5
    c9 = c9 + 6
    c9 = c9 + 7
    return c9
end
sub p9r5() as u16
    c9 = c9 + 5
    c9 = c9 + 6
    c9 = c9 + 7
    c9 = c9 + 8
    return c9
end
sub p9r6() as u16
    c9 = c9 + 6
    c9 = c9 + 7
    c9 = c9 + 8
    c9 = c9 + 9
    return c9
end
sub p9r7() as u16
    c9 = c9 + 7
    c9 = c9 + 8
    c9 = c9 + 9
    c9 = c9 + 10
    return c9
end
