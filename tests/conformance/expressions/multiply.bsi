// Multiplication wraps in the operand type; signed and unsigned agree in the low bits.
// spec: 9.8
// expect output: 60000 -6 88\r\n

include "FORMAT.BSI"

sub main() fails
    var line: string[20]
    var a: u16 = 300
    var b: i16 = -3
    var c: u8 = 200
    try appendU16(line, a * 200)
    try appendByte(line, ' ')
    try appendI16(line, b * 2)
    try appendByte(line, ' ')
    try appendU16(line, c * 3)
    try writeText(console, line)
    try writeText(console, "\r\n")
end
