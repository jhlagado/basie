// Labels take the subject's type, signed or unsigned.
// spec: 11.7.2
// expect output: neg\r\n

sub main() fails
    var d: i8 = -3
    select d
    case -5 to -1
        writeText(console, "neg\r\n") else fail
    case 0
        writeText(console, "zero\r\n") else fail
    case else
        writeText(console, "pos\r\n") else fail
    end
end
