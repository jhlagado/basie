// Opening a file that doesn't exist fails with fileNotFound and allocates nothing.
// spec: 16; services 4.2, 9
// expect output: 5\r\n

include "FORMAT.BSI"

sub main() fails
    var line as string[8]
    var code as u8 = 0
    var f as File
    f = openRead("NOPE.TXT", textMode) handle code
    end
    appendU16(line, code) else fail
    writeText(console, line) else fail
    writeText(console, "\r\n") else fail
end
