// Local owning records that no pool describes (74): each is freed where
// its scope ends through an owner descriptor made at its first free and
// kept for its type, as a pool of the type would then reuse it.
forward pool nodes
record Node
    v: u16
    next: nodes?
end
pool nodes: Node[8]
record Holder
    head: nodes?
    count: u8
end
record Pair
    a: Holder
    b: Holder
end

sub fill(var h: Holder, v: u16)
    h.head = new nodes(v, move h.head)
    h.count = h.count + 1
end

sub sum(h: Holder): u16
    var total: u16 = 0
    var p = id(h.head)
    while true
        select p
        case some(n)
            total = total + n.v
            p = id(n.next)
        case none
            exit
        end
    end
    return total
end

sub once(): u16
    var tmp: Holder
    fill(tmp, 3)
    fill(tmp, 4)
    return sum(tmp)
end

sub twice(): u16
    var both: Pair
    fill(both.a, 5)
    fill(both.b, 6)
    var t: u16 = sum(both.a) + sum(both.b)
    var again: Holder
    fill(again, 1)
    return t + sum(again)
end

sub main() fails
    var total: u16 = 0
    var round: u8
    for round = 1 to 5
        total = total + once() + twice()
    end
    if total = 95
        try writeText(console, "local owners\r\n")
    end
end
