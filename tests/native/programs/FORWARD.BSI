// Forward routines: each takes its ordinal where it is declared and its
// blob where its body is, checks its need against the stack, counts zero
// in its callers' needs until its body is complete, and may call itself;
// the limits record flags the program (65.4 e).
forward sub down(n: u16): boolean
var depth: u16
forward sub even(n: u8): boolean
forward sub tick()

sub odd(n: u8): boolean
    return n <> 0 and even(n - 1)
end

sub even
    depth = depth + 1
    return n = 0 or odd(n - 1)
end

sub down
    tick()
    return n = 0 or down(n - 1)
end

sub tick
    depth = depth + 1
end

sub main()
    var seen: boolean = down(20)
    seen = even(7) or odd(4)
    tick()
end
