// Counted loops over the 32-bit types (67b): u32 and i32 counters, up
// and down, with bounds in reach and beyond, word and exact steps, and
// the comparison through CMP32U with the sign flipped for i32.
const top: u32 = 100000

sub main()
    var i: u32
    var j: i32
    var t: u32
    var n: u16 = 7
    var b: i32 = -5
    for i = 70000 to top step 9999
        t = t + i
    end
    for j = 100000 to -100000 step -33333
        t = t + u32(j + 200000)
    end
    for i = 0 until n
        t = t + 1
    end
    for j = -10 to b
        t = t - 1
    end
    for i = 4294967290 to 4294967295
        t = t + 1
    end
    for j = 2147483640 to 2147483647 step 3
        continue
    end
    for i = 10 to 0 step -1
        if i = 3
            exit
        end
    end
    for j = 0 to 4294967295
        exit
    end
    for i = 5 to -1
        t = 0
    end
end
