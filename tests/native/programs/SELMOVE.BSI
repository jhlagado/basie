// select move of a program variable binds an owner in its some arm.
forward pool nodes
record Node
    value: u8
    next: nodes?
end
pool nodes: Node[8]
var head: nodes?
var g: u8
var c: boolean
sub main()
    head = new nodes(1, none)
    select move head
    case some(x)
        g = x.value
    case none
    end
    select head
    case some(y)
        g = 2
    end
end
