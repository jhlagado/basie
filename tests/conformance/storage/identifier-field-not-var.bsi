// A field reached through an identifier can't be passed to a var parameter
// (7.13; review finding B2).
// spec: 7.13
// expect error: not-writable at 23:18
include "FORMAT.BSI"
record Inner
    w: u16
end
record Box
    inner: Inner
end
pool boxes: Box[1]
var gb: boxes?
sub bump(var x: Inner)
    gb = none
    gb = new boxes()
    x.w = 3
end
sub main() fails
    gb = new boxes()
    select gb
    case some(j)
        bump(var j.inner)
    case none
    end
    var line: string[20]
    select gb
    case some(j)
        try appendU16(var line, j.inner.w)
    case none
    end
    try writeText(console, line)
end
