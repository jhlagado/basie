// Recursion within the stack bound runs; the check costs nothing but the check.
// spec: 7.18
// expect output: 500\r\n

include "FORMAT.BSI"

forward sub count(n: u16): u16

sub count
    if n = 0
        return 0
    end
    return count(n - 1) + 1
end

sub main() fails
    var line: string[8]
    try appendU16(var line, count(500))
    try writeText(console, line)
    try writeText(console, "\r\n")
end
