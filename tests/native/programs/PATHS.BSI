// Fields, elements and characters of program variables and constants,
// read and written: constant and run-time indexes at both widths, bounds
// checked against each array and string, records inside records and
// arrays, and arrays and strings inside records (65.4 h).
record point
    x: u8
    y: u16
    on: boolean
end

record shape
    name: string[6]
    at: point
    corners: point[3]
    marks: u8[5]
end

var p: point
var s: shape
var shapes: shape[3]
var cells: u8[4]
var words: u16[300]
var title: string[12] = "paths"
const primes: u8[5] = [2, 3, 5, 7, 11]
const origin: point = (1, 2, true)
var i: u8 = 1
var j: u8 = 2
var w: u16 = 299
var x: u8
var y: u16
var f: boolean

sub main()
    x = p.x
    y = p.y
    f = p.on
    p.x = 7
    p.y = 1000
    p.on = not f
    x = cells[3]
    cells[0] = 9
    x = cells[i]
    cells[j] = x + 1
    y = words[w]
    words[w] = y + 1
    words[i] = words[w] + words[j]
    y = words[299]
    s.at.x = 3
    s.at.y = s.at.y + 1
    s.corners[2].y = 40000
    s.corners[i].x = s.corners[j].x
    s.marks[4] = 1
    s.marks[i] = s.marks[j]
    shapes[2].at.on = true
    shapes[i].at.y = shapes[j].corners[i].y
    shapes[i].marks[j] = 5
    x = shapes[j].marks[i] + shapes[1].marks[2]
    x = title.length
    x = title[0]
    x = title[i]
    title[j] = 'A'
    x = s.name.length + s.name[i]
    shapes[i].name[j] = 'z'
    x = shapes[j].name[i]
    x = primes[4] + primes[i]
    y = origin.y
    f = origin.on and primes[j] > 3
    x = cells[cells[i]]
    y = words[cells[j] + w - 299]
end
