// Blocks that do not enclose each other may declare the same name.
// spec: 5.6
// expect output: A\r\n

sub main() fails
    var flag: boolean = true
    if flag
        var count: u8 = 1
        writeText(console, "A") else fail
    else
        var count: u16 = 2
        writeText(console, "B") else fail
    end
    writeText(console, "\r\n") else fail
end
