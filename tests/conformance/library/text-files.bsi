// TEXTIO.BSI on files: writeLine, readAll to the end and to a full buffer,
// and truncate in both modes, which copies a prefix and replaces the file.
// spec: 16.4; standard library 5
// file DATA.TXT: 0123456789
// file RAW.BIN: ABCDEFGHIJ
// expect output: 10 4 3 128 44 00\r\n
// expect file OUT.TXT: one\r\ntwo\r\n
// expect file DATA.TXT: 012
// expect no file DATA.~

include "FORMAT.BSI"
include "TEXTIO.BSI"

sub main() fails
    var out = openWrite("OUT.TXT", textMode) else fail
    writeLine(out, "one") else fail
    writeLine(out, "two") else fail
    close(out) else fail
    var buf: u8[16]
    var f = openRead("DATA.TXT", textMode) else fail
    var count = readAll(f, buf) else fail
    close(f) else fail
    var line: string[30]
    appendU16(line, count) else fail
    appendByte(line, ' ') else fail
    var four: u8[4]
    f = openRead("DATA.TXT", textMode) else fail
    count = readAll(f, four) else fail
    close(f) else fail
    appendU16(line, count) else fail
    appendByte(line, ' ') else fail
    truncate("DATA.TXT", 3, textMode) else fail
    f = openRead("DATA.TXT", textMode) else fail
    count = readAll(f, buf) else fail
    close(f) else fail
    appendU16(line, count) else fail
    truncate("RAW.BIN", 4, binaryMode) else fail
    var data: u8[130]
    f = openRead("RAW.BIN", binaryMode) else fail
    count = readAll(f, data) else fail
    close(f) else fail
    appendByte(line, ' ') else fail
    appendU16(line, count) else fail
    appendByte(line, ' ') else fail
    appendHex8(line, data[3]) else fail
    appendByte(line, ' ') else fail
    appendHex8(line, data[4]) else fail
    writeLine(console, line) else fail
end
