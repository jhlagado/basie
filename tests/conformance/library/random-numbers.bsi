// RANDOM.BSI: the xorshift sequence from the default seed and a chosen one,
// and randomBelow; the values were computed on the host.
// spec: 16.4; standard library 6
// expect output: 54031 61861 5940 | 33153 24609 59801 | 3104451345 0\r\n

include "FORMAT.BSI"
include "RANDOM.BSI"

sub main() fails
    var line: string[60]
    var i: u8 = 0
    for i = 1 to 3
        try appendU16(var line, random())
        try appendByte(var line, ' ')
    end
    try append(var line, "|")
    seedRandom(1)
    for i = 1 to 3
        try appendByte(var line, ' ')
        try appendU16(var line, random())
    end
    try append(var line, " | ")
    seedRandom(42)
    for i = 1 to 10
        try appendU16(var line, randomBelow(6))
    end
    try appendByte(var line, ' ')
    try appendU16(var line, randomBelow(0))
    try append(var line, "\r\n")
    try writeText(console, line)
end
