// A u16 stored through a var parameter into a field beyond its fourth byte
// lands whole: the field's offset is added without losing the value.
// spec: 13.4
// expect output: B\r\n

record Triple
    a: u16
    b: u16
    c: u16
end

var t: Triple

sub set(var p: Triple)
    p.c = 66
end

sub main() fails
    set(t)
    try writeOutputByte(u8(t.c))
    try writeOutputByte(13)
    try writeOutputByte(10)
end
