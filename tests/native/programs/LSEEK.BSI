// Binary files with 32-bit positions (67b): position, size and seek take
// and return u32 values; each is checked, and the narrowing at the end
// traps only when every one is right.
var buf: u8[200]
var check: u32
var out: u8

sub main() fails
    var i: u16
    for i = 0 until 200
        buf[i] = u8(i mod 256)
    end
    var f = openWrite("DATA.BIN", binaryMode) else fail
    writeBlock(f, buf, 200) else fail
    var at = position(f) else fail
    check = at - 200
    close(f) else fail
    var g = openUpdate("DATA.BIN") else fail
    var length = size(g) else fail
    check = check + length - 256
    seek(g, 7) else fail
    var b = readByte(g) else fail
    check = check + u32(b) - 7
    seek(g, at - 150) else fail
    var n = readBlock(g, buf, 150) else fail
    check = check + u32(buf[0]) - 50 + u32(n) - 150
    at = position(g) else fail
    check = check + at - 200
    close(g) else fail
    out = u8(256 - check)
end
