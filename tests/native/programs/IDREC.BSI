// id() of a record: a var record parameter lent a whole node, a lease,
// and a record outside any pool.
forward pool nodes

record Node
    value: u8
    next: nodes?
end

pool nodes: Node[4]

var keep: id nodes?
var loose: Node

sub mark(var n: Node)
    keep = id(n)
end

sub show() fails
    select keep
    case some(k)
        writeByte(console, k.value) else fail
    case none
        writeByte(console, '-') else fail
    end
end

sub main() fails
    var h = new nodes('A', none)
    mark(h)
    show() else fail
    var list: nodes? = new nodes('B', none)
    select list
    case some(k)
        keep = id(k)
    case none
    end
    show() else fail
    mark(loose)
    show() else fail
    writeText(console, "\r\n") else fail
end
